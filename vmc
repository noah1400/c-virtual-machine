#!/bin/sh
# Compiles Ore programs with vmc.bin, the Ore compiler written in Ore, and takes the options of vmc0.
# vmc.bin runs on the VM and writes the program as assembly, which vmasm then assembles unless -S is given.
here=$(dirname "$0")
library=$here/ore/lib
source= output= stop= next= base=0 strip=

# vmc.bin checks the arguments; this only finds out what to assemble
for arg; do
    case $next in
        o) output=$arg; next=; continue ;;
        L) library=$arg; next=; continue ;;
        b) base=$arg; next=; continue ;;
        I) next=; continue ;;
    esac
    case $arg in
        -h | -S) stop=1 ;;
        -g0) strip=-S ;;
        -o | -L | -I | -b) next=${arg#-} ;;
        -*) break ;;
        ?????*.asm) ;;
        *) [ -n "$source" ] && break; source=$arg ;;
    esac
done

"$here/vm" -m 262144 -S 8192 "$here/vmc.bin" "$@" || exit
[ -z "$stop" ] || exit 0
if [ -z "$output" ]; then
    case ${source##*/} in
        *.*) output=${source%.*}.bin ;;
        *) output=$source.bin ;;
    esac
fi
if ! "$here/vmasm" -I "$library" -I . "$output.asm" -o "$output" -b "$base" $strip; then
    echo "vmc: error: vmasm could not assemble $output.asm" >&2
    exit 1
fi
rm -f "$output.asm"
