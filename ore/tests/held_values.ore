// Values kept while others are computed, in loops where they get registers of their own: across calls and
// recursion, two deep, for operations that need their operands in order, and for stores to computed places
struct Pair {
    a: int;
    b: i16;
}

fn f(k: int) int {
    return k * 3 - 7;
}

fn pair(k: int) Pair {
    return Pair { a: k * 10, b: (0 - k) as i16 };
}

// Keeps values across calls of itself
fn weave(x: []int, depth: int) int {
    if (depth == 0) {
        return 1;
    }
    var total = 0;
    for (var k = 0; k < x.len; k += 1) {
        total += x[k] * weave(x[:depth - 1], depth - 1) - f(x[k]) * f(k);
    }
    return total;
}

fn main() {
    var x = [6]int { 7, -3, 12, 5, -9, 2 };
    var y = [6]int { 3, 5, -4, 2, 6, 1 };
    var small = [6]i8 { -5, 7, -128, 127, 0, -1 };
    var fx = [6]f32 { 1.5, -2.25, 3.0, 0.5, -7.75, 10.0 };
    var fy = [6]f32 { 0.5, 4.0, -1.5, 2.0, 0.25, -3.0 };
    var out: [6]int;
    var bytes: [6]u8;
    var pairs: [6]Pair;
    var parts: [6][]int;
    var mixed = 0;
    var ordered = 0;
    var fsum: f32 = 0;
    for (var i = 0; i < 6; i += 1) {
        mixed += x[i] * y[i] + x[5 - i] * y[5 - i];
        mixed += (x[i] - y[i]) * 3 + x[i] / y[i] + x[i] % y[i] + (x[i] << (y[i] & 3)) + f(x[i]) * f(y[i]);
        mixed += small[i] * small[5 - i] + (small[i] - small[5 - i]);
        if (x[i] < y[i]) {
            ordered += 1;
        }
        if (x[i] * 2 == y[i] + f(i)) {
            ordered += 10;
        }
        if ((x[i] & y[i]) == 0) {
            ordered += 100;
        }
        if (fx[i] < fy[i]) {
            ordered += 1000;
        }
        fsum += (fx[i] - fy[i]) * (fx[i] / fy[i]);
        out[i] = x[i] * y[i] + f(i);
        out[5 - i] += x[i] - y[i] * f(i);
        bytes[i] = (x[i] + y[i] + 200) as u8;
        pairs[i] = pair(x[i] + y[i]);
        parts[i] = x[i % 3 + 1:];
    }
    print(mixed, " ", ordered, " ", fsum, "\n");
    for (var i = 0; i < 6; i += 1) {
        print(out[i], " ", bytes[i], " ", pairs[i].a, " ", pairs[i].b, " ", parts[i].len, " ", parts[i][0], "\n");
    }
    print(weave(x[:], 3), "\n");
}
