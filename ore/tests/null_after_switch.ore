// A pointer that one case of a switch changes has to be checked again after the switch
// expect-exit: 1
struct Node {
    value: int;
    next: *Node;
}

fn pick(a: *Node, b: *Node, which: int) int {
    var p = a;
    var total = p.value;
    switch (which) {
        case 1 {
            p = b;
        }
        case 2 {
            total += 1;
        }
    }
    return total + p.value;
}

fn main() {
    var a = new(Node);
    a.value = 1;
    print(pick(a, a, 1), " ", pick(a, null, 2), "\n");
    print(pick(a, null, 1), "\n");
}
