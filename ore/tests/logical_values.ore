// && and || as values, over every combination of operands: bools in registers, in memory and in fields,
// comparisons and calls, which run left to right and only as far as they decide
struct Flags {
    on: bool;
}

fn t(name: []u8, value: bool) bool {
    print(name);
    return value;
}

fn bit(v: bool) int {
    if (v) {
        return 1;
    }
    return 0;
}

fn run(a: bool, b: bool, c: bool, n: int) {
    var m = b;
    var pm = &m;
    var f = Flags { on: c };
    var values = [16]bool {
        a && b, a || b, a && b && c, a || b || c, a && b || c, a || b && c, (a || b) && (b || c),
        !(a && b) || c, a && !b, m && a, m || f.on, f.on && m && a, n > 2 && a, n < 2 || b && n != 1,
        !(n == 1 || a) && *pm, (a && n >= 1) || (!c && n <= 2),
    };
    for (var i = 0; i < values.len; i += 1) {
        print(bit(values[i]));
    }
    var traced = t("a", a) && t("b", b) || t("c", c);
    print(" ", bit(traced), " ");
    traced = t("a", a) || t("m", m) && t("f", f.on);
    print(" ", bit(traced), "\n");
}

fn main() {
    for (var k = 0; k < 16; k += 1) {
        run(k & 1 != 0, k & 2 != 0, k & 4 != 0, k / 8 + 1);
    }
}
