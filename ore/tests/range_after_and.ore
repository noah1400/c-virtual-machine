// An index checked on the right of && has to be checked again after it
// expect-exit: 1
fn get(a: []int, i: int, look: bool) int {
    var positive = look && a[i] > 0;
    if (look && a[i] > 1) {
        positive = true;
    }
    if (positive) {
        return 1;
    }
    return a[i];
}

fn main() {
    var values = [4]int { 0, 2, 3, 4 };
    print(get(values[:], 0, true), " ", get(values[:], 1, true), "\n");
    print(get(values[:], 4, false), "\n");
}
