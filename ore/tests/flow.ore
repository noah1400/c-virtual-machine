// if, while, for, switch, break and continue
fn classify(n: int) []u8 {
    if (n < 0) {
        return "negative";
    } else if (n == 0) {
        return "zero";
    } else if (n < 10) {
        return "small";
    }
    return "large";
}

fn day(n: int) []u8 {
    switch (n) {
        case 0, 6 {
            return "weekend";
        }
        case 3 {
            return "midweek";
        }
        default {
            return "weekday";
        }
    }
}

fn collatz(n: int) int {
    var steps = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n /= 2;
        } else {
            n = 3 * n + 1;
        }
        steps += 1;
    }
    return steps;
}

fn main() {
    print(classify(-3), " ", classify(0), " ", classify(7), " ", classify(42), "\n");
    for (var d = 0; d < 7; d += 1) {
        print(day(d), " ");
    }
    print("\n");
    print("collatz 27: ", collatz(27), " steps\n");

    // Primes below 50, skipping even numbers with continue and leaving the inner loop with break
    var count = 0;
    for (var n = 2; n < 50; n += 1) {
        if (n > 2 && n % 2 == 0) {
            continue;
        }
        var prime = true;
        for (var k = 3; k * k <= n; k += 2) {
            if (n % k == 0) {
                prime = false;
                break;
            }
        }
        if (prime) {
            print(n, " ");
            count += 1;
        }
    }
    print("\n", count, " primes\n");

    var i = 0;
    for (;;) {
        i += 1;
        if (i == 5) {
            break;
        }
    }
    var total = 0;
    while (true) {
        total += i;
        i -= 1;
        if (i == 0) {
            break;
        }
    }
    print("total ", total, "\n");

    // A switch without a matching case and without default does nothing
    switch (i + 100) {
        case 1 {
            print("never\n");
        }
    }
    var flags: u8 = 0b1010;
    if (flags & 0b10 != 0 && !(flags & 1 != 0) || false) {
        print("flag 2 set, flag 1 clear\n");
    }
}
