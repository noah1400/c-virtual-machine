// A pointer that only the else branch changes has to be checked again after the if
// expect-exit: 1
struct Node {
    value: int;
    next: *Node;
}

fn pick(a: *Node, b: *Node, first: bool) int {
    var p = a;
    var total = p.value;
    if (first) {
        total += 1;
    } else {
        p = b;
    }
    return total + p.value;
}

fn main() {
    var a = new(Node);
    a.value = 1;
    print(pick(a, null, true), " ", pick(a, a, false), "\n");
    print(pick(a, null, false), "\n");
}
