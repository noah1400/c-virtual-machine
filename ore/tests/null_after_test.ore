// Comparing a pointer with null tells the code after it which way it went, and no more
// expect-exit: 1
struct Node {
    value: int;
    next: *Node;
}

fn value(p: *Node) int {
    if (p == null) {
        return -1;
    }
    return p.value;
}

fn second(p: *Node, q: *Node) int {
    if (q != null) {
        return q.value;
    }
    return p.value + q.value;
}

fn main() {
    var a = new(Node);
    a.value = 3;
    print(value(a), " ", value(null), " ", second(a, a), "\n");
    print(second(a, null), "\n");
}
