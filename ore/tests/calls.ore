// Calls: recursion, function values, and structs, arrays and slices passed and returned by value
struct Pair {
    low: int;
    high: int;
}

fn fib(n: int) int {
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn apply(f: fn(int) int, value: int) int {
    return f(value);
}

fn double(x: int) int {
    return x * 2;
}

fn negate(x: int) int {
    return -x;
}

fn ordered(a: int, b: int) Pair {
    if (a > b) {
        return Pair { low: b, high: a };
    }
    return Pair { low: a, high: b };
}

// A struct parameter is a copy, so changing it leaves the caller's alone
fn widen(p: Pair, by: int) Pair {
    p.low -= by;
    p.high += by;
    return p;
}

fn sum(values: [4]int) int {
    var total = 0;
    for (var i = 0; i < values.len; i += 1) {
        total += values[i];
    }
    values[0] = 1000;
    return total;
}

fn tail(text: []u8, from: int) []u8 {
    return text[from:];
}

fn eight(a: int, b: u8, c: i16, d: bool, e: int, f: u32, g: i8, h: int) int {
    var extra = 0;
    if (d) {
        extra = 1;
    }
    return a + b + c + extra + e + (f as int) + g + h;
}

fn main() {
    print("fib(20) = ", fib(20), "\n");
    var ops = [2]fn(int) int { double, negate };
    print("apply: ", apply(double, 21), " ", apply(ops[1], 5), " ", ops[0](ops[1](3)), "\n");

    var p = ordered(9, 4);
    var q = widen(p, 10);
    print("pair: ", p.low, " ", p.high, " widened: ", q.low, " ", q.high, "\n");
    print("direct field of a result: ", ordered(3, 1).high, "\n");

    var numbers = [4]int { 1, 2, 3, 4 };
    print("sum: ", sum(numbers), " first still ", numbers[0], "\n");
    print("tail: ", tail("hello, world", 7), "\n");
    print("eight: ", eight(1, 250, -3, true, 5, 7, -8, 100), "\n");

    var f: fn(int) int = null;
    if (f == null) {
        f = negate;
    }
    print("f(8) = ", f(8), "\n");
}
