// An index checked once has to be checked again after it changes
// expect-exit: 1
fn get(a: []int, i: int) int {
    var total = a[i];
    i += 3;
    return total + a[i];
}

fn main() {
    var values = [4]int { 1, 2, 3, 4 };
    print(get(values[:], 0), "\n");
    print(get(values[:], 1), "\n");
}
