// A for loop that counts an index up to the length of what it indexes needs no bounds checks in its body;
// loops that change the index or the slice in their body keep them and still work
fn sum(values: []int) int {
    var total = 0;
    for (var i = 0; i < values.len; i += 1) {
        total += values[i];
    }
    return total;
}

fn reverse(values: []int) {
    for (var i = 0; i < values.len / 2; i += 1) {
        var other = values.len - 1 - i;
        var kept = values[i];
        values[i] = values[other];
        values[other] = kept;
    }
}

fn main() {
    var numbers = [6]int { 3, 1, 4, 1, 5, 9 };
    var all: []int = numbers;
    print(sum(all), " ", sum(all[2:5]), "\n");

    var table: [8]u8;
    for (var i = 0; i < 8; i += 1) {
        table[i] = (i * i) as u8;
    }
    for (var i = 2; i < table.len; i += 1) {
        print(table[i], " ");
    }
    print("\n");

    reverse(all);
    for (var i = 0; i < all.len; i += 1) {
        print(all[i], " ");
    }
    print("\n");

    // The body shortens the slice, so the index is checked against the new length
    var shrinking = all;
    var seen = 0;
    for (var i = 0; i < shrinking.len; i += 1) {
        seen += shrinking[i];
        shrinking = shrinking[:shrinking.len - 1];
    }
    print(seen, "\n");

    // The body moves the index, which stays checked
    var skipped = 0;
    for (var i = 0; i < all.len; i += 1) {
        skipped += all[i];
        i += 1;
    }
    print(skipped, "\n");
}
