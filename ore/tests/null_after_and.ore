// A pointer checked only on the right of && or || has to be checked again after them
// expect-exit: 1
struct Node {
    value: int;
    next: *Node;
}

fn get(n: *Node, m: *Node, look: bool) int {
    var positive = m.value > 0 && look && n.value > 0;
    var either = !look && m.value > 9 || look && n.next == null;
    print(positive, " ", either, " ");
    return n.value;
}

fn main() {
    var a = new(Node);
    a.value = 5;
    print(get(a, a, true), "\n");
    print(get(a, a, false), "\n");
    print(get(null, a, false), "\n");
}
