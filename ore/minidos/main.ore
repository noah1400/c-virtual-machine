// MiniDos: a small DOS for the VM, written in Ore. It keeps its files on the VM's disk and runs programs
// from there below itself, in user mode. -e shows each command after the prompt, for sessions that come
// from a file.
import "std/str";
import "console";
import "fs";
import "program";
import "shell";

fn main(args: [][]u8) int {
    for (var i = 1; i < args.len; i += 1) {
        if (str.equal(args[i], "-e")) {
            shell.echo_input = true;
        }
    }
    if ((main as u32) < program.LIMIT as u32) {
        console.screen("MiniDos has to be built above the programs, with vmc -b 0x100000\n");
        return 1;
    }
    program.install();
    console.write("\nStarting MiniDos...\n\n");
    for (var d = 1; d < fs.DRIVES; d += 1) {
        fs.mount(d);
    }
    var e = fs.mount(0);
    if (e == fs.Error.NO_DISK) {
        console.line("There is no disk; start vm with -b and a disk image.");
    } else if (e == fs.Error.NOT_FORMATTED) {
        console.line("The disk is not formatted; FORMAT prepares it.");
    } else if (e != fs.Error.NONE) {
        console.line(fs.message(e));
    } else {
        var place = fs.Place {};
        if (fs.find("\\AUTOEXEC.BAT", &place) == fs.Error.NONE) {
            shell.run_batch("\\AUTOEXEC.BAT", "");
        }
    }
    shell.interact();
    return 0;
}
