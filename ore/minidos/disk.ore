// The VM's disk drives: whole sectors between a drive's image and memory. A drive without an image can keep
// its sectors in memory instead, until MiniDos stops.
import "std/cpu";
import "std/mem";
import "std/sys";

pub const SECTOR = 512;
pub const DRIVES = 4;

const SECTOR_PORT = 0x70;
const BUFFER_PORT = 0x71;
const COUNT_PORT = 0x72;
const COMMAND_PORT = 0x73;
const SIZE_PORT = 0x74;
const DRIVE_PORT = 0x75;

const READ: u32 = 1;
const WRITE: u32 = 2;
const RESIZE: u32 = 3;
const NO_DISK: u32 = 1;

const KEPT_FREE = 0x80000;      // heap that a disk in memory leaves for MiniDos and its programs

var memory: [DRIVES][]u8;

fn command(drive: int, what: u32) u32 {
    cpu.write_port(DRIVE_PORT, drive as u32);
    cpu.write_port(COMMAND_PORT, what);
    return cpu.read_port(COMMAND_PORT);
}

pub fn in_memory(drive: int) bool {
    return memory[drive].len > 0;
}

// Whether the drive has a disk in memory or an image, even one without sectors, which a transfer of none tells
pub fn present(drive: int) bool {
    if (in_memory(drive)) {
        return true;
    }
    cpu.write_port(COUNT_PORT, 0);
    return command(drive, READ) != NO_DISK;
}

// The number of sectors, 0 without a disk
pub fn sectors(drive: int) int {
    if (in_memory(drive)) {
        return memory[drive].len / SECTOR;
    }
    cpu.write_port(DRIVE_PORT, drive as u32);
    return cpu.read_port(SIZE_PORT) as int;
}

// Gives a drive a disk of count sectors in memory, or makes the one it has that long, keeping what fits; false
// when the heap has no room for it
pub fn use_memory(drive: int, count: int) bool {
    var bytes = count * SECTOR;
    if (bytes + KEPT_FREE > sys.largest_free()) {
        return false;
    }
    var space = new(u8, bytes);
    mem.fill(space, 0);
    if (in_memory(drive)) {
        mem.copy(space, memory[drive]);
        free(memory[drive]);
    }
    memory[drive] = space;
    return true;
}

// Moves as many whole sectors as fit in buffer, from sector on, and tells whether that worked
fn transfer(drive: int, what: u32, sector: int, buffer: []u8) bool {
    if (in_memory(drive)) {
        var start = sector * SECTOR;
        var end = start + buffer.len / SECTOR * SECTOR;
        if (sector < 0 || end > memory[drive].len) {
            return false;
        }
        if (what == READ) {
            mem.copy(buffer, memory[drive][start:end]);
        } else {
            mem.copy(memory[drive][start:end], buffer);
        }
        return true;
    }
    cpu.write_port(SECTOR_PORT, sector as u32);
    cpu.write_port(BUFFER_PORT, buffer.ptr as u32);
    cpu.write_port(COUNT_PORT, (buffer.len / SECTOR) as u32);
    return command(drive, what) == 0;
}

pub fn read(drive: int, sector: int, buffer: []u8) bool {
    return transfer(drive, READ, sector, buffer);
}

pub fn write(drive: int, sector: int, buffer: []u8) bool {
    return transfer(drive, WRITE, sector, buffer);
}

// Makes the disk as many sectors long, adding zeros or cutting off its end
pub fn resize(drive: int, count: int) bool {
    if (in_memory(drive)) {
        return use_memory(drive, count);
    }
    cpu.write_port(COUNT_PORT, count as u32);
    return command(drive, RESIZE) == 0;
}
