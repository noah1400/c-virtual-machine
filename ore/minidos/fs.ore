// The MiniDos file system. Sector 0 describes the disk, the allocation table follows it, and then come
// the clusters, one sector each. The table holds an int for every cluster: the next cluster of the same
// file, END for its last one, or 0 for a free one. Directories are files of 32-byte entries, the root
// directory included, and every other directory starts with the entries . and .. for itself and its
// parent.
import "std/mem";
import "std/str";
import "disk";

pub const DIRECTORY: u8 = 0x10;

const SECTOR = disk.SECTOR;
const MAGIC = "MDOS";
const VERSION = 1;
const END = -1;
const PER_CLUSTER = 16;
const TABLE_PER_SECTOR = 128;

pub enum Error {
    NONE,
    NOT_FOUND,
    PATH_NOT_FOUND,
    BAD_NAME,
    EXISTS,
    DISK_FULL,
    NOT_EMPTY,
    ACCESS_DENIED,
    NOT_DIRECTORY,
    CURRENT_DIRECTORY,
    DISK_ERROR,
    NO_DISK,
    NOT_FORMATTED,
    TOO_SMALL,
}

pub fn message(e: Error) []u8 {
    switch (e) {
        case Error.NOT_FOUND {
            return "File not found";
        }
        case Error.PATH_NOT_FOUND {
            return "Path not found";
        }
        case Error.BAD_NAME {
            return "Invalid file name";
        }
        case Error.EXISTS {
            return "File exists";
        }
        case Error.DISK_FULL {
            return "Insufficient disk space";
        }
        case Error.NOT_EMPTY {
            return "Directory not empty";
        }
        case Error.ACCESS_DENIED {
            return "Access denied";
        }
        case Error.NOT_DIRECTORY {
            return "Invalid directory";
        }
        case Error.CURRENT_DIRECTORY {
            return "Attempt to remove current directory";
        }
        case Error.DISK_ERROR {
            return "Disk error";
        }
        case Error.NO_DISK {
            return "No disk";
        }
        case Error.NOT_FORMATTED {
            return "Disk not formatted";
        }
        case Error.TOO_SMALL {
            return "Disk too small";
        }
    }
    return "No error";
}

// A directory entry as it is on the disk
pub struct Entry {
    name: [11]u8;           // 8 characters of name and 3 of extension, filled up with spaces; 0 first when free
    attributes: u8;
    cluster: int;           // the first cluster, 0 for an empty file
    size: int;
    reserved: [12]u8;
}

struct Boot {
    magic: [4]u8;
    version: int;
    sectors: int;
    table: int;             // the first sector of the allocation table
    table_sectors: int;
    data: int;              // the sector of cluster 1
    clusters: int;
    root: int;              // the first cluster of the root directory
    label: [11]u8;
}

var boot: Boot;
var table: []int;
var changed: []bool;        // sectors of the table that differ from the disk
var hint = 1;               // where the search for a free cluster starts
var ready = false;
var current = 0;            // the first cluster of the current directory
var current_path: []u8;

pub fn mounted() bool {
    return ready;
}

// The current directory as \NAME\NAME
pub fn current_directory() []u8 {
    if (current_path.len == 0) {
        return "\\";
    }
    return current_path;
}

pub fn label() []u8 {
    var end = boot.label.len;
    while (end > 0 && boot.label[end - 1] == ' ') {
        end -= 1;
    }
    return boot.label[:end];
}

fn table_bytes() []u8 {
    return mem.bytes(table.ptr as *u8, table.len * 4);
}

// Reads the description and the allocation table of the disk and starts in its root directory
pub fn mount() Error {
    ready = false;
    var sectors = disk.sectors();
    if (sectors == 0) {
        return Error.NO_DISK;
    }
    var sector: [SECTOR]u8;
    if (!disk.read(0, sector)) {
        return Error.DISK_ERROR;
    }
    var b = *(&sector[0] as *Boot);
    if (!mem.equal(b.magic[:], MAGIC) || b.version != VERSION || b.clusters < 1 ||
        b.table_sectors * TABLE_PER_SECTOR <= b.clusters || b.data + b.clusters > sectors || b.root < 1 ||
        b.root > b.clusters) {
        return Error.NOT_FORMATTED;
    }
    boot = b;
    free(table);
    free(changed);
    table = new(int, boot.table_sectors * TABLE_PER_SECTOR);
    changed = new(bool, boot.table_sectors);
    if (!disk.read(boot.table, table_bytes())) {
        return Error.DISK_ERROR;
    }
    hint = 1;
    current = boot.root;
    free(current_path);
    current_path = str.clone("\\");
    ready = true;
    return Error.NONE;
}

// Makes an empty file system of the whole disk, with a label of up to 11 characters
pub fn format(name: []u8) Error {
    ready = false;
    var sectors = disk.sectors();
    if (sectors == 0) {
        return Error.NO_DISK;
    }
    var table_sectors = (sectors + TABLE_PER_SECTOR - 1) / TABLE_PER_SECTOR;
    var b = Boot {
        version: VERSION, sectors: sectors, table: 1, table_sectors: table_sectors, data: 1 + table_sectors,
        clusters: sectors - 1 - table_sectors, root: 1,
    };
    if (b.clusters < 8) {
        return Error.TOO_SMALL;
    }
    mem.copy(b.magic[:], MAGIC);
    mem.fill(b.label[:], ' ');
    for (var i = 0; i < name.len && i < b.label.len; i += 1) {
        b.label[i] = upper(name[i]);
    }

    var sector: [SECTOR]u8;
    *(&sector[0] as *Boot) = b;
    var empty = new(int, table_sectors * TABLE_PER_SECTOR);
    empty[b.root] = END;
    var ok = disk.write(0, sector) && disk.write(b.table, mem.bytes(empty.ptr as *u8, empty.len * 4));
    free(empty);
    mem.fill(sector[:], 0);
    if (!ok || !disk.write(b.data + b.root - 1, sector)) {
        return Error.DISK_ERROR;
    }
    return mount();
}

fn upper(c: u8) u8 {
    if (c >= 'a' && c <= 'z') {
        return c - 'a' + 'A';
    }
    return c;
}

fn sector_of(cluster: int) int {
    return boot.data + cluster - 1;
}

fn valid(cluster: int) bool {
    return cluster >= 1 && cluster <= boot.clusters;
}

fn set(cluster: int, value: int) {
    table[cluster] = value;
    changed[cluster / TABLE_PER_SECTOR] = true;
}

// Writes the changed sectors of the allocation table
fn flush() bool {
    var bytes = table_bytes();
    var ok = true;
    for (var i = 0; i < changed.len; i += 1) {
        if (changed[i]) {
            ok = disk.write(boot.table + i, bytes[i * SECTOR:(i + 1) * SECTOR]) && ok;
            changed[i] = false;
        }
    }
    return ok;
}

// A free cluster, made the last of a chain, or 0 when the disk is full
fn allocate() int {
    for (var n = 0; n < boot.clusters; n += 1) {
        var c = hint;
        hint = hint % boot.clusters + 1;
        if (table[c] == 0) {
            set(c, END);
            return c;
        }
    }
    return 0;
}

// The clusters of the chain from first on, which free gives back. A damaged table cannot make it loop.
fn chain(first: int) []int {
    var count = 0;
    var c = first;
    while (valid(c) && count < boot.clusters) {
        count += 1;
        c = table[c];
    }
    var clusters = new(int, count);
    c = first;
    for (var i = 0; i < count; i += 1) {
        clusters[i] = c;
        c = table[c];
    }
    return clusters;
}

// Frees the chain from first on
fn release(first: int) {
    var c = first;
    for (var n = 0; valid(c) && n < boot.clusters; n += 1) {
        var next = table[c];
        set(c, 0);
        c = next;
    }
}

pub fn free_bytes() int {
    var count = 0;
    for (var c = 1; c <= boot.clusters; c += 1) {
        if (table[c] == 0) {
            count += 1;
        }
    }
    return count * SECTOR;
}

pub fn total_bytes() int {
    return boot.clusters * SECTOR;
}

// A whole directory in memory
struct Directory {
    first: int;
    clusters: []int;
    entries: []Entry;
}

fn cluster_bytes(d: *Directory, i: int) []u8 {
    return mem.bytes(&d.entries[i * PER_CLUSTER] as *u8, SECTOR);
}

fn load(first: int, d: *Directory) Error {
    d.first = first;
    d.clusters = chain(first);
    d.entries = new(Entry, d.clusters.len * PER_CLUSTER);
    for (var i = 0; i < d.clusters.len; i += 1) {
        if (!disk.read(sector_of(d.clusters[i]), cluster_bytes(d, i))) {
            unload(d);
            return Error.DISK_ERROR;
        }
    }
    return Error.NONE;
}

fn unload(d: *Directory) {
    free(d.clusters);
    free(d.entries);
}

// Writes the cluster that holds entry index back to the disk
fn store(d: *Directory, index: int) Error {
    var i = index / PER_CLUSTER;
    if (!disk.write(sector_of(d.clusters[i]), cluster_bytes(d, i))) {
        return Error.DISK_ERROR;
    }
    return Error.NONE;
}

// Puts an entry into a free place of a directory, which grows by a cluster when it has none, and
// stores it. *index receives its place.
fn add(d: *Directory, entry: Entry, index: *int) Error {
    var free_index = -1;
    for (var i = 0; i < d.entries.len && free_index < 0; i += 1) {
        if (d.entries[i].name[0] == 0) {
            free_index = i;
        }
    }
    if (free_index < 0) {
        var c = allocate();
        if (c == 0) {
            return Error.DISK_FULL;
        }
        set(d.clusters[d.clusters.len - 1], c);
        var clusters = new(int, d.clusters.len + 1);
        var entries = new(Entry, clusters.len * PER_CLUSTER);
        for (var i = 0; i < d.clusters.len; i += 1) {
            clusters[i] = d.clusters[i];
        }
        clusters[d.clusters.len] = c;
        for (var i = 0; i < d.entries.len; i += 1) {
            entries[i] = d.entries[i];
        }
        free_index = d.entries.len;
        unload(d);
        d.clusters = clusters;
        d.entries = entries;
    }
    d.entries[free_index] = entry;
    *index = free_index;
    var e = store(d, free_index);
    if (e == Error.NONE && !flush()) {
        e = Error.DISK_ERROR;
    }
    return e;
}

fn find_in(d: *Directory, name: [11]u8) int {
    for (var i = 0; i < d.entries.len; i += 1) {
        if (mem.equal(d.entries[i].name[:], name[:])) {
            return i;
        }
    }
    return -1;
}

// The 11 characters of an entry for a name like README.TXT, in capitals
pub struct Name {
    chars: [11]u8;
    ok: bool;
}

fn is_name_char(c: u8) bool {
    return str.is_letter(c) || str.is_digit(c) || str.find_byte("!#$%&'()-@^_`{}~", c) >= 0;
}

// Fills part with text, where wildcards let * fill the rest with ? and ? stand for any character
fn fill_part(part: []u8, text: []u8, wildcards: bool) bool {
    if (text.len > part.len && !(wildcards && str.find_byte(text, '*') >= 0 && str.find_byte(text, '*') < part.len)) {
        return false;
    }
    for (var i = 0; i < text.len; i += 1) {
        var c = text[i];
        if (wildcards && c == '*') {
            for (var k = i; k < part.len; k += 1) {
                part[k] = '?';
            }
            return i == text.len - 1;
        }
        if (!(wildcards && c == '?') && !is_name_char(c)) {
            return false;
        }
        part[i] = upper(c);
    }
    return true;
}

// Turns a name into the characters of an entry. Wildcards allow * and ?, and a pattern without a dot
// matches any extension when all is set.
pub fn short_name(text: []u8, wildcards: bool, all: bool) Name {
    var result = Name {};
    mem.fill(result.chars[:], ' ');
    if (str.equal(text, ".") || str.equal(text, "..")) {
        mem.copy(result.chars[:], text);
        result.ok = true;
        return result;
    }
    var dot = str.find_byte(text, '.');
    var base = text;
    var extension = text[:0];
    if (dot >= 0) {
        base = text[:dot];
        extension = text[dot + 1:];
    } else if (wildcards && all) {
        extension = "*";
    }
    result.ok = base.len > 0 && str.find_byte(extension, '.') < 0 && fill_part(result.chars[0:8], base, wildcards) &&
        fill_part(result.chars[8:11], extension, wildcards);
    return result;
}

pub fn has_wildcards(text: []u8) bool {
    return str.find_byte(text, '*') >= 0 || str.find_byte(text, '?') >= 0;
}

pub fn matches(pattern: [11]u8, name: [11]u8) bool {
    for (var i = 0; i < name.len; i += 1) {
        if (pattern[i] != '?' && pattern[i] != name[i]) {
            return false;
        }
    }
    return true;
}

// Writes the name of an entry like README.TXT into buffer, which takes 12 bytes, and returns that part
pub fn name_text(name: [11]u8, buffer: []u8) []u8 {
    var length = 0;
    for (var i = 0; i < 8 && name[i] != ' '; i += 1) {
        buffer[length] = name[i];
        length += 1;
    }
    if (name[8] != ' ') {
        buffer[length] = '.';
        length += 1;
        for (var i = 8; i < 11 && name[i] != ' '; i += 1) {
            buffer[length] = name[i];
            length += 1;
        }
    }
    return buffer[:length];
}

fn is_separator(c: u8) bool {
    return c == '\\' || c == '/';
}

// The directory that holds entries of the given name, or 0: the directory itself for ., its parent for ..
fn enter(dir: int, name: []u8, e: *Error) int {
    var n = short_name(name, false, false);
    if (!n.ok) {
        *e = Error.PATH_NOT_FOUND;
        return 0;
    }
    if (str.equal(name, ".") || str.equal(name, "..") && dir == boot.root) {
        return dir;
    }
    var d = Directory {};
    *e = load(dir, &d);
    if (*e != Error.NONE) {
        return 0;
    }
    var i = find_in(&d, n.chars);
    var next = 0;
    if (i < 0 || (d.entries[i].attributes & DIRECTORY) == 0) {
        *e = Error.PATH_NOT_FOUND;
    } else {
        next = d.entries[i].cluster;
        if (next == 0) {
            next = boot.root;
        }
    }
    unload(&d);
    return next;
}

// Follows path to the directory that holds its last part, and leaves that part in *last
fn walk(path: []u8, last: *[]u8, dir: *int) Error {
    var p = path;
    if (p.len >= 2 && p[1] == ':') {
        if (upper(p[0]) != 'A') {
            return Error.PATH_NOT_FOUND;
        }
        p = p[2:];
    }
    var at = current;
    if (p.len > 0 && is_separator(p[0])) {
        at = boot.root;
        p = p[1:];
    }
    for (;;) {
        var end = 0;
        while (end < p.len && !is_separator(p[end])) {
            end += 1;
        }
        if (end == p.len) {
            *last = p;
            *dir = at;
            return Error.NONE;
        }
        if (end > 0) {
            var e = Error.NONE;
            at = enter(at, p[:end], &e);
            if (e != Error.NONE) {
                return e;
            }
        }
        p = p[end + 1:];
    }
    return Error.NONE;
}

// Where a path leads: the directory that holds its entry, the entry's index there and the entry itself.
// A directory named by ., .., a trailing \ or as the root has no index, only its cluster in the entry.
pub struct Place {
    dir: int;
    index: int;
    entry: Entry;
}

pub fn find(path: []u8, place: *Place) Error {
    if (!ready) {
        return Error.NOT_FORMATTED;
    }
    var last: []u8;
    var dir = 0;
    var e = walk(path, &last, &dir);
    if (e != Error.NONE) {
        return e;
    }
    if (last.len == 0 || str.equal(last, ".") || str.equal(last, "..")) {
        if (last.len > 0) {
            dir = enter(dir, last, &e);
            if (e != Error.NONE) {
                return e;
            }
        }
        *place = Place { dir: dir, index: -1 };
        mem.fill(place.entry.name[:], ' ');
        place.entry.attributes = DIRECTORY;
        place.entry.cluster = dir;
        return Error.NONE;
    }
    var n = short_name(last, false, false);
    if (!n.ok) {
        return Error.BAD_NAME;
    }
    var d = Directory {};
    e = load(dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    var i = find_in(&d, n.chars);
    if (i < 0) {
        e = Error.NOT_FOUND;
    } else {
        *place = Place { dir: dir, index: i, entry: d.entries[i] };
    }
    unload(&d);
    return e;
}

pub fn is_directory(place: *Place) bool {
    return (place.entry.attributes & DIRECTORY) != 0;
}

// The entries of the directory at dir that match pattern, apart from free ones; free gives them back
pub fn list(dir: int, pattern: [11]u8, entries: *[]Entry) Error {
    var d = Directory {};
    var e = load(dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    var count = 0;
    for (var i = 0; i < d.entries.len; i += 1) {
        if (d.entries[i].name[0] != 0 && matches(pattern, d.entries[i].name)) {
            count += 1;
        }
    }
    *entries = new(Entry, count);
    count = 0;
    for (var i = 0; i < d.entries.len; i += 1) {
        if (d.entries[i].name[0] != 0 && matches(pattern, d.entries[i].name)) {
            (*entries)[count] = d.entries[i];
            count += 1;
        }
    }
    unload(&d);
    return Error.NONE;
}

// The directory a path names and the pattern of its last part, for listing and wildcard commands. A
// directory stands for all of its entries.
pub struct Selection {
    dir: int;
    pattern: [11]u8;
}

pub fn select(path: []u8, all: bool, selection: *Selection) Error {
    if (!ready) {
        return Error.NOT_FORMATTED;
    }
    var everything = short_name("*.*", true, false);
    if (!has_wildcards(path)) {
        var place = Place {};
        var e = find(path, &place);
        if (e == Error.NONE && is_directory(&place)) {
            *selection = Selection { dir: place.entry.cluster, pattern: everything.chars };
            if (place.entry.cluster == 0) {
                selection.dir = boot.root;
            }
            return Error.NONE;
        }
        if (e != Error.NONE && e != Error.NOT_FOUND) {
            return e;
        }
    }
    var last: []u8;
    var dir = 0;
    var e = walk(path, &last, &dir);
    if (e != Error.NONE) {
        return e;
    }
    var n = short_name(last, true, all);
    if (!n.ok) {
        return Error.BAD_NAME;
    }
    *selection = Selection { dir: dir, pattern: n.chars };
    return Error.NONE;
}

// Removes a file
pub fn delete(path: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    if (place.index < 0 || is_directory(&place)) {
        return Error.ACCESS_DENIED;
    }
    return remove_entry(&place);
}

fn remove_entry(place: *Place) Error {
    var d = Directory {};
    var e = load(place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    release(d.entries[place.index].cluster);
    d.entries[place.index].name[0] = 0;
    e = store(&d, place.index);
    unload(&d);
    if (e == Error.NONE && !flush()) {
        e = Error.DISK_ERROR;
    }
    return e;
}

// Gives the file or directory at path the name new_name, in the same directory
pub fn rename(path: []u8, new_name: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    var n = short_name(new_name, false, false);
    if (place.index < 0 || !n.ok || n.chars[0] == '.') {
        return Error.BAD_NAME;
    }
    var d = Directory {};
    e = load(place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    if (find_in(&d, n.chars) >= 0) {
        e = Error.EXISTS;
    } else {
        d.entries[place.index].name = n.chars;
        e = store(&d, place.index);
    }
    unload(&d);
    return e;
}

// Makes an entry for a new, empty file or directory at path
fn create(path: []u8, attributes: u8, place: *Place) Error {
    var last: []u8;
    var dir = 0;
    var e = walk(path, &last, &dir);
    if (e != Error.NONE) {
        return e;
    }
    var n = short_name(last, false, false);
    if (!n.ok || n.chars[0] == '.') {
        return Error.BAD_NAME;
    }
    var d = Directory {};
    e = load(dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    if (find_in(&d, n.chars) >= 0) {
        unload(&d);
        return Error.EXISTS;
    }
    var entry = Entry { name: n.chars, attributes: attributes };
    var index = 0;
    e = add(&d, entry, &index);
    unload(&d);
    *place = Place { dir: dir, index: index, entry: entry };
    return e;
}

pub fn make_directory(path: []u8) Error {
    if (!ready) {
        return Error.NOT_FORMATTED;
    }
    var place = Place {};
    if (find(path, &place) == Error.NONE) {
        return Error.EXISTS;
    }
    var c = allocate();
    if (c == 0) {
        return Error.DISK_FULL;
    }
    var e = create(path, DIRECTORY, &place);
    if (e != Error.NONE) {
        release(c);
        flush();
        return e;
    }
    var entries: [PER_CLUSTER]Entry;
    mem.fill(entries[0].name[:], ' ');
    entries[0].name[0] = '.';
    entries[0].attributes = DIRECTORY;
    entries[0].cluster = c;
    entries[1] = entries[0];
    entries[1].name[1] = '.';
    entries[1].cluster = place.dir;
    if (!disk.write(sector_of(c), mem.bytes(&entries[0] as *u8, SECTOR))) {
        return Error.DISK_ERROR;
    }
    return set_entry(&place, c, 0);
}

// Changes where the entry at place starts and how long it is
fn set_entry(place: *Place, cluster: int, length: int) Error {
    var d = Directory {};
    var e = load(place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    d.entries[place.index].cluster = cluster;
    d.entries[place.index].size = length;
    place.entry = d.entries[place.index];
    e = store(&d, place.index);
    unload(&d);
    if (e == Error.NONE && !flush()) {
        e = Error.DISK_ERROR;
    }
    return e;
}

// Removes an empty directory
pub fn remove_directory(path: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    if (!is_directory(&place)) {
        return Error.NOT_DIRECTORY;
    }
    if (place.index < 0 || place.entry.cluster == boot.root) {
        return Error.ACCESS_DENIED;
    }
    if (place.entry.cluster == current) {
        return Error.CURRENT_DIRECTORY;
    }
    var d = Directory {};
    e = load(place.entry.cluster, &d);
    if (e != Error.NONE) {
        return e;
    }
    for (var i = 0; i < d.entries.len; i += 1) {
        if (d.entries[i].name[0] != 0 && d.entries[i].name[0] != '.') {
            e = Error.NOT_EMPTY;
        }
    }
    unload(&d);
    if (e != Error.NONE) {
        return e;
    }
    return remove_entry(&place);
}

// Makes path the current directory
pub fn change_directory(path: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e == Error.NOT_FOUND || e == Error.BAD_NAME) {
        return Error.NOT_DIRECTORY;
    }
    if (e != Error.NONE) {
        return e;
    }
    if (!is_directory(&place)) {
        return Error.NOT_DIRECTORY;
    }
    var full = absolute(path);
    current = place.entry.cluster;
    free(current_path);
    current_path = full;
    return Error.NONE;
}

// The path from the root to what path names, in capitals and without . and .., which free gives back
pub fn absolute(path: []u8) []u8 {
    var p = path;
    if (p.len >= 2 && p[1] == ':') {
        p = p[2:];
    }
    var b = str.builder(64);
    if (p.len == 0 || !is_separator(p[0])) {
        str.append(&b, current_directory());
    }
    while (p.len > 0) {
        var end = 0;
        while (end < p.len && !is_separator(p[end])) {
            end += 1;
        }
        var part = p[:end];
        if (str.equal(part, "..")) {
            var text = str.text(&b);
            var slash = str.find_last_byte(text, '\\');
            if (slash >= 0) {
                b.len = slash;
            }
        } else if (part.len > 0 && !str.equal(part, ".")) {
            var n = short_name(part, false, false);
            var buffer: [12]u8;
            if (!str.ends_with(str.text(&b), "\\")) {
                str.append_byte(&b, '\\');
            }
            str.append(&b, name_text(n.chars, buffer));
        }
        if (end == p.len) {
            break;
        }
        p = p[end + 1:];
    }
    if (b.len == 0) {
        str.append_byte(&b, '\\');
    }
    var result = str.clone(str.text(&b));
    str.release(&b);
    return result;
}

// An open file. Writing through it can make it longer, and closing it records its size.
pub struct File {
    place: Place;
    clusters: []int;        // the file's chain, with room to grow
    count: int;             // how many of them it uses
    size: int;
    position: int;
    writable: bool;
    appending: bool;
    changed: bool;
}

// Modes of open, as the VM's syscalls number them
pub const READ = 0;
pub const WRITE = 1;        // creates the file, or empties it
pub const APPEND = 2;
pub const UPDATE = 3;       // reads and writes a file that exists
pub const REPLACE = 4;      // reads and writes a file it creates or empties

pub fn open(path: []u8, mode: int, e: *Error) *File {
    var place = Place {};
    *e = find(path, &place);
    if (*e == Error.NOT_FOUND && mode != READ && mode != UPDATE) {
        *e = create(path, 0, &place);
    }
    if (*e != Error.NONE) {
        return null;
    }
    if (place.index < 0 || is_directory(&place) || mode < READ || mode > REPLACE) {
        *e = Error.ACCESS_DENIED;
        return null;
    }
    if ((mode == WRITE || mode == REPLACE) && place.entry.cluster != 0) {
        release(place.entry.cluster);
        *e = set_entry(&place, 0, 0);
        if (*e != Error.NONE) {
            return null;
        }
    }
    var f = new(File);
    f.place = place;
    f.clusters = chain(place.entry.cluster);
    f.count = f.clusters.len;
    f.size = place.entry.size;
    f.writable = mode != READ;
    f.appending = mode == APPEND;
    if (f.appending) {
        f.position = f.size;
    }
    return f;
}

pub fn file_size(f: *File) int {
    return f.size;
}

// Reads up to buffer.len bytes from the current position and returns how many, 0 at the end, or -1
pub fn read(f: *File, buffer: []u8) int {
    var count = f.size - f.position;
    if (count > buffer.len) {
        count = buffer.len;
    }
    var sector: [SECTOR]u8;
    var done = 0;
    while (done < count) {
        var index = f.position / SECTOR;
        var offset = f.position % SECTOR;
        var part = SECTOR - offset;
        if (part > count - done) {
            part = count - done;
        }
        if (index >= f.count || !disk.read(sector_of(f.clusters[index]), sector)) {
            return -1;
        }
        mem.copy(buffer[done:done + part], sector[offset:offset + part]);
        done += part;
        f.position += part;
    }
    return done;
}

// Writes bytes at the current position, or at the end when appending, and returns how many or -1
pub fn write(f: *File, bytes: []u8) int {
    if (!f.writable) {
        return -1;
    }
    if (f.appending) {
        f.position = f.size;
    }
    var sector: [SECTOR]u8;
    var done = 0;
    while (done < bytes.len) {
        var index = f.position / SECTOR;
        var offset = f.position % SECTOR;
        var part = SECTOR - offset;
        if (part > bytes.len - done) {
            part = bytes.len - done;
        }
        if (index >= f.count && !grow(f)) {
            break;
        }
        var sector_number = sector_of(f.clusters[index]);
        mem.fill(sector[:], 0);
        if (part < SECTOR && index * SECTOR < f.size && !disk.read(sector_number, sector)) {
            return -1;
        }
        mem.copy(sector[offset:offset + part], bytes[done:done + part]);
        if (!disk.write(sector_number, sector)) {
            return -1;
        }
        done += part;
        f.position += part;
        if (f.position > f.size) {
            f.size = f.position;
        }
        f.changed = true;
    }
    if (done == 0 && bytes.len > 0) {
        return -1;
    }
    return done;
}

// Adds a cluster to the end of a file
fn grow(f: *File) bool {
    var c = allocate();
    if (c == 0) {
        return false;
    }
    if (f.count > 0) {
        set(f.clusters[f.count - 1], c);
    }
    if (f.count == f.clusters.len) {
        var larger = new(int, f.count * 2 + 4);
        for (var i = 0; i < f.count; i += 1) {
            larger[i] = f.clusters[i];
        }
        free(f.clusters);
        f.clusters = larger;
    }
    f.clusters[f.count] = c;
    f.count += 1;
    f.changed = true;
    return true;
}

// Moves to offset from the start (0), the current position (1) or the end (2), within the file, and
// returns the new position or -1
pub fn seek(f: *File, offset: int, origin: int) int {
    var base = 0;
    if (origin == 1) {
        base = f.position;
    } else if (origin == 2) {
        base = f.size;
    } else if (origin != 0) {
        return -1;
    }
    var position = base + offset;
    if (position < 0 || position > f.size) {
        return -1;
    }
    f.position = position;
    return position;
}

// Records the size and the clusters of a changed file, and forgets the file
pub fn close(f: *File) Error {
    var e = Error.NONE;
    if (f.changed) {
        var first = 0;
        if (f.count > 0) {
            first = f.clusters[0];
        }
        e = set_entry(&f.place, first, f.size);
    }
    free(f.clusters);
    free(f);
    return e;
}

// The whole content of a file, which free gives back
pub fn read_file(path: []u8, bytes: *[]u8) Error {
    var e = Error.NONE;
    var f = open(path, READ, &e);
    if (f == null) {
        return e;
    }
    *bytes = new(u8, f.size);
    if (read(f, *bytes) != f.size) {
        e = Error.DISK_ERROR;
        free(*bytes);
    }
    close(f);
    return e;
}

// Creates or replaces a file with bytes
pub fn write_file(path: []u8, bytes: []u8) Error {
    var e = Error.NONE;
    var f = open(path, WRITE, &e);
    if (f == null) {
        return e;
    }
    if (write(f, bytes) != bytes.len) {
        e = Error.DISK_FULL;
    }
    var closed = close(f);
    if (e == Error.NONE) {
        e = closed;
    }
    return e;
}
