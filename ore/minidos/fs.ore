// The MiniDos file system, one on the disk of each drive from A: to D:. Sector 0 describes the disk, the
// allocation table follows it, and then come the clusters, one sector each. The table holds an int for every
// cluster: the next cluster of the same file, END for its last one, or 0 for a free one. Directories are files
// of 32-byte entries, the root directory included, and every other directory starts with the entries . and ..
// for itself and its parent.
import "std/mem";
import "std/str";
import "disk";
import "time";

pub const DRIVES = disk.DRIVES;

// Attributes of entries
pub const READ_ONLY: u8 = 0x01;
pub const HIDDEN: u8 = 0x02;
pub const SYSTEM: u8 = 0x04;
pub const DIRECTORY: u8 = 0x10;
pub const ARCHIVE: u8 = 0x20;

// The sizes in sectors that a disk can be formatted to, and the size of a disk that had none
pub const SMALLEST = 16;
pub const LARGEST = 65536;
pub const NEW_DISK = 8192;

const SECTOR = disk.SECTOR;
const MAGIC = "MDOS";
const VERSION = 1;
const END = -1;
const PER_CLUSTER = 16;
const TABLE_PER_SECTOR = 128;

pub enum Error {
    NONE,
    NOT_FOUND,
    PATH_NOT_FOUND,
    BAD_NAME,
    EXISTS,
    DISK_FULL,
    NOT_EMPTY,
    ACCESS_DENIED,
    NOT_DIRECTORY,
    CURRENT_DIRECTORY,
    DISK_ERROR,
    NO_DISK,
    NOT_FORMATTED,
    BAD_DRIVE,
    BAD_SIZE,
}

var problem_drive = 0;      // the drive that the last NO_DISK or NOT_FORMATTED was about
var message_text: [64]u8;

pub fn message(e: Error) []u8 {
    switch (e) {
        case Error.NOT_FOUND {
            return "File not found";
        }
        case Error.PATH_NOT_FOUND {
            return "Path not found";
        }
        case Error.BAD_NAME {
            return "Invalid file name";
        }
        case Error.EXISTS {
            return "File exists";
        }
        case Error.DISK_FULL {
            return "Insufficient disk space";
        }
        case Error.NOT_EMPTY {
            return "Directory not empty";
        }
        case Error.ACCESS_DENIED {
            return "Access denied";
        }
        case Error.NOT_DIRECTORY {
            return "Invalid directory";
        }
        case Error.CURRENT_DIRECTORY {
            return "Attempt to remove current directory";
        }
        case Error.DISK_ERROR {
            return "Disk error";
        }
        case Error.NO_DISK {
            return about_drive("There is no disk in drive ", "");
        }
        case Error.NOT_FORMATTED {
            return about_drive("The disk in drive ", " is not formatted");
        }
        case Error.BAD_DRIVE {
            return "Invalid drive specification";
        }
        case Error.BAD_SIZE {
            return "A disk holds 8K to 32,768K";
        }
    }
    return "No error";
}

fn about_drive(before: []u8, after: []u8) []u8 {
    mem.copy(message_text[:], before);
    message_text[before.len] = letter(problem_drive);
    mem.copy(message_text[before.len + 1:], after);
    return message_text[:before.len + 1 + after.len];
}

// The letter of a drive
pub fn letter(d: int) u8 {
    return 'A' + d as u8;
}

// A directory entry as it is on the disk
pub struct Entry {
    name: [11]u8;           // 8 characters of name and 3 of extension, filled up with spaces; 0 first when free
    attributes: u8;
    cluster: int;           // the first cluster, 0 for an empty file
    size: int;
    time: u32;              // when it was last written, as a clock value, or 0
    reserved: [8]u8;
}

struct Boot {
    magic: [4]u8;
    version: int;
    sectors: int;
    table: int;             // the first sector of the allocation table
    table_sectors: int;
    data: int;              // the sector of cluster 1
    clusters: int;
    root: int;              // the first cluster of the root directory
    label: [11]u8;
}

// The file system of a drive while it is in use
struct Volume {
    drive: int;
    ready: bool;
    boot: Boot;
    table: []int;
    changed: []bool;        // sectors of the table that differ from the disk
    free: int;              // free clusters
    hint: int;              // where the search for a free cluster starts
    current: int;           // the first cluster of the current directory
    path: []u8;             // the current directory as \NAME\NAME
}

var volumes: [DRIVES]Volume;
var drive = 0;              // the current drive

pub fn current_drive() int {
    return drive;
}

pub fn mounted(d: int) bool {
    return d >= 0 && d < DRIVES && volumes[d].ready;
}

// Makes another drive the current one, if its file system can be used
pub fn change_drive(d: int) Error {
    var e = Error.NONE;
    if (volume(d, &e) != null) {
        drive = d;
    }
    return e;
}

// The current directory of a drive as \NAME\NAME
pub fn directory(d: int) []u8 {
    if (!mounted(d)) {
        return "\\";
    }
    return volumes[d].path;
}

pub fn label(d: int) []u8 {
    if (!mounted(d)) {
        return "";
    }
    var name = volumes[d].boot.label[:];
    var end = name.len;
    while (end > 0 && name[end - 1] == ' ') {
        end -= 1;
    }
    return name[:end];
}

fn table_bytes(v: *Volume) []u8 {
    return mem.bytes(v.table.ptr as *u8, v.table.len * 4);
}

// Reads the description and the allocation table of a drive's disk and starts in its root directory
pub fn mount(d: int) Error {
    var v = &volumes[d];
    v.drive = d;
    v.ready = false;
    problem_drive = d;
    if (!disk.present(d)) {
        return Error.NO_DISK;
    }
    var sectors = disk.sectors(d);
    if (sectors == 0) {
        return Error.NOT_FORMATTED;
    }
    var sector: [SECTOR]u8;
    if (!disk.read(d, 0, sector)) {
        return Error.DISK_ERROR;
    }
    var b = *(&sector[0] as *Boot);
    if (!mem.equal(b.magic[:], MAGIC) || b.version != VERSION || b.clusters < 1 || b.table < 1 ||
        b.table_sectors < 1 || b.table + b.table_sectors > b.data || b.table_sectors * TABLE_PER_SECTOR <= b.clusters ||
        b.data + b.clusters > sectors || b.root < 1 || b.root > b.clusters) {
        return Error.NOT_FORMATTED;
    }
    v.boot = b;
    free(v.table);
    free(v.changed);
    v.table = new(int, b.table_sectors * TABLE_PER_SECTOR);
    v.changed = new(bool, b.table_sectors);
    if (!disk.read(d, b.table, table_bytes(v))) {
        return Error.DISK_ERROR;
    }
    v.free = 0;
    for (var c = 1; c <= b.clusters; c += 1) {
        if (v.table[c] == 0) {
            v.free += 1;
        }
    }
    v.hint = 1;
    v.current = b.root;
    free(v.path);
    v.path = str.clone("\\");
    v.ready = true;
    return Error.NONE;
}

// Whether a drive's disk holds a file system, which format would then destroy
pub fn formatted(d: int) bool {
    return mounted(d) || mount(d) == Error.NONE;
}

// Makes an empty file system on a drive's disk, with a label of up to 11 characters, after giving the disk
// size sectors unless size is 0
pub fn format(d: int, name: []u8, size: int) Error {
    var v = &volumes[d];
    v.ready = false;
    problem_drive = d;
    if (!disk.present(d)) {
        return Error.NO_DISK;
    }
    if (size != 0 && size != disk.sectors(d)) {
        if (size < SMALLEST || size > LARGEST) {
            return Error.BAD_SIZE;
        }
        if (!disk.resize(d, size)) {
            return Error.DISK_ERROR;
        }
    }
    var sectors = disk.sectors(d);
    if (sectors < SMALLEST) {
        return Error.BAD_SIZE;
    }
    if (sectors > LARGEST) {
        sectors = LARGEST;
    }
    var table_sectors = (sectors + TABLE_PER_SECTOR - 1) / TABLE_PER_SECTOR;
    var b = Boot {
        version: VERSION, sectors: sectors, table: 1, table_sectors: table_sectors, data: 1 + table_sectors,
        clusters: sectors - 1 - table_sectors, root: 1,
    };
    mem.copy(b.magic[:], MAGIC);
    set_label_text(&b, name);

    var sector: [SECTOR]u8;
    *(&sector[0] as *Boot) = b;
    var empty = new(int, table_sectors * TABLE_PER_SECTOR);
    empty[b.root] = END;
    var ok = disk.write(d, 0, sector) && disk.write(d, b.table, mem.bytes(empty.ptr as *u8, empty.len * 4));
    free(empty);
    mem.fill(sector[:], 0);
    if (!ok || !disk.write(d, b.data + b.root - 1, sector)) {
        return Error.DISK_ERROR;
    }
    return mount(d);
}

fn set_label_text(b: *Boot, name: []u8) {
    mem.fill(b.label[:], ' ');
    for (var i = 0; i < name.len && i < b.label.len; i += 1) {
        b.label[i] = upper(name[i]);
    }
}

// Gives a drive's disk another label
pub fn set_label(d: int, name: []u8) Error {
    var e = Error.NONE;
    var v = volume(d, &e);
    if (v == null) {
        return e;
    }
    set_label_text(&v.boot, name);
    var sector: [SECTOR]u8;
    *(&sector[0] as *Boot) = v.boot;
    if (!disk.write(d, 0, sector)) {
        return Error.DISK_ERROR;
    }
    return Error.NONE;
}

// The file system of a drive, mounted if it was not yet, or null with the reason in *e
fn volume(d: int, e: *Error) *Volume {
    if (d < 0 || d >= DRIVES) {
        *e = Error.BAD_DRIVE;
        return null;
    }
    if (!volumes[d].ready) {
        *e = mount(d);
        if (*e != Error.NONE) {
            return null;
        }
    }
    return &volumes[d];
}

fn upper(c: u8) u8 {
    if (c >= 'a' && c <= 'z') {
        return c - 'a' + 'A';
    }
    return c;
}

fn sector_of(v: *Volume, cluster: int) int {
    return v.boot.data + cluster - 1;
}

fn valid(v: *Volume, cluster: int) bool {
    return cluster >= 1 && cluster <= v.boot.clusters;
}

fn set(v: *Volume, cluster: int, value: int) {
    if (v.table[cluster] == 0 && value != 0) {
        v.free -= 1;
    } else if (v.table[cluster] != 0 && value == 0) {
        v.free += 1;
    }
    v.table[cluster] = value;
    v.changed[cluster / TABLE_PER_SECTOR] = true;
}

// Writes the changed sectors of the allocation table
fn flush(v: *Volume) bool {
    var bytes = table_bytes(v);
    var ok = true;
    for (var i = 0; i < v.changed.len; i += 1) {
        if (v.changed[i]) {
            ok = disk.write(v.drive, v.boot.table + i, bytes[i * SECTOR:(i + 1) * SECTOR]) && ok;
            v.changed[i] = false;
        }
    }
    return ok;
}

// A free cluster, made the last of a chain, or 0 when the disk is full
fn allocate(v: *Volume) int {
    if (v.free == 0) {
        return 0;
    }
    for (var n = 0; n < v.boot.clusters; n += 1) {
        var c = v.hint;
        v.hint = v.hint % v.boot.clusters + 1;
        if (v.table[c] == 0) {
            set(v, c, END);
            return c;
        }
    }
    return 0;
}

// The clusters of the chain from first on, which free gives back. A damaged table cannot make it loop.
fn chain(v: *Volume, first: int) []int {
    var count = 0;
    var c = first;
    while (valid(v, c) && count < v.boot.clusters) {
        count += 1;
        c = v.table[c];
    }
    var clusters = new(int, count);
    c = first;
    for (var i = 0; i < count; i += 1) {
        clusters[i] = c;
        c = v.table[c];
    }
    return clusters;
}

// Frees the chain from first on
fn release(v: *Volume, first: int) {
    var c = first;
    for (var n = 0; valid(v, c) && n < v.boot.clusters; n += 1) {
        var next = v.table[c];
        set(v, c, 0);
        c = next;
    }
}

pub fn free_bytes(d: int) int {
    if (!mounted(d)) {
        return 0;
    }
    return volumes[d].free * SECTOR;
}

pub fn total_bytes(d: int) int {
    if (!mounted(d)) {
        return 0;
    }
    return volumes[d].boot.clusters * SECTOR;
}

// A whole directory in memory
struct Directory {
    v: *Volume;
    first: int;
    clusters: []int;
    entries: []Entry;
}

fn cluster_bytes(d: *Directory, i: int) []u8 {
    return mem.bytes(&d.entries[i * PER_CLUSTER] as *u8, SECTOR);
}

fn load(v: *Volume, first: int, d: *Directory) Error {
    d.v = v;
    d.first = first;
    d.clusters = chain(v, first);
    d.entries = new(Entry, d.clusters.len * PER_CLUSTER);
    for (var i = 0; i < d.clusters.len; i += 1) {
        if (!disk.read(v.drive, sector_of(v, d.clusters[i]), cluster_bytes(d, i))) {
            unload(d);
            return Error.DISK_ERROR;
        }
    }
    return Error.NONE;
}

fn unload(d: *Directory) {
    free(d.clusters);
    free(d.entries);
}

// Writes the cluster that holds entry index back to the disk
fn store(d: *Directory, index: int) Error {
    var i = index / PER_CLUSTER;
    if (!disk.write(d.v.drive, sector_of(d.v, d.clusters[i]), cluster_bytes(d, i))) {
        return Error.DISK_ERROR;
    }
    return Error.NONE;
}

// Puts an entry into a free place of a directory, which grows by a cluster when it has none, and
// stores it. *index receives its place.
fn add(d: *Directory, entry: Entry, index: *int) Error {
    var free_index = -1;
    for (var i = 0; i < d.entries.len && free_index < 0; i += 1) {
        if (d.entries[i].name[0] == 0) {
            free_index = i;
        }
    }
    if (free_index < 0) {
        var c = allocate(d.v);
        if (c == 0) {
            return Error.DISK_FULL;
        }
        set(d.v, d.clusters[d.clusters.len - 1], c);
        var clusters = new(int, d.clusters.len + 1);
        var entries = new(Entry, clusters.len * PER_CLUSTER);
        for (var i = 0; i < d.clusters.len; i += 1) {
            clusters[i] = d.clusters[i];
        }
        clusters[d.clusters.len] = c;
        for (var i = 0; i < d.entries.len; i += 1) {
            entries[i] = d.entries[i];
        }
        free_index = d.entries.len;
        unload(d);
        d.clusters = clusters;
        d.entries = entries;
    }
    d.entries[free_index] = entry;
    *index = free_index;
    var e = store(d, free_index);
    if (e == Error.NONE && !flush(d.v)) {
        e = Error.DISK_ERROR;
    }
    return e;
}

fn find_in(d: *Directory, name: [11]u8) int {
    for (var i = 0; i < d.entries.len; i += 1) {
        if (mem.equal(d.entries[i].name[:], name[:])) {
            return i;
        }
    }
    return -1;
}

// The 11 characters of an entry for a name like README.TXT, in capitals
pub struct Name {
    chars: [11]u8;
    ok: bool;
}

fn is_name_char(c: u8) bool {
    return str.is_letter(c) || str.is_digit(c) || str.find_byte("!#$%&'()-@^_`{}~", c) >= 0;
}

// Fills part with text, where wildcards let * fill the rest with ? and ? stand for any character
fn fill_part(part: []u8, text: []u8, wildcards: bool) bool {
    if (text.len > part.len && !(wildcards && str.find_byte(text, '*') >= 0 && str.find_byte(text, '*') < part.len)) {
        return false;
    }
    for (var i = 0; i < text.len; i += 1) {
        var c = text[i];
        if (wildcards && c == '*') {
            for (var k = i; k < part.len; k += 1) {
                part[k] = '?';
            }
            return i == text.len - 1;
        }
        if (!(wildcards && c == '?') && !is_name_char(c)) {
            return false;
        }
        part[i] = upper(c);
    }
    return true;
}

// Turns a name into the characters of an entry. Wildcards allow * and ?, and a pattern without a dot
// matches any extension when all is set.
pub fn short_name(text: []u8, wildcards: bool, all: bool) Name {
    var result = Name {};
    mem.fill(result.chars[:], ' ');
    if (str.equal(text, ".") || str.equal(text, "..")) {
        mem.copy(result.chars[:], text);
        result.ok = true;
        return result;
    }
    var dot = str.find_byte(text, '.');
    var base = text;
    var extension = text[:0];
    if (dot >= 0) {
        base = text[:dot];
        extension = text[dot + 1:];
    } else if (wildcards && all) {
        extension = "*";
    }
    result.ok = base.len > 0 && str.find_byte(extension, '.') < 0 && fill_part(result.chars[0:8], base, wildcards) &&
        fill_part(result.chars[8:11], extension, wildcards);
    return result;
}

pub fn has_wildcards(text: []u8) bool {
    return str.find_byte(text, '*') >= 0 || str.find_byte(text, '?') >= 0;
}

pub fn matches(pattern: [11]u8, name: [11]u8) bool {
    for (var i = 0; i < name.len; i += 1) {
        if (pattern[i] != '?' && pattern[i] != name[i]) {
            return false;
        }
    }
    return true;
}

// Writes the name of an entry like README.TXT into buffer, which takes 12 bytes, and returns that part
pub fn name_text(name: [11]u8, buffer: []u8) []u8 {
    var length = 0;
    for (var i = 0; i < 8 && name[i] != ' '; i += 1) {
        buffer[length] = name[i];
        length += 1;
    }
    if (name[8] != ' ') {
        buffer[length] = '.';
        length += 1;
        for (var i = 8; i < 11 && name[i] != ' '; i += 1) {
            buffer[length] = name[i];
            length += 1;
        }
    }
    return buffer[:length];
}

pub fn is_separator(c: u8) bool {
    return c == '\\' || c == '/';
}

// Takes the drive letter and its colon off the start of a path and leaves the drive in *d, the current one
// when the path names none
pub fn drive_of(path: []u8, d: *int) []u8 {
    if (path.len >= 2 && path[1] == ':') {
        *d = (upper(path[0]) - 'A') as int;
        return path[2:];
    }
    *d = drive;
    return path;
}

// The directory that holds entries of the given name, or 0: the directory itself for ., its parent for ..
fn enter(v: *Volume, dir: int, name: []u8, e: *Error) int {
    var n = short_name(name, false, false);
    if (!n.ok) {
        *e = Error.PATH_NOT_FOUND;
        return 0;
    }
    if (str.equal(name, ".") || str.equal(name, "..") && dir == v.boot.root) {
        return dir;
    }
    var d = Directory {};
    *e = load(v, dir, &d);
    if (*e != Error.NONE) {
        return 0;
    }
    var i = find_in(&d, n.chars);
    var next = 0;
    if (i < 0 || (d.entries[i].attributes & DIRECTORY) == 0) {
        *e = Error.PATH_NOT_FOUND;
    } else {
        next = d.entries[i].cluster;
        if (next == 0) {
            next = v.boot.root;
        }
    }
    unload(&d);
    return next;
}

// Where a path leads: the drive and the directory that hold its entry, the entry's index there and the entry
// itself. A directory named by ., .., a trailing \ or as the root has no index, only its cluster in the entry.
pub struct Place {
    drive: int;
    dir: int;
    index: int;
    entry: Entry;
}

// Follows a path to the directory that holds its last part, leaves that part in *last and the drive and the
// directory in place
fn walk(path: []u8, last: *[]u8, place: *Place) Error {
    var d = 0;
    var p = drive_of(path, &d);
    var e = Error.NONE;
    var v = volume(d, &e);
    if (v == null) {
        return e;
    }
    place.drive = d;
    var at = v.current;
    if (p.len > 0 && is_separator(p[0])) {
        at = v.boot.root;
        p = p[1:];
    }
    for (;;) {
        var end = 0;
        while (end < p.len && !is_separator(p[end])) {
            end += 1;
        }
        if (end == p.len) {
            *last = p;
            place.dir = at;
            return Error.NONE;
        }
        if (end > 0) {
            at = enter(v, at, p[:end], &e);
            if (e != Error.NONE) {
                return e;
            }
        }
        p = p[end + 1:];
    }
    return Error.NONE;
}

pub fn find(path: []u8, place: *Place) Error {
    var last: []u8;
    var e = walk(path, &last, place);
    if (e != Error.NONE) {
        return e;
    }
    var v = &volumes[place.drive];
    if (last.len == 0 || str.equal(last, ".") || str.equal(last, "..")) {
        if (last.len > 0) {
            place.dir = enter(v, place.dir, last, &e);
            if (e != Error.NONE) {
                return e;
            }
        }
        place.index = -1;
        place.entry = Entry { attributes: DIRECTORY, cluster: place.dir };
        mem.fill(place.entry.name[:], ' ');
        return Error.NONE;
    }
    var n = short_name(last, false, false);
    if (!n.ok) {
        return Error.BAD_NAME;
    }
    var d = Directory {};
    e = load(v, place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    var i = find_in(&d, n.chars);
    if (i < 0) {
        e = Error.NOT_FOUND;
    } else {
        place.index = i;
        place.entry = d.entries[i];
    }
    unload(&d);
    return e;
}

pub fn is_directory(place: *Place) bool {
    return (place.entry.attributes & DIRECTORY) != 0;
}

// The directory a path names and the pattern of its last part, for listing and wildcard commands. A
// directory stands for all of its entries.
pub struct Selection {
    drive: int;
    dir: int;
    pattern: [11]u8;
}

pub fn select(path: []u8, all: bool, selection: *Selection) Error {
    var everything = short_name("*.*", true, false);
    var place = Place {};
    if (!has_wildcards(path)) {
        var e = find(path, &place);
        if (e == Error.NONE && is_directory(&place)) {
            *selection = Selection { drive: place.drive, dir: place.entry.cluster, pattern: everything.chars };
            if (place.entry.cluster == 0) {
                selection.dir = volumes[place.drive].boot.root;
            }
            return Error.NONE;
        }
        if (e != Error.NONE && e != Error.NOT_FOUND) {
            return e;
        }
    }
    var last: []u8;
    var e = walk(path, &last, &place);
    if (e != Error.NONE) {
        return e;
    }
    var n = short_name(last, true, all);
    if (!n.ok) {
        return Error.BAD_NAME;
    }
    *selection = Selection { drive: place.drive, dir: place.dir, pattern: n.chars };
    return Error.NONE;
}

// The entries of a selection apart from free ones, and hidden ones unless asked for; free gives them back
pub fn list(selection: *Selection, hidden: bool, entries: *[]Entry) Error {
    var e = Error.NONE;
    var v = volume(selection.drive, &e);
    if (v == null) {
        return e;
    }
    var d = Directory {};
    e = load(v, selection.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    var count = 0;
    for (var pass = 0; pass < 2; pass += 1) {
        if (pass == 1) {
            *entries = new(Entry, count);
            count = 0;
        }
        for (var i = 0; i < d.entries.len; i += 1) {
            var entry = d.entries[i];
            if (entry.name[0] != 0 && matches(selection.pattern, entry.name) &&
                (hidden || (entry.attributes & HIDDEN) == 0)) {
                if (pass == 1) {
                    (*entries)[count] = entry;
                }
                count += 1;
            }
        }
    }
    unload(&d);
    return Error.NONE;
}

// Removes a file
pub fn delete(path: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    if (place.index < 0 || is_directory(&place) || (place.entry.attributes & READ_ONLY) != 0) {
        return Error.ACCESS_DENIED;
    }
    return remove_entry(&place);
}

fn remove_entry(place: *Place) Error {
    var v = &volumes[place.drive];
    var d = Directory {};
    var e = load(v, place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    release(v, d.entries[place.index].cluster);
    d.entries[place.index].name[0] = 0;
    e = store(&d, place.index);
    unload(&d);
    if (e == Error.NONE && !flush(v)) {
        e = Error.DISK_ERROR;
    }
    return e;
}

// Gives the file or directory at path the name new_name, in the same directory
pub fn rename(path: []u8, new_name: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    var n = short_name(new_name, false, false);
    if (place.index < 0 || !n.ok || n.chars[0] == '.') {
        return Error.BAD_NAME;
    }
    var v = &volumes[place.drive];
    if (is_directory(&place) && inside(v, v.current, place.entry.cluster)) {
        return Error.ACCESS_DENIED;
    }
    var d = Directory {};
    e = load(v, place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    if (find_in(&d, n.chars) >= 0) {
        e = Error.EXISTS;
    } else {
        d.entries[place.index].name = n.chars;
        e = store(&d, place.index);
    }
    unload(&d);
    return e;
}

// The parent of a directory other than the root, which its entry .. names, or 0
fn parent(v: *Volume, dir: int) int {
    var entries: [PER_CLUSTER]Entry;
    if (!valid(v, dir) || !disk.read(v.drive, sector_of(v, dir), mem.bytes(&entries[0] as *u8, SECTOR)) ||
        entries[1].name[0] != '.' || entries[1].name[1] != '.') {
        return 0;
    }
    return entries[1].cluster;
}

// Whether the directory dir is ancestor or lies inside it
fn inside(v: *Volume, dir: int, ancestor: int) bool {
    var at = dir;
    for (var n = 0; n < v.boot.clusters && at != 0; n += 1) {
        if (at == ancestor) {
            return true;
        }
        if (at == v.boot.root) {
            return false;
        }
        at = parent(v, at);
    }
    return false;
}

// Moves the entry at path to target, a new name in any directory of the same drive. A directory cannot move
// into itself, and neither can one that holds the current directory.
pub fn move(path: []u8, target: []u8) Error {
    var from = Place {};
    var e = find(path, &from);
    if (e != Error.NONE) {
        return e;
    }
    var to = Place {};
    var last: []u8;
    e = walk(target, &last, &to);
    if (e != Error.NONE) {
        return e;
    }
    var n = short_name(last, false, false);
    if (from.index < 0 || to.drive != from.drive) {
        return Error.ACCESS_DENIED;
    }
    if (!n.ok || n.chars[0] == '.') {
        return Error.BAD_NAME;
    }
    var v = &volumes[from.drive];
    var directory = is_directory(&from);
    if (directory && (inside(v, to.dir, from.entry.cluster) || inside(v, v.current, from.entry.cluster))) {
        return Error.ACCESS_DENIED;
    }
    var d = Directory {};
    e = load(v, to.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    if (find_in(&d, n.chars) >= 0) {
        unload(&d);
        return Error.EXISTS;
    }
    var entry = from.entry;
    entry.name = n.chars;
    var index = 0;
    e = add(&d, entry, &index);
    unload(&d);
    if (e != Error.NONE) {
        return e;
    }
    e = load(v, from.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    d.entries[from.index].name[0] = 0;
    e = store(&d, from.index);
    unload(&d);
    if (e != Error.NONE || !directory || to.dir == from.dir) {
        return e;
    }
    e = load(v, entry.cluster, &d);
    if (e != Error.NONE) {
        return e;
    }
    d.entries[1].cluster = to.dir;
    e = store(&d, 1);
    unload(&d);
    return e;
}

// Gives a file or directory another time of writing
pub fn set_time(path: []u8, clock: u32) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    if (place.index < 0) {
        return Error.ACCESS_DENIED;
    }
    var d = Directory {};
    e = load(&volumes[place.drive], place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    d.entries[place.index].time = clock;
    e = store(&d, place.index);
    unload(&d);
    return e;
}

// Changes the attributes of a file or directory, apart from whether it is a directory
pub fn set_attributes(path: []u8, attributes: u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    if (place.index < 0) {
        return Error.ACCESS_DENIED;
    }
    var d = Directory {};
    e = load(&volumes[place.drive], place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    var entry = &d.entries[place.index];
    entry.attributes = entry.attributes & DIRECTORY | attributes & ~DIRECTORY;
    e = store(&d, place.index);
    unload(&d);
    return e;
}

// Makes an entry for a new, empty file or directory at path
fn create(path: []u8, attributes: u8, place: *Place) Error {
    var last: []u8;
    var e = walk(path, &last, place);
    if (e != Error.NONE) {
        return e;
    }
    var n = short_name(last, false, false);
    if (!n.ok || n.chars[0] == '.') {
        return Error.BAD_NAME;
    }
    var d = Directory {};
    e = load(&volumes[place.drive], place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    if (find_in(&d, n.chars) >= 0) {
        unload(&d);
        return Error.EXISTS;
    }
    var entry = Entry { name: n.chars, attributes: attributes, time: time.now() };
    var index = 0;
    e = add(&d, entry, &index);
    unload(&d);
    place.index = index;
    place.entry = entry;
    return e;
}

pub fn make_directory(path: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e == Error.NONE) {
        return Error.EXISTS;
    }
    if (e != Error.NOT_FOUND) {
        return e;
    }
    var v = &volumes[place.drive];
    var c = allocate(v);
    if (c == 0) {
        return Error.DISK_FULL;
    }
    e = create(path, DIRECTORY, &place);
    if (e != Error.NONE) {
        release(v, c);
        flush(v);
        return e;
    }
    var entries: [PER_CLUSTER]Entry;
    mem.fill(entries[0].name[:], ' ');
    entries[0].name[0] = '.';
    entries[0].attributes = DIRECTORY;
    entries[0].cluster = c;
    entries[0].time = time.now();
    entries[1] = entries[0];
    entries[1].name[1] = '.';
    entries[1].cluster = place.dir;
    if (!disk.write(v.drive, sector_of(v, c), mem.bytes(&entries[0] as *u8, SECTOR))) {
        return Error.DISK_ERROR;
    }
    return set_entry(&place, c, 0);
}

// Changes where the entry at place starts and how long it is, which makes now the time it was written
fn set_entry(place: *Place, cluster: int, length: int) Error {
    var v = &volumes[place.drive];
    var d = Directory {};
    var e = load(v, place.dir, &d);
    if (e != Error.NONE) {
        return e;
    }
    d.entries[place.index].cluster = cluster;
    d.entries[place.index].size = length;
    d.entries[place.index].time = time.now();
    place.entry = d.entries[place.index];
    e = store(&d, place.index);
    unload(&d);
    if (e == Error.NONE && !flush(v)) {
        e = Error.DISK_ERROR;
    }
    return e;
}

// Removes an empty directory
pub fn remove_directory(path: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e != Error.NONE) {
        return e;
    }
    if (!is_directory(&place)) {
        return Error.NOT_DIRECTORY;
    }
    var v = &volumes[place.drive];
    if (place.index < 0 || place.entry.cluster == v.boot.root) {
        return Error.ACCESS_DENIED;
    }
    if (place.entry.cluster == v.current) {
        return Error.CURRENT_DIRECTORY;
    }
    var d = Directory {};
    e = load(v, place.entry.cluster, &d);
    if (e != Error.NONE) {
        return e;
    }
    for (var i = 0; i < d.entries.len; i += 1) {
        if (d.entries[i].name[0] != 0 && d.entries[i].name[0] != '.') {
            e = Error.NOT_EMPTY;
        }
    }
    unload(&d);
    if (e != Error.NONE) {
        return e;
    }
    return remove_entry(&place);
}

// Makes path the current directory of its drive
pub fn change_directory(path: []u8) Error {
    var place = Place {};
    var e = find(path, &place);
    if (e == Error.NOT_FOUND || e == Error.BAD_NAME) {
        return Error.NOT_DIRECTORY;
    }
    if (e != Error.NONE) {
        return e;
    }
    if (!is_directory(&place)) {
        return Error.NOT_DIRECTORY;
    }
    var full = absolute(path);
    var v = &volumes[place.drive];
    v.current = place.entry.cluster;
    free(v.path);
    v.path = str.clone(full[2:]);
    free(full);
    return Error.NONE;
}

// The path from the root to what path names, with its drive, in capitals and without . and .., which free
// gives back
pub fn absolute(path: []u8) []u8 {
    var d = 0;
    var p = drive_of(path, &d);
    var b = str.builder(64);
    str.append_byte(&b, letter(d));
    str.append_byte(&b, ':');
    if (p.len == 0 || !is_separator(p[0])) {
        str.append(&b, directory(d));
    }
    while (p.len > 0) {
        var end = 0;
        while (end < p.len && !is_separator(p[end])) {
            end += 1;
        }
        var part = p[:end];
        if (str.equal(part, "..")) {
            var text = str.text(&b);
            var slash = str.find_last_byte(text, '\\');
            if (slash > 2) {
                b.len = slash;
            } else {
                b.len = 2;
            }
        } else if (part.len > 0 && !str.equal(part, ".")) {
            var n = short_name(part, false, false);
            var buffer: [12]u8;
            if (!str.ends_with(str.text(&b), "\\")) {
                str.append_byte(&b, '\\');
            }
            str.append(&b, name_text(n.chars, buffer));
        }
        if (end == p.len) {
            break;
        }
        p = p[end + 1:];
    }
    if (b.len == 2) {
        str.append_byte(&b, '\\');
    }
    var result = str.clone(str.text(&b));
    str.release(&b);
    return result;
}

// An open file. Writing through it can make it longer, and closing it records its size.
pub struct File {
    place: Place;
    clusters: []int;        // the file's chain, with room to grow
    count: int;             // how many of them it uses
    size: int;
    position: int;
    writable: bool;
    appending: bool;
    changed: bool;
}

// Modes of open, as the VM's syscalls number them
pub const READ = 0;
pub const WRITE = 1;        // creates the file, or empties it
pub const APPEND = 2;
pub const UPDATE = 3;       // reads and writes a file that exists
pub const REPLACE = 4;      // reads and writes a file it creates or empties

pub fn open(path: []u8, mode: int, e: *Error) *File {
    var place = Place {};
    *e = find(path, &place);
    if (*e == Error.NOT_FOUND && mode != READ && mode != UPDATE) {
        *e = create(path, 0, &place);
    }
    if (*e != Error.NONE) {
        return null;
    }
    if (place.index < 0 || is_directory(&place) || mode < READ || mode > REPLACE ||
        mode != READ && (place.entry.attributes & READ_ONLY) != 0) {
        *e = Error.ACCESS_DENIED;
        return null;
    }
    var v = &volumes[place.drive];
    if ((mode == WRITE || mode == REPLACE) && place.entry.cluster != 0) {
        release(v, place.entry.cluster);
        *e = set_entry(&place, 0, 0);
        if (*e != Error.NONE) {
            return null;
        }
    }
    var f = new(File);
    f.place = place;
    f.clusters = chain(v, place.entry.cluster);
    f.count = f.clusters.len;
    f.size = place.entry.size;
    f.writable = mode != READ;
    f.appending = mode == APPEND;
    if (f.appending) {
        f.position = f.size;
    }
    return f;
}

pub fn file_size(f: *File) int {
    return f.size;
}

// Reads up to buffer.len bytes from the current position and returns how many, 0 at the end, or -1
pub fn read(f: *File, buffer: []u8) int {
    var v = &volumes[f.place.drive];
    var count = f.size - f.position;
    if (count > buffer.len) {
        count = buffer.len;
    }
    var sector: [SECTOR]u8;
    var done = 0;
    while (done < count) {
        var index = f.position / SECTOR;
        var offset = f.position % SECTOR;
        var part = SECTOR - offset;
        if (part > count - done) {
            part = count - done;
        }
        if (index >= f.count || !disk.read(v.drive, sector_of(v, f.clusters[index]), sector)) {
            return -1;
        }
        mem.copy(buffer[done:done + part], sector[offset:offset + part]);
        done += part;
        f.position += part;
    }
    return done;
}

// Writes bytes at the current position, or at the end when appending, and returns how many or -1
pub fn write(f: *File, bytes: []u8) int {
    if (!f.writable) {
        return -1;
    }
    var v = &volumes[f.place.drive];
    if (f.appending) {
        f.position = f.size;
    }
    var sector: [SECTOR]u8;
    var done = 0;
    while (done < bytes.len) {
        var index = f.position / SECTOR;
        var offset = f.position % SECTOR;
        var part = SECTOR - offset;
        if (part > bytes.len - done) {
            part = bytes.len - done;
        }
        if (index >= f.count && !grow(f)) {
            break;
        }
        var sector_number = sector_of(v, f.clusters[index]);
        mem.fill(sector[:], 0);
        if (part < SECTOR && index * SECTOR < f.size && !disk.read(v.drive, sector_number, sector)) {
            return -1;
        }
        mem.copy(sector[offset:offset + part], bytes[done:done + part]);
        if (!disk.write(v.drive, sector_number, sector)) {
            return -1;
        }
        done += part;
        f.position += part;
        if (f.position > f.size) {
            f.size = f.position;
        }
        f.changed = true;
    }
    if (done == 0 && bytes.len > 0) {
        return -1;
    }
    return done;
}

// Adds a cluster to the end of a file
fn grow(f: *File) bool {
    var v = &volumes[f.place.drive];
    var c = allocate(v);
    if (c == 0) {
        return false;
    }
    if (f.count > 0) {
        set(v, f.clusters[f.count - 1], c);
    }
    if (f.count == f.clusters.len) {
        var larger = new(int, f.count * 2 + 4);
        for (var i = 0; i < f.count; i += 1) {
            larger[i] = f.clusters[i];
        }
        free(f.clusters);
        f.clusters = larger;
    }
    f.clusters[f.count] = c;
    f.count += 1;
    f.changed = true;
    return true;
}

// Moves to offset from the start (0), the current position (1) or the end (2), within the file, and
// returns the new position or -1
pub fn seek(f: *File, offset: int, origin: int) int {
    var base = 0;
    if (origin == 1) {
        base = f.position;
    } else if (origin == 2) {
        base = f.size;
    } else if (origin != 0) {
        return -1;
    }
    var position = base + offset;
    if (position < 0 || position > f.size) {
        return -1;
    }
    f.position = position;
    return position;
}

// Records the size and the clusters of a changed file, and forgets the file
pub fn close(f: *File) Error {
    var e = Error.NONE;
    if (f.changed) {
        var first = 0;
        if (f.count > 0) {
            first = f.clusters[0];
        }
        e = set_entry(&f.place, first, f.size);
    }
    free(f.clusters);
    free(f);
    return e;
}

// The whole content of a file, which free gives back
pub fn read_file(path: []u8, bytes: *[]u8) Error {
    var e = Error.NONE;
    var f = open(path, READ, &e);
    if (f == null) {
        return e;
    }
    *bytes = new(u8, f.size);
    if (read(f, *bytes) != f.size) {
        e = Error.DISK_ERROR;
        free(*bytes);
    }
    close(f);
    return e;
}

// Creates or replaces a file with bytes
pub fn write_file(path: []u8, bytes: []u8) Error {
    var e = Error.NONE;
    var f = open(path, WRITE, &e);
    if (f == null) {
        return e;
    }
    if (write(f, bytes) != bytes.len) {
        e = Error.DISK_FULL;
    }
    var closed = close(f);
    if (e == Error.NONE) {
        e = closed;
    }
    return e;
}

// What check found on a disk
pub struct Report {
    directories: int;
    files: int;
    hidden: int;                // hidden files, which files leaves out
    directory_clusters: int;
    file_clusters: int;
    hidden_clusters: int;
    lost_clusters: int;
    lost_chains: int;
    problems: int;              // cross links, broken chains and sizes that do not fit
}

struct Checker {
    v: *Volume;
    owned: []bool;
    fix: bool;
    tell: fn([]u8);
    report: *Report;
}

// Checks that every cluster in use belongs to one file or directory and that sizes fit their chains, and says
// what is wrong through tell. With fix it frees lost clusters, cuts broken chains short and corrects sizes.
pub fn check(d: int, fix: bool, tell: fn([]u8), report: *Report) Error {
    var e = Error.NONE;
    var v = volume(d, &e);
    if (v == null) {
        return e;
    }
    *report = Report {};
    var c = Checker { v: v, owned: new(bool, v.boot.clusters + 1), fix: fix, tell: tell, report: report };
    var root = [3]u8 { letter(d), ':', '\\' };
    e = check_directory(&c, v.boot.root, root[:]);
    var pointed = new(bool, v.boot.clusters + 1);
    for (var cluster = 1; cluster <= v.boot.clusters; cluster += 1) {
        if (v.table[cluster] != 0 && !c.owned[cluster] && valid(v, v.table[cluster])) {
            pointed[v.table[cluster]] = true;
        }
    }
    for (var cluster = 1; cluster <= v.boot.clusters; cluster += 1) {
        if (v.table[cluster] != 0 && !c.owned[cluster]) {
            report.lost_clusters += 1;
            if (!pointed[cluster]) {
                report.lost_chains += 1;
            }
            if (fix) {
                set(v, cluster, 0);
            }
        }
    }
    free(pointed);
    free(c.owned);
    if (fix && !flush(v)) {
        e = Error.DISK_ERROR;
    }
    return e;
}

fn complaint(c: *Checker, path: []u8, what: []u8) {
    var b = str.builder(path.len + what.len);
    str.append(&b, path);
    str.append(&b, what);
    c.tell(str.text(&b));
    str.release(&b);
    c.report.problems += 1;
}

// Takes the chain from first on for the file or directory at path, up to needed clusters when that is not
// negative, and returns how many clusters it holds
fn claim(c: *Checker, first: int, path: []u8, needed: int) int {
    var v = c.v;
    var count = 0;
    var cluster = first;
    var previous = 0;
    while (cluster != 0 && cluster != END) {
        if (!valid(v, cluster)) {
            complaint(c, path, " has an invalid allocation unit");
            if (c.fix && previous != 0) {
                set(v, previous, END);
            }
            return count;
        }
        if (c.owned[cluster]) {
            var digits: [11]u8;
            var b = str.builder(40);
            str.append(&b, " is cross-linked on allocation unit ");
            str.append(&b, str.format_int(cluster, digits));
            complaint(c, path, str.text(&b));
            str.release(&b);
            if (c.fix && previous != 0) {
                set(v, previous, END);
            }
            return count;
        }
        if (needed >= 0 && count == needed) {
            complaint(c, path, " holds more allocation units than its size needs");
            if (c.fix) {
                set(v, previous, END);
            }
            return count;
        }
        c.owned[cluster] = true;
        count += 1;
        previous = cluster;
        cluster = v.table[cluster];
    }
    return count;
}

fn check_directory(c: *Checker, first: int, path: []u8) Error {
    var count = claim(c, first, path, -1);
    c.report.directories += 1;
    c.report.directory_clusters += count;
    var d = Directory {};
    var e = load(c.v, first, &d);
    if (e != Error.NONE) {
        return e;
    }
    for (var i = 0; i < d.entries.len && e == Error.NONE; i += 1) {
        var entry = d.entries[i];
        if (entry.name[0] == 0 || entry.name[0] == '.') {
            continue;
        }
        var buffer: [12]u8;
        var b = str.builder(path.len + 13);
        str.append(&b, path);
        if (!str.ends_with(path, "\\")) {
            str.append_byte(&b, '\\');
        }
        str.append(&b, name_text(entry.name, buffer));
        var child = str.clone(str.text(&b));
        str.release(&b);
        if ((entry.attributes & DIRECTORY) != 0) {
            if (!valid(c.v, entry.cluster) || c.owned[entry.cluster]) {
                complaint(c, child, " is a damaged directory");
            } else {
                e = check_directory(c, entry.cluster, child);
            }
        } else {
            // What fixing cuts off a chain is lost, and freed with the other lost clusters
            var needed = (entry.size + SECTOR - 1) / SECTOR;
            var clusters = 0;
            if (needed == 0 && entry.cluster != 0) {
                complaint(c, child, " is empty but holds allocation units");
                if (c.fix) {
                    d.entries[i].cluster = 0;
                    e = store(&d, i);
                }
            } else {
                clusters = claim(c, entry.cluster, child, needed);
            }
            if (clusters < needed) {
                complaint(c, child, " is shorter than its size; size adjusted");
                if (c.fix) {
                    d.entries[i].size = clusters * SECTOR;
                    e = store(&d, i);
                }
            }
            if ((entry.attributes & HIDDEN) != 0) {
                c.report.hidden += 1;
                c.report.hidden_clusters += clusters;
            } else {
                c.report.files += 1;
                c.report.file_clusters += clusters;
            }
        }
        free(child);
    }
    unload(&d);
    return e;
}
