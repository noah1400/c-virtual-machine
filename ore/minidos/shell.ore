// The command interpreter: reading commands, pipes and redirection, running programs and batch files, and the
// commands that batch files are made of
import "std/str";
import "args";
import "commands";
import "console";
import "fs";
import "names";
import "program";

pub const VERSION = "MiniDos Version 3.0";

var echo_on = true;
var errorlevel = 0;
var variables: [][]u8;          // NAME=VALUE
var variable_count = 0;
var stopping = false;

// A running batch file: its lines, where it is and its parameters
struct Batch {
    bytes: []u8;
    lines: [][]u8;
    next: int;
    words: []u8;                // the text that the parameters point into
    parameters: [][]u8;
    shift: int;
}

var batch: *Batch = null;

pub fn stopped() bool {
    return stopping;
}

pub fn in_batch() bool {
    return batch != null;
}

// Reads commands at the prompt until EXIT or the end of the input
pub fn interact() {
    var buffer: [256]u8;
    while (!stopping) {
        prompt();
        var line: []u8;
        if (!console.read_line(buffer, &line)) {
            console.write("\n");
            return;
        }
        execute(line);
    }
}

// Shows the prompt that PROMPT sets, $P$G unless it sets one
fn prompt() {
    var pattern = variable("PROMPT");
    if (pattern.len == 0) {
        pattern = "$P$G";
    }
    var d = fs.current_drive();
    for (var i = 0; i < pattern.len; i += 1) {
        if (pattern[i] != '$' || i + 1 == pattern.len) {
            console.write_byte(pattern[i]);
            continue;
        }
        i += 1;
        switch (names.upper_byte(pattern[i])) {
            case 'P' {
                console.write_byte(fs.letter(d));
                console.write(":");
                console.write(fs.directory(d));
            }
            case 'N' {
                console.write_byte(fs.letter(d));
            }
            case 'G' {
                console.write(">");
            }
            case 'L' {
                console.write("<");
            }
            case 'B' {
                console.write("|");
            }
            case 'Q' {
                console.write("=");
            }
            case '$' {
                console.write("$");
            }
            case '_' {
                console.write("\n");
            }
            case 'V' {
                console.write(VERSION);
            }
            case 'E' {
                console.write_byte(0x1B);
            }
            case 'H' {
                console.write_byte(0x08);
            }
        }
    }
}

// Runs a command line: pipes and redirections, then the command
pub fn execute(text: []u8) {
    var line = str.trim(text);
    if (line.len == 0 || line[0] == ':') {
        return;
    }
    var bar = find_last_outside_quotes(line, '|');
    if (bar >= 0) {
        pipe(line[:bar], line[bar + 1:]);
        return;
    }

    // Redirections go to the end of the line, where their file names end at a space
    var command = line;
    var output: []u8;
    var input: []u8;
    var appending = false;
    var at = find_outside_quotes(line, '>');
    var from = find_outside_quotes(line, '<');
    if (at >= 0) {
        appending = at + 1 < line.len && line[at + 1] == '>';
        var start = at + 1;
        if (appending) {
            start += 1;
        }
        output = first_word(line[start:]);
        command = line[:at];
    }
    if (from >= 0) {
        input = first_word(line[from + 1:]);
        if (from < command.len) {
            command = line[:from];
        }
    }
    if (at >= 0 && output.len == 0 || from >= 0 && input.len == 0) {
        console.error("Syntax error");
        return;
    }
    run_redirected(str.trim(command), input, output, appending);
}

fn find_outside_quotes(text: []u8, c: u8) int {
    var quoted = false;
    for (var i = 0; i < text.len; i += 1) {
        if (text[i] == '"') {
            quoted = !quoted;
        } else if (text[i] == c && !quoted) {
            return i;
        }
    }
    return -1;
}

fn find_last_outside_quotes(text: []u8, c: u8) int {
    var last = -1;
    var quoted = false;
    for (var i = 0; i < text.len; i += 1) {
        if (text[i] == '"') {
            quoted = !quoted;
        } else if (text[i] == c && !quoted) {
            last = i;
        }
    }
    return last;
}

fn first_word(text: []u8) []u8 {
    var t = str.trim(text);
    var end = 0;
    while (end < t.len && t[end] != ' ' && t[end] != '<' && t[end] != '>') {
        end += 1;
    }
    return t[:end];
}

fn run_redirected(command: []u8, input: []u8, output: []u8, appending: bool) {
    var e = fs.Error.NONE;
    var in_file: *fs.File = null;
    var out_file: *fs.File = null;
    if (input.len > 0) {
        in_file = fs.open(input, fs.READ, &e);
        if (in_file == null) {
            console.fail(e);
            return;
        }
    }
    if (output.len > 0) {
        var mode = fs.WRITE;
        if (appending) {
            mode = fs.APPEND;
        }
        out_file = fs.open(output, mode, &e);
        if (out_file == null) {
            if (in_file != null) {
                fs.close(in_file);
            }
            console.fail(e);
            return;
        }
    }
    var saved_input = console.redirect_input(in_file);
    var saved_output = console.redirect_output(out_file);
    run(command);
    console.redirect_output(saved_output);
    console.redirect_input(saved_input);
    if (out_file != null) {
        e = fs.close(out_file);
        if (e != fs.Error.NONE) {
            console.fail(e);
        }
    }
    if (in_file != null) {
        fs.close(in_file);
    }
}

var pipes = 0;

// Runs left with its output going to a temporary file in the root directory of the current drive, then right
// with that file as its input
fn pipe(left: []u8, right: []u8) {
    pipes += 1;
    var digits: [11]u8;
    var temporary = names.join("\\PIPE", str.format_int(pipes, digits), ".$$$");
    var first = names.join(left, " > ", temporary);
    execute(first);
    free(first);
    var second = names.join(right, " < ", temporary);
    execute(second);
    free(second);
    fs.delete(temporary);
    free(temporary);
    pipes -= 1;
}

// The value of an environment variable, or nothing
pub fn variable(name: []u8) []u8 {
    for (var i = 0; i < variable_count; i += 1) {
        var v = variables[i];
        var equals = str.find_byte(v, '=');
        if (equals == name.len && names.same(name, v[:equals])) {
            return v[equals + 1:];
        }
    }
    return "";
}

fn set_variable(name: []u8, value: []u8) {
    var key = names.upper(str.trim(name));
    for (var i = 0; i < variable_count; i += 1) {
        var equals = str.find_byte(variables[i], '=');
        if (str.equal(variables[i][:equals], key)) {
            free(variables[i]);
            variable_count -= 1;
            variables[i] = variables[variable_count];
            break;
        }
    }
    if (value.len > 0) {
        if (variable_count == variables.len) {
            var larger = new([]u8, variables.len * 2 + 8);
            for (var i = 0; i < variable_count; i += 1) {
                larger[i] = variables[i];
            }
            free(variables);
            variables = larger;
        }
        variables[variable_count] = names.join(key, "=", value);
        variable_count += 1;
    }
    free(key);
}

// Splits a command into its name and the rest. Commands that MiniDos knows may run into their arguments, as in
// CD.., ECHO. or DIR/W.
fn run(text: []u8) {
    if (text.len == 0) {
        return;
    }
    var end = 0;
    while (end < text.len && text[end] != ' ' && text[end] != '\t') {
        end += 1;
    }
    var word = text[:end];
    var rest = text[end:];
    for (var i = 1; i < word.len; i += 1) {
        if ((word[i] == '.' || word[i] == '\\' || word[i] == '/') && commands.find(word[:i]) != null) {
            rest = text[i:];
            word = word[:i];
            break;
        }
    }
    var d = 0;
    if (names.drive_word(word, &d) && str.trim(rest).len == 0) {
        var e = fs.change_drive(d);
        if (e != fs.Error.NONE) {
            console.fail(e);
        }
        return;
    }
    var command = commands.find(word);
    if (command == null) {
        external(word, str.trim(rest));
        return;
    }
    var a = args.parse(rest);
    if (args.has(&a, "?")) {
        commands.help(command);
    } else {
        command.run(&a);
    }
    args.release(&a);
}

// Runs a program or a batch file, found as given or with .EXE or .BAT in the current directory and in those of
// PATH. A batch file that another one runs replaces it, unless CALL runs it.
fn external(word: []u8, rest: []u8) {
    var found = locate(word);
    if (found.len == 0) {
        console.error("Bad command or file name");
        return;
    }
    if (str.ends_with(found, ".BAT")) {
        run_batch(found, rest, false);
    } else {
        var status = program.run(found, rest);
        if (status >= 0) {
            errorlevel = status;
        }
    }
    free(found);
}

fn locate(word: []u8) []u8 {
    var none: []u8;
    var directories = variable("PATH");
    var start = 0;
    var directory = "";
    for (;;) {
        var found = locate_in(directory, word);
        if (found.len > 0) {
            return found;
        }
        if (start >= directories.len || names.directory_part(word).len > 0) {
            return none;
        }
        var end = start;
        while (end < directories.len && directories[end] != ';') {
            end += 1;
        }
        directory = directories[start:end];
        start = end + 1;
    }
    return none;
}

fn locate_in(directory: []u8, word: []u8) []u8 {
    var none: []u8;
    var base = names.path_in(directory, word);
    var name = names.upper(base);
    free(base);
    var candidates = [2][]u8 { ".EXE", ".BAT" };
    if (str.find_byte(names.name_part(name), '.') >= 0) {
        if ((str.ends_with(name, ".EXE") || str.ends_with(name, ".BAT")) && is_file(name)) {
            return name;
        }
        free(name);
        return none;
    }
    for (var i = 0; i < candidates.len; i += 1) {
        var full = names.join(name, "", candidates[i]);
        if (is_file(full)) {
            free(name);
            return full;
        }
        free(full);
    }
    free(name);
    return none;
}

fn is_file(path: []u8) bool {
    var place = fs.Place {};
    return fs.find(path, &place) == fs.Error.NONE && !fs.is_directory(&place);
}

// Runs the lines of a batch file. One that runs without CALL from another batch file ends that one.
pub fn run_batch(path: []u8, rest: []u8, call: bool) {
    var b = new(Batch);
    var e = fs.read_file(path, &b.bytes);
    if (e != fs.Error.NONE) {
        console.fail(e);
        free(b);
        return;
    }
    if (!call && batch != null) {
        batch.next = batch.lines.len;
    }
    var count = 1;
    for (var i = 0; i < b.bytes.len; i += 1) {
        if (b.bytes[i] == '\n') {
            count += 1;
        }
    }
    b.lines = new([]u8, count);
    var start = 0;
    count = 0;
    for (var i = 0; i <= b.bytes.len; i += 1) {
        if (i == b.bytes.len || b.bytes[i] == '\n') {
            var line = b.bytes[start:i];
            if (line.len > 0 && line[line.len - 1] == '\r') {
                line = line[:line.len - 1];
            }
            b.lines[count] = line;
            count += 1;
            start = i + 1;
        }
    }
    b.words = names.join(path, " ", rest);
    b.parameters = parameters_of(b.words);
    var outer = batch;
    batch = b;
    while (b.next < b.lines.len && !stopping) {
        var line = b.lines[b.next];
        b.next += 1;
        var expanded = expand(line, b);
        var quiet = expanded.len > 0 && expanded[0] == '@';
        var command = expanded;
        if (quiet) {
            command = expanded[1:];
        }
        if (echo_on && !quiet && str.trim(command).len > 0 && str.trim(command)[0] != ':') {
            prompt();
            console.line(command);
        }
        execute(command);
        free(expanded);
    }
    batch = outer;
    if (outer == null) {
        echo_on = true;
    }
    free(b.words);
    free(b.parameters);
    free(b.lines);
    free(b.bytes);
    free(b);
}

// The words of a batch file's command line, quotes and all, as %0 to %9 take them
fn parameters_of(text: []u8) [][]u8 {
    var count = 0;
    var words: [][]u8;
    for (var pass = 0; pass < 2; pass += 1) {
        if (pass == 1) {
            words = new([]u8, count);
            count = 0;
        }
        var i = 0;
        while (i < text.len) {
            while (i < text.len && text[i] == ' ') {
                i += 1;
            }
            var start = i;
            while (i < text.len && text[i] != ' ') {
                i += 1;
            }
            if (i > start) {
                if (pass == 1) {
                    words[count] = text[start:i];
                }
                count += 1;
            }
        }
    }
    return words;
}

// Replaces %0 to %9 with the parameters of a batch file and %NAME% with variables
fn expand(text: []u8, b: *Batch) []u8 {
    var out = str.builder(text.len + 16);
    var i = 0;
    while (i < text.len) {
        var c = text[i];
        if (c == '%' && i + 1 < text.len && str.is_digit(text[i + 1])) {
            var n = (text[i + 1] - '0') as int + b.shift;
            if (n < b.parameters.len) {
                str.append(&out, b.parameters[n]);
            }
            i += 2;
        } else if (c == '%' && i + 1 < text.len && text[i + 1] == '%') {
            str.append_byte(&out, '%');
            i += 2;
        } else if (c == '%' && str.find_byte(text[i + 1:], '%') > 0) {
            var end = i + 1 + str.find_byte(text[i + 1:], '%');
            str.append(&out, variable(text[i + 1:end]));
            i = end + 1;
        } else {
            str.append_byte(&out, c);
            i += 1;
        }
    }
    var result = str.clone(str.text(&out));
    str.release(&out);
    return result;
}

// CALL runs a batch file and comes back to the one that called it
pub fn call(a: *args.Args) {
    var line = str.trim(a.text);
    var end = 0;
    while (end < line.len && line[end] != ' ') {
        end += 1;
    }
    if (end == 0) {
        return;
    }
    var found = locate(line[:end]);
    if (found.len == 0) {
        console.error("Bad command or file name");
        return;
    }
    if (str.ends_with(found, ".BAT")) {
        run_batch(found, str.trim(line[end:]), true);
    } else {
        var status = program.run(found, str.trim(line[end:]));
        if (status >= 0) {
            errorlevel = status;
        }
    }
    free(found);
}

pub fn go_to(a: *args.Args) {
    if (batch == null) {
        return;
    }
    var target = str.trim(a.text);
    if (target.len > 0 && target[0] == ':') {
        target = target[1:];
    }
    target = first_word(target);
    for (var i = 0; i < batch.lines.len; i += 1) {
        var line = str.trim(batch.lines[i]);
        if (line.len > 1 && line[0] == ':' && names.same(first_word(line[1:]), target)) {
            batch.next = i + 1;
            return;
        }
    }
    console.error("Label not found");
    batch.next = batch.lines.len;
}

pub fn shift(a: *args.Args) {
    if (batch != null) {
        batch.shift += 1;
    }
}

// IF [NOT] EXIST file command, IF [NOT] ERRORLEVEL n command, IF [NOT] one==two command
pub fn condition(a: *args.Args) {
    var rest = str.trim(a.text);
    var negate = false;
    var word = first_word(rest);
    if (names.same(word, "NOT")) {
        negate = true;
        rest = str.trim(rest[word.len:]);
        word = first_word(rest);
    }
    var holds = false;
    if (names.same(word, "EXIST")) {
        rest = str.trim(rest[word.len:]);
        var name = first_word(rest);
        rest = rest[name.len:];
        holds = exists(name);
    } else if (names.same(word, "ERRORLEVEL")) {
        rest = str.trim(rest[word.len:]);
        var number = first_word(rest);
        rest = rest[number.len:];
        var n = str.parse_int(number);
        if (!n.ok) {
            console.error("Syntax error");
            return;
        }
        holds = errorlevel >= n.value;
    } else {
        var equals = str.find(rest, "==");
        if (equals < 0) {
            console.error("Syntax error");
            return;
        }
        var left = str.trim(rest[:equals]);
        var after = str.trim(rest[equals + 2:]);
        var right = first_word(after);
        rest = after[right.len:];
        holds = str.equal(left, right);
    }
    if (holds != negate) {
        execute(rest);
    }
}

// Whether a file or directory exists, or with wildcards any file that matches
fn exists(name: []u8) bool {
    if (!fs.has_wildcards(name)) {
        var place = fs.Place {};
        return fs.find(name, &place) == fs.Error.NONE;
    }
    var selection = fs.Selection {};
    var entries: []fs.Entry;
    if (fs.select(name, false, &selection) != fs.Error.NONE ||
        fs.list(&selection, false, &entries) != fs.Error.NONE) {
        return false;
    }
    var found = entries.len > 0;
    free(entries);
    return found;
}

// FOR %V IN (set) DO command runs the command for each word of the set, and for each file that a word with
// wildcards matches, with %V standing for it. A batch file writes %%V.
pub fn for_each(a: *args.Args) {
    var line = str.trim(a.text);
    if (line.len < 3 || line[0] != '%' || line[1] == ' ') {
        console.error("Syntax error");
        return;
    }
    var name = line[:2];
    var rest = str.trim(line[2:]);
    if (!names.starts_with_word(rest, "IN")) {
        console.error("Syntax error");
        return;
    }
    rest = str.trim(rest[2:]);
    var close = str.find_byte(rest, ')');
    if (rest.len == 0 || rest[0] != '(' || close < 0) {
        console.error("Syntax error");
        return;
    }
    var set = rest[1:close];
    rest = str.trim(rest[close + 1:]);
    if (!names.starts_with_word(rest, "DO") || str.trim(rest[2:]).len == 0) {
        console.error("Syntax error");
        return;
    }
    var command = str.trim(rest[2:]);
    var i = 0;
    while (i < set.len && !stopping) {
        while (i < set.len && (set[i] == ' ' || set[i] == ',' || set[i] == ';')) {
            i += 1;
        }
        var start = i;
        while (i < set.len && set[i] != ' ' && set[i] != ',' && set[i] != ';') {
            i += 1;
        }
        var item = set[start:i];
        if (item.len == 0) {
            continue;
        }
        if (!fs.has_wildcards(item)) {
            run_for(command, name, item);
            continue;
        }
        var selection = fs.Selection {};
        var entries: []fs.Entry;
        if (fs.select(item, false, &selection) != fs.Error.NONE ||
            fs.list(&selection, false, &entries) != fs.Error.NONE) {
            continue;
        }
        for (var k = 0; k < entries.len && !stopping; k += 1) {
            if ((entries[k].attributes & fs.DIRECTORY) == 0) {
                var buffer: [12]u8;
                var path = names.join(names.directory_part(item), "", fs.name_text(entries[k].name, buffer));
                run_for(command, name, path);
                free(path);
            }
        }
        free(entries);
    }
}

fn run_for(command: []u8, name: []u8, item: []u8) {
    var out = str.builder(command.len + 16);
    var i = 0;
    while (i < command.len) {
        if (str.starts_with(command[i:], name)) {
            str.append(&out, item);
            i += name.len;
        } else {
            str.append_byte(&out, command[i]);
            i += 1;
        }
    }
    var line = str.clone(str.text(&out));
    str.release(&out);
    execute(line);
    free(line);
}

pub fn echo(a: *args.Args) {
    var line = a.text;
    if (line.len > 0 && (line[0] == ' ' || line[0] == '\t')) {
        line = line[1:];
    }
    var trimmed = str.trim(line);
    if (names.same(trimmed, "ON")) {
        echo_on = true;
    } else if (names.same(trimmed, "OFF")) {
        echo_on = false;
    } else if (line.len > 0 && (line[0] == '.' || line[0] == '/' || line[0] == ':')) {
        console.line(line[1:]);
    } else if (trimmed.len == 0) {
        if (echo_on) {
            console.line("ECHO is on");
        } else {
            console.line("ECHO is off");
        }
    } else {
        console.line(line);
    }
}

pub fn remark(a: *args.Args) {
}

pub fn exit(a: *args.Args) {
    stopping = true;
}

pub fn pause(a: *args.Args) {
    var buffer: [80]u8;
    console.ask("Press Enter to continue . . .", buffer);
}

// CHOICE [/C:keys] [/N] [/S] [text] asks until one of the keys is typed, and sets ERRORLEVEL to its place
pub fn choice(a: *args.Args) {
    var keys = args.value(a, "C");
    if (keys.len == 0) {
        keys = "YN";
    }
    var case_matters = args.has(a, "S");
    var question = str.builder(64);
    for (var i = 0; i < a.words.len; i += 1) {
        if (i > 0) {
            str.append_byte(&question, ' ');
        }
        str.append(&question, a.words[i]);
    }
    if (!args.has(a, "N")) {
        if (a.words.len > 0) {
            str.append_byte(&question, ' ');
        }
        str.append_byte(&question, '[');
        for (var i = 0; i < keys.len; i += 1) {
            if (i > 0) {
                str.append_byte(&question, ',');
            }
            str.append_byte(&question, keys[i]);
        }
        str.append(&question, "]?");
    }
    var buffer: [80]u8;
    errorlevel = 0;
    for (;;) {
        console.screen(str.text(&question));
        var line: []u8;
        if (!console.read_line(buffer, &line)) {
            console.screen("\n");
            break;
        }
        var answer = str.trim(line);
        if (answer.len == 1) {
            for (var i = 0; i < keys.len && errorlevel == 0; i += 1) {
                if (answer[0] == keys[i] || !case_matters && names.upper_byte(answer[0]) == names.upper_byte(keys[i])) {
                    errorlevel = i + 1;
                }
            }
        }
        if (errorlevel > 0) {
            break;
        }
    }
    str.release(&question);
}

pub fn set(a: *args.Args) {
    var line = str.trim(a.text);
    var equals = str.find_byte(line, '=');
    if (equals < 0) {
        var prefix = names.upper(line);
        for (var i = 0; i < variable_count; i += 1) {
            if (str.starts_with(variables[i], prefix)) {
                console.line(variables[i]);
            }
        }
        free(prefix);
        return;
    }
    set_variable(line[:equals], line[equals + 1:]);
}

pub fn path(a: *args.Args) {
    var line = str.trim(a.text);
    if (line.len == 0) {
        var value = variable("PATH");
        if (value.len == 0) {
            console.line("No Path");
        } else {
            console.write("PATH=");
            console.line(value);
        }
        return;
    }
    if (str.equal(line, ";")) {
        set_variable("PATH", "");
        return;
    }
    var value = names.upper(line);
    set_variable("PATH", value);
    free(value);
}

pub fn prompt_command(a: *args.Args) {
    set_variable("PROMPT", str.trim(a.text));
}
