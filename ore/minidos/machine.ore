// What MiniDos needs of the machine beyond std/cpu, in machine.asm
import "std/cpu";

// The word at any address, 0 included, which a pointer cannot reach
pub extern fn peek(address: u32) u32;

// Copies the memory size, the free heap and its largest block into R0, R6 and R7 of a frame, as the
// VM's syscall 23 would
pub extern fn memory_info(frame: *cpu.Frame);

// How many bytes the heap has free
pub extern fn free_heap() int;
