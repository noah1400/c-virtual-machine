// What MiniDos shows and reads: the VM's console and keyboard, or files that output and input are redirected
// to. Lines come from the keyboard through an editor, which shows what is typed, moves through the line with
// the arrow keys, Home and End, recalls earlier commands with Up and Down and completes file names with Tab.
import "std/cpu";
import "std/io";
import "std/str";
import "std/sys";
import "fs";
import "names";

const KEY_STATUS = 0x60;
const KEY_DATA = 0x61;
const KEY_WAITING: u32 = 1;
const INPUT_ENDED: u32 = 2;

pub const BACKSPACE = 0x08;
pub const TAB = 0x09;
pub const CTRL_Z = 0x1A;
pub const ESCAPE = 0x1B;
pub const RUBOUT = 0x7F;
pub const UP = 0x100;
pub const DOWN = 0x101;
pub const RIGHT = 0x102;
pub const LEFT = 0x103;
pub const HOME = 0x104;
pub const END = 0x105;
pub const INSERT = 0x106;
pub const DELETE = 0x107;
pub const PAGE_UP = 0x108;
pub const PAGE_DOWN = 0x109;

const HISTORY = 32;
const LINE = 256;

var output: *fs.File = null;
var input: *fs.File = null;

var history: [HISTORY][]u8;     // the commands typed last, the oldest first
var history_count = 0;

// A line typed for a program that it has not read all of, with its line end, and whether Ctrl-Z ended the
// input after it
var typed: [LINE + 1]u8;
var typed_start = 0;
var typed_end = 0;
var typed_end_of_input = false;

// Sends what follows to a file, or back to the screen for null, and returns where it went before
pub fn redirect_output(file: *fs.File) *fs.File {
    var before = output;
    output = file;
    return before;
}

pub fn redirect_input(file: *fs.File) *fs.File {
    var before = input;
    input = file;
    return before;
}

pub fn output_redirected() bool {
    return output != null;
}

pub fn write(text: []u8) {
    if (output != null) {
        fs.write(output, text);
    } else {
        io.write(io.STDOUT, text);
    }
}

// Writes to the screen even while output goes to a file, as error messages do
pub fn screen(text: []u8) {
    io.write(io.STDOUT, text);
}

// Shows a message on a line of its own on the screen
pub fn error(text: []u8) {
    screen(text);
    screen("\n");
}

pub fn fail(e: fs.Error) {
    error(fs.message(e));
}

pub fn write_byte(c: u8) {
    var bytes = [1]u8 { c };
    write(bytes);
}

pub fn write_int(value: int) {
    var buffer: [11]u8;
    write(str.format_int(value, buffer));
}

pub fn line(text: []u8) {
    write(text);
    write("\n");
}

// Writes text and pads it with spaces to width
pub fn column(text: []u8, width: int) {
    write(text);
    for (var i = text.len; i < width; i += 1) {
        write(" ");
    }
}

// Writes a number right-aligned in width, with commas between thousands
pub fn number(value: int, width: int) {
    var digits: [11]u8;
    var plain = str.format_int(value, digits);
    var buffer: [16]u8;
    var length = 0;
    for (var i = 0; i < plain.len; i += 1) {
        if (i > 0 && (plain.len - i) % 3 == 0 && plain[i - 1] != '-') {
            buffer[length] = ',';
            length += 1;
        }
        buffer[length] = plain[i];
        length += 1;
    }
    for (var i = length; i < width; i += 1) {
        write(" ");
    }
    write(buffer[:length]);
}

pub fn clear() {
    write("\x1b[2J\x1b[H");
}

// The keyboard

pub fn key_waiting() bool {
    return (cpu.read_port(KEY_STATUS) & KEY_WAITING) != 0;
}

// The next key, after waiting for one, or -1 when the input has ended
pub fn key() int {
    for (;;) {
        var status = cpu.read_port(KEY_STATUS);
        if ((status & KEY_WAITING) != 0) {
            return cpu.read_port(KEY_DATA) as int;
        }
        if ((status & INPUT_ENDED) != 0) {
            return -1;
        }
        sys.sleep(10);
    }
    return -1;
}

fn backward(count: int) {
    for (var i = 0; i < count; i += 1) {
        screen("\x08");
    }
}

fn spaces(count: int) {
    for (var i = 0; i < count; i += 1) {
        screen(" ");
    }
}

// A line being typed: its bytes, how many there are and where the cursor stands among them
struct Editor {
    buffer: []u8;
    length: int;
    cursor: int;
    names: [][]u8;          // what Tab offers for the word at word_start, and the one it showed last
    shown: int;
    word_start: int;
}

// Puts text in place of the line's bytes from start to the cursor, and leaves the cursor after it
fn replace(e: *Editor, start: int, text: []u8) {
    var rest = e.buffer[e.cursor:e.length];
    var count = text.len;
    if (start + count + rest.len > e.buffer.len - 1) {
        count = e.buffer.len - 1 - start - rest.len;
    }
    var old_length = e.length;
    backward(e.cursor - start);
    var tail = new(u8, rest.len);
    for (var i = 0; i < rest.len; i += 1) {
        tail[i] = rest[i];
    }
    for (var i = 0; i < count; i += 1) {
        e.buffer[start + i] = text[i];
    }
    for (var i = 0; i < tail.len; i += 1) {
        e.buffer[start + count + i] = tail[i];
    }
    free(tail);
    e.length = start + count + rest.len;
    e.cursor = start + count;
    screen(e.buffer[start:e.length]);
    var gone = old_length - e.length;
    if (gone > 0) {
        spaces(gone);
        backward(gone);
    }
    backward(e.length - e.cursor);
}

fn set_line(e: *Editor, text: []u8) {
    var end = e.length;
    while (e.cursor < end) {
        screen(e.buffer[e.cursor:e.cursor + 1]);
        e.cursor += 1;
    }
    replace(e, 0, text);
}

fn forget_names(e: *Editor) {
    for (var i = 0; i < e.names.len; i += 1) {
        free(e.names[i]);
    }
    free(e.names);
    var none: [][]u8;
    e.names = none;
}

// Tab puts the first file or directory whose name starts with the word before the cursor in its place, and
// the next one with every further Tab
fn complete(e: *Editor) {
    if (e.names.len == 0) {
        var start = e.cursor;
        while (start > 0 && e.buffer[start - 1] != ' ') {
            start -= 1;
        }
        var word = e.buffer[start:e.cursor];
        var pattern = names.join(word, "*", ".*");
        if (str.find_byte(names.name_part(word), '.') >= 0) {
            free(pattern);
            pattern = names.join(word, "*", "");
        }
        var selection = fs.Selection {};
        var entries: []fs.Entry;
        if (fs.select(pattern, false, &selection) == fs.Error.NONE &&
            fs.list(&selection, false, &entries) == fs.Error.NONE) {
            var count = 0;
            for (var i = 0; i < entries.len; i += 1) {
                if (entries[i].name[0] != '.') {
                    count += 1;
                }
            }
            e.names = new([]u8, count);
            count = 0;
            for (var i = 0; i < entries.len; i += 1) {
                if (entries[i].name[0] != '.') {
                    var buffer: [12]u8;
                    e.names[count] = names.join(names.directory_part(word), "", fs.name_text(entries[i].name, buffer));
                    count += 1;
                }
            }
            free(entries);
        }
        free(pattern);
        e.word_start = start;
        e.shown = -1;
    }
    if (e.names.len > 0) {
        e.shown = (e.shown + 1) % e.names.len;
        replace(e, e.word_start, e.names[e.shown]);
    }
}

fn remember(text: []u8) {
    if (text.len == 0 || history_count > 0 && str.equal(history[history_count - 1], text)) {
        return;
    }
    if (history_count == HISTORY) {
        free(history[0]);
        for (var i = 1; i < HISTORY; i += 1) {
            history[i - 1] = history[i];
        }
        history_count -= 1;
    }
    history[history_count] = str.clone(text);
    history_count += 1;
}

// Reads a line from the keyboard into buffer, showing what is typed. Commands have a history and complete
// file names. Ctrl-Z ends the line's text, keeps its byte at the end and shows as ^Z until Enter; false when the
// input has ended.
fn edit(buffer: []u8, text: *[]u8, command: bool) bool {
    var e = Editor { buffer: buffer };
    var recalled = history_count;
    var ended = false;
    for (;;) {
        var k = key();
        if (k < 0) {
            if (e.length == 0) {
                forget_names(&e);
                return false;
            }
            k = '\n';
        }
        if (k != TAB) {
            forget_names(&e);
        }
        if (k == '\n' || k == '\r') {
            screen("\n");
            break;
        } else if (ended) {
            continue;
        } else if (k == CTRL_Z && !command) {
            screen(buffer[e.cursor:e.length]);
            e.cursor = e.length;
            if (e.length < buffer.len - 1) {
                buffer[e.length] = CTRL_Z;
                e.length += 1;
            }
            screen("^Z");
            ended = true;
        } else if (k >= ' ' && k < RUBOUT || k >= 0x80 && k <= 0xFF) {
            if (e.length < buffer.len - 1) {
                var c = [1]u8 { k as u8 };
                replace(&e, e.cursor, c[:]);
            }
        } else if ((k == BACKSPACE || k == RUBOUT) && e.cursor > 0) {
            replace(&e, e.cursor - 1, "");
        } else if (k == DELETE && e.cursor < e.length) {
            screen(buffer[e.cursor:e.cursor + 1]);
            e.cursor += 1;
            replace(&e, e.cursor - 1, "");
        } else if (k == LEFT && e.cursor > 0) {
            backward(1);
            e.cursor -= 1;
        } else if (k == RIGHT && e.cursor < e.length) {
            screen(buffer[e.cursor:e.cursor + 1]);
            e.cursor += 1;
        } else if (k == HOME) {
            backward(e.cursor);
            e.cursor = 0;
        } else if (k == END) {
            screen(buffer[e.cursor:e.length]);
            e.cursor = e.length;
        } else if (k == ESCAPE) {
            set_line(&e, "");
        } else if (k == UP && command && recalled > 0) {
            recalled -= 1;
            set_line(&e, history[recalled]);
        } else if (k == DOWN && command && recalled < history_count) {
            recalled += 1;
            if (recalled == history_count) {
                set_line(&e, "");
            } else {
                set_line(&e, history[recalled]);
            }
        } else if (k == TAB && command) {
            complete(&e);
        }
    }
    forget_names(&e);
    *text = buffer[:e.length];
    if (command) {
        remember(*text);
    }
    return true;
}

// Reads a command at the prompt, with the history and completion of file names
pub fn read_command(buffer: []u8, text: *[]u8) bool {
    return edit(buffer, text, true);
}

// Shows a question and waits for a line typed at the keyboard, even while input comes from a file; false when
// the keyboard's input has ended
pub fn keyboard(question: []u8) bool {
    var buffer: [80]u8;
    screen(question);
    var text: []u8;
    return edit(buffer, &text, false);
}

// Reads a line without its end into buffer and makes *text the part it fills; false at the end of the input. A
// line typed with Ctrl-Z keeps that byte.
pub fn read_line(buffer: []u8, text: *[]u8) bool {
    if (input == null) {
        return edit(buffer, text, false);
    }
    return file_line(buffer, text);
}

// Reads a line as read_line does for a program, for which Ctrl-Z ends the input
pub fn program_line(buffer: []u8, text: *[]u8) bool {
    if (input != null) {
        return file_line(buffer, text);
    }
    if (!type_line()) {
        return false;
    }
    var length = 0;
    while (typed_start < typed_end && typed[typed_start] != '\n') {
        if (length < buffer.len - 1) {
            buffer[length] = typed[typed_start];
            length += 1;
        }
        typed_start += 1;
    }
    if (typed_start < typed_end) {
        typed_start += 1;
    }
    *text = buffer[:length];
    return true;
}

fn file_line(buffer: []u8, text: *[]u8) bool {
    var length = 0;
    var c: [1]u8;
    for (;;) {
        if (fs.read(input, c) != 1) {
            if (length == 0) {
                return false;
            }
            break;
        }
        if (c[0] == '\n') {
            break;
        }
        if (c[0] != '\r' && length < buffer.len - 1) {
            buffer[length] = c[0];
            length += 1;
        }
    }
    *text = buffer[:length];
    return true;
}

// Makes sure that a line typed for a program waits in typed, and tells whether one does
fn type_line() bool {
    if (typed_start < typed_end) {
        return true;
    }
    if (typed_end_of_input) {
        typed_end_of_input = false;
        return false;
    }
    var text: []u8;
    if (!edit(typed[:LINE], &text, false)) {
        return false;
    }
    typed_start = 0;
    typed_end = text.len;
    var stop = str.find_byte(text, CTRL_Z);
    if (stop >= 0) {
        typed_end = stop;
        typed_end_of_input = true;
    } else {
        typed[typed_end] = '\n';
        typed_end += 1;
    }
    return typed_start < typed_end || type_line();
}

// Forgets what a program left of a line typed for it
pub fn forget_typed() {
    typed_start = 0;
    typed_end = 0;
    typed_end_of_input = false;
}

// The next byte of input, or -1 at its end
pub fn read_char() int {
    if (input == null) {
        if (!type_line()) {
            return -1;
        }
        typed_start += 1;
        return typed[typed_start - 1] as int;
    }
    var c: [1]u8;
    if (fs.read(input, c) != 1) {
        return -1;
    }
    return c[0] as int;
}

// Reads up to buffer.len bytes of input and returns how many, 0 at its end or -1
pub fn read(buffer: []u8) int {
    if (input == null) {
        if (!type_line()) {
            return 0;
        }
        var count = 0;
        while (count < buffer.len && typed_start < typed_end) {
            buffer[count] = typed[typed_start];
            count += 1;
            typed_start += 1;
        }
        return count;
    }
    return fs.read(input, buffer);
}

// Shows a question and reads a line of answer into buffer, trimmed, or nothing when the input ends
pub fn ask(question: []u8, buffer: []u8) []u8 {
    screen(question);
    var text: []u8;
    if (!read_line(buffer, &text)) {
        screen("\n");
        return "";
    }
    return str.trim(text);
}

// Asks a question until the answer is Y or N, and tells whether it was Y; the end of the input says N
pub fn confirm(question: []u8) bool {
    var buffer: [80]u8;
    for (;;) {
        screen(question);
        var text: []u8;
        if (!read_line(buffer, &text)) {
            screen("\n");
            return false;
        }
        var answer = str.trim(text);
        if (answer.len == 1 && (answer[0] == 'Y' || answer[0] == 'y')) {
            return true;
        }
        if (answer.len == 1 && (answer[0] == 'N' || answer[0] == 'n')) {
            return false;
        }
    }
    return false;
}
