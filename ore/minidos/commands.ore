    Command { name: "GOTO", run: shell.go_to, help: [][]u8 {
        "Continues a batch file after the line :label",
        "GOTO label",
    } },
    Command { name: "HELP", run: help_command, help: [][]u8 {
        "Lists the commands, or tells about one",
        "HELP [command]",
    } },
    Command { name: "IF", run: shell.condition, help: [][]u8 {
        "Runs a command when a condition holds",
        "IF [NOT] EXIST file command",
        "IF [NOT] ERRORLEVEL number command",
        "IF [NOT] text==text command",
        "  ERRORLEVEL n holds when the last program ended with status n or more",
    } },
    Command { name: "IMPORT", run: system.import_file, help: [][]u8 {
        "Copies a file from the host, from the directory that vm runs in",
        "IMPORT host-file [file]",
        "  The copy keeps the name of the host's file unless file gives another",
    } },
    Command { name: "LABEL", run: disks.label, help: [][]u8 {
        "Shows, changes or removes the label of a disk",
        "LABEL [drive:][label]",
    } },
    Command { name: "MD", alias: "MKDIR", run: files.make_directory, help: [][]u8 {
        "Makes a directory",
        "MD [drive:]path",
    } },
    Command { name: "MEM", run: system.memory, help: [][]u8 {
        "Shows how memory is used",
        "MEM",
    } },
    Command { name: "MORE", run: files.more, help: [][]u8 {
        "Shows a file or its input a screenful at a time",
        "MORE [file]",
        "command | MORE",
    } },
    Command { name: "MOVE", run: files.move, help: [][]u8 {
        "Moves files to another directory or drive, or renames a directory",
        "MOVE [/Y | /-Y] files destination",
        "  /Y     Replaces existing files without asking, as batch files always do",
    } },
    Command { name: "PATH", run: shell.path, help: [][]u8 {
        "Shows or sets the directories where programs are looked for",
        "PATH [[drive:]path[;...]]",
        "  PATH ; clears the list",
    } },
    Command { name: "PAUSE", run: shell.pause, help: [][]u8 {
        "Waits for Enter",
        "PAUSE",
    } },
    Command { name: "PROMPT", run: shell.prompt_command, help: [][]u8 {
        "Changes the prompt",
        "PROMPT [text]",
        "  $P drive and directory   $N drive   $G >   $L <   $B |   $Q =   $$ $   $_ new line",
        "  $V version   $E escape   $H backspace. PROMPT alone brings back $P$G.",
    } },
    Command { name: "RD", alias: "RMDIR", run: files.remove_directory, help: [][]u8 {
        "Removes an empty directory",
        "RD [drive:]path",
    } },
    Command { name: "REM", run: shell.remark, help: [][]u8 {
        "Does nothing, for remarks in batch files",
        "REM [text]",
    } },
    Command { name: "REN", alias: "RENAME", run: files.rename, help: [][]u8 {
        "Renames files or a directory",
        "REN [drive:][path]files name",
        "  Wildcards in the new name keep the letters of the old one, as in REN *.TXT *.BAK",
    } },
    Command { name: "SET", run: shell.set, help: [][]u8 {
        "Shows, sets or removes environment variables",
        "SET [name=[value]]",
    } },
    Command { name: "SHIFT", run: shell.shift, help: [][]u8 {
        "Moves the parameters of a batch file down by one",
        "SHIFT",
    } },
    Command { name: "SYS", run: system.transfer, help: [][]u8 {
        "Puts the system programs onto a disk",
        "SYS drive:",
        "  The programs go into \\DOS, and an AUTOEXEC.BAT that adds \\DOS to PATH into the root",
        "  directory unless it has one",
    } },
    Command { name: "TREE", run: files.tree, help: [][]u8 {
        "Draws the directories of a disk as a tree",
        "TREE [drive:][path] [/F]",
        "  /F     Lists the files in each directory too",
    } },
    Command { name: "TYPE", run: files.type, help: [][]u8 {
        "Shows the contents of files",
        "TYPE file ...",
    } },
    Command { name: "VER", run: system.version, help: [][]u8 {
        "Shows the MiniDos version",
        "VER",
    } },
    Command { name: "VOL", run: disks.volume, help: [][]u8 {
        "Shows the label of a disk",
        "VOL [drive:]",
    } },
    Command { name: "XCOPY", run: files.xcopy, help: [][]u8 {
        "Copies files and directory trees",
        "XCOPY source [destination] [/S] [/E] [/Y | /-Y]",
        "  /S     Copies the subdirectories that hold files as well",
        "  /E     Copies empty subdirectories too, with /S",
        "  /Y     Replaces existing files without asking, as batch files always do",
    } },
};

// The command of that name or alias, in any case, or null
pub fn find(name: []u8) *Command {
    for (var i = 0; i < table.len; i += 1) {
        if (names.same(name, table[i].name) || table[i].alias.len > 0 && names.same(name, table[i].alias)) {
            return &table[i];
        }
    }
    return null;
}

pub fn help(command: *Command) {
    for (var i = 0; i < command.help.len; i += 1) {
        console.line(command.help[i]);
        if (i == 0) {
            console.write("\n");
        }
    }
}

fn help_command(a: *args.Args) {
    if (a.words.len > 0) {
        var command = find(a.words[0]);
        if (command == null) {
            console.error("There is no such command; programs tell about themselves");
            return;
        }
        help(command);
        return;
    }
    for (var i = 0; i < table.len; i += 1) {
        var width = table[i].name.len;
        console.write(table[i].name);
        if (table[i].alias.len > 0) {
            console.write(", ");
            console.write(table[i].alias);
            width += 2 + table[i].alias.len;
        }
        console.column("", 14 - width);
        console.line(table[i].help[0]);
    }
    console.line("Other names run NAME.EXE or NAME.BAT. Commands take > file, >> file, < file and |.");
    console.line("HELP command or command /? tells more about a command.");
}
