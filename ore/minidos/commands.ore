// The commands that MiniDos knows, with what HELP and /? say about them
import "args";
import "console";
import "disks";
import "files";
import "names";
import "shell";
import "system";

pub struct Command {
    name: []u8;
    alias: []u8;
    run: fn(*args.Args);
    help: [][]u8;           // what it does in a line, then how to use it
}

var table = []Command {
    Command { name: "ATTRIB", run: files.attrib, help: [][]u8 {
        "Shows or changes the attributes of files",
        "ATTRIB [+R | -R] [+H | -H] [+S | -S] [+A | -A] [files] [/S]",
        "  +, -   Sets or clears an attribute: R read-only, H hidden, S system, A archive",
        "  /S     Works on the files of the subdirectories as well",
    } },
    Command { name: "CALL", run: shell.call, help: [][]u8 {
        "Runs a batch file from another one and comes back",
        "CALL name [parameters]",
    } },
    Command { name: "CD", alias: "CHDIR", run: files.change_directory, help: [][]u8 {
        "Shows or changes the current directory",
        "CD [drive:][path]",
        "  CD .. goes to the parent directory and CD \\ to the root; CD drive: shows its current directory",
    } },
    Command { name: "CHKDSK", run: disks.check, help: [][]u8 {
        "Checks the file system of a disk and shows how it is used",
        "CHKDSK [drive:] [/F]",
        "  /F     Fixes what it finds: frees lost clusters and corrects file sizes",
    } },
    Command { name: "CHOICE", run: shell.choice, help: [][]u8 {
        "Waits for one of a set of keys and sets ERRORLEVEL to its place",
        "CHOICE [/C:keys] [/N] [/S] [text]",
        "  /C:keys  The keys to choose from, YN unless given",
        "  /N       Leaves the keys out of the question",
        "  /S       Tells capitals from small letters",
    } },
    Command { name: "CLS", run: system.clear, help: [][]u8 {
        "Clears the screen",
        "CLS",
    } },
    Command { name: "COPY", run: files.copy, help: [][]u8 {
        "Copies files, or joins them into one",
        "COPY [/Y | /-Y] source [+ source ...] [destination]",
        "  source       Files to copy, which wildcards may name; CON for the lines typed next, up to Ctrl-Z",
        "  destination  A directory, a drive or a file name, the current directory unless given",
        "  /Y           Replaces existing files without asking, as batch files always do",
        "  /-Y          Asks before replacing a file",
    } },
    Command { name: "DEL", alias: "ERASE", run: files.delete, help: [][]u8 {
        "Deletes files",
        "DEL files [/P]",
        "  files  Files to delete, which wildcards may name; a directory stands for all its files",
        "  /P     Asks before deleting each file",
    } },
    Command { name: "DELTREE", run: files.delete_tree, help: [][]u8 {
        "Deletes a directory with all its files and subdirectories",
        "DELTREE [/Y] directory ...",
        "  /Y     Deletes without asking",
    } },
    Command { name: "DIR", run: files.dir, help: [][]u8 {
        "Lists files and subdirectories",
        "DIR [drive:][path][files] [/P] [/W] [/A[:attributes]] [/O[:order]] [/S] [/B]",
        "  /P     Waits after each screenful",
        "  /W     Shows only names, five to a line",
        "  /A     Shows hidden files too, or only those with the attributes D, H, R, S or A; - in front",
        "         of one leaves those out",
        "  /O     Sorts by N name, E extension, S size, D date or G directories first; - in front reverses",
        "  /S     Lists the files in the subdirectories as well",
        "  /B     Shows only the names",
    } },
    Command { name: "DISKCOPY", run: disks.copy_disk, help: [][]u8 {
        "Copies a whole disk onto another one, which takes its size",
        "DISKCOPY drive: drive:",
    } },
    Command { name: "ECHO", run: shell.echo, help: [][]u8 {
        "Shows text, or whether batch files show their commands",
        "ECHO [ON | OFF | text]",
        "  ECHO. shows an empty line",
    } },
    Command { name: "EXIT", run: shell.exit, help: [][]u8 {
        "Stops MiniDos and the VM",
        "EXIT",
    } },
    Command { name: "EXPORT", run: system.export_file, help: [][]u8 {
        "Copies a file to the host, into the directory that vm runs in",
        "EXPORT file host-file",
    } },
    Command { name: "FOR", run: shell.for_each, help: [][]u8 {
        "Runs a command for each of a set of words and files",
        "FOR %variable IN (set) DO command",
        "  The command runs with %variable standing for each word of the set, and for each file that a",
        "  word with wildcards names. Batch files write %%variable.",
    } },
    Command { name: "FORMAT", run: disks.format, help: [][]u8 {
        "Makes an empty file system on a disk",
        "FORMAT drive: [/V:label] [/F:size] [/S]",
        "  /V:label  The label of the disk, which FORMAT asks for unless given",
        "  /F:size   The size of the disk in K, or in M with an M after it: 8K to 32M. A new disk",
        "            gets 4M unless given, any other keeps its size",
        "  /S        Puts the system programs onto the disk, as SYS does",
