// f32 constants: their bits, decimal numbers and 64-bit integers rounded to the nearest f32
import "wide";

pub const INFINITY: u32 = 0x7F800000;

pub fn value(bits: u32) f32 {
    var copy = bits;
    return *(&copy as *f32);
}

pub fn bits(f: f32) u32 {
    var copy = f;
    return *(&copy as *u32);
}

// The nearest f32 to a 64-bit integer. ITOF rounds integers of 31 bits; a larger one is shifted down to 31
// bits, keeping in its lowest bit whether any bit shifted out was set, which makes it round the same way.
pub fn of_wide(n: wide.Wide) u32 {
    if (wide.fits(n)) {
        return bits(wide.low(n) as f32);
    }
    var magnitude = n;
    if (n.hi < 0) {
        magnitude = wide.negate(n);
    }
    var scale: f32 = 1;
    while (magnitude.hi != 0 || magnitude.lo >= 0x80000000) {
        var lost = magnitude.lo & 1;
        magnitude = wide.shr(magnitude, 1);
        magnitude.lo |= lost;
        scale *= 2;
    }
    var result = (magnitude.lo as int) as f32 * scale;
    if (n.hi < 0) {
        result = -result;
    }
    return bits(result);
}

// Numbers of up to LIMBS 16-bit limbs, lowest first, which hold every value a literal needs
const LIMBS = 48;

struct Big {
    limbs: [LIMBS]u32;
}

// a = a * factor + add, for factors up to 10000
fn multiply(a: *Big, factor: u32, add: u32) {
    var carry = add;
    for (var i = 0; i < LIMBS; i += 1) {
        var x = a.limbs[i] * factor + carry;
        a.limbs[i] = x & 0xFFFF;
        carry = x >> 16;
    }
}

fn shifted(a: *Big, count: int, out: *Big) {
    var words = count / 16;
    var rest = count % 16;
    for (var i = LIMBS - 1; i >= 0; i -= 1) {
        var x: u32 = 0;
        if (i >= words) {
            x = a.limbs[i - words] << rest;
            if (rest > 0 && i > words) {
                x |= a.limbs[i - words - 1] >> 16 - rest;
            }
        }
        out.limbs[i] = x & 0xFFFF;
    }
}

fn compare(a: *Big, b: *Big) int {
    for (var i = LIMBS - 1; i >= 0; i -= 1) {
        if (a.limbs[i] != b.limbs[i]) {
            if (a.limbs[i] < b.limbs[i]) {
                return -1;
            }
            return 1;
        }
    }
    return 0;
}

// a -= b, which is at most a
fn subtract(a: *Big, b: *Big) {
    var borrow: u32 = 0;
    for (var i = 0; i < LIMBS; i += 1) {
        var x = a.limbs[i] - b.limbs[i] - borrow;
        a.limbs[i] = x & 0xFFFF;
        borrow = x >> 16 & 1;
    }
}

fn bit_length(a: *Big) int {
    for (var i = LIMBS - 1; i >= 0; i -= 1) {
        if (a.limbs[i] != 0) {
            var length = 16;
            while (a.limbs[i] >> length - 1 == 0) {
                length -= 1;
            }
            return i * 16 + length;
        }
    }
    return 0;
}

// Digits a decimal number keeps. The halfway points between f32s have at most 114 significant digits, so
// once a number has more, a 1 after the digits kept stands for the rest without changing how it rounds.
const KEPT = 120;

// The bits of the f32 nearest to a float literal, rounding halfway cases to even; INFINITY for one too large
pub fn parse(text: []u8) u32 {
    var digits = Big {};
    var count = 0;
    var exponent = 0;
    var sticky = false;
    var fraction = false;
    var i = 0;
    for (; i < text.len && text[i] != 'e' && text[i] != 'E'; i += 1) {
        var c = text[i];
        if (c == '.') {
            fraction = true;
        } else if (c != '_') {
            var d = (c - '0') as u32;
            if (count == 0 && d == 0) {
                if (fraction) {
                    exponent -= 1;
                }
            } else if (count < KEPT) {
                multiply(&digits, 10, d);
                count += 1;
                if (fraction) {
                    exponent -= 1;
                }
            } else {
                sticky = sticky || d != 0;
                if (!fraction) {
                    exponent += 1;
                }
            }
        }
    }
    if (i < text.len) {
        i += 1;
        var negative = text[i] == '-';
        if (text[i] == '+' || text[i] == '-') {
            i += 1;
        }
        var e = 0;
        for (; i < text.len; i += 1) {
            if (text[i] != '_' && e < 100000) {
                e = e * 10 + (text[i] - '0') as int;
            }
        }
        if (negative) {
            e = -e;
        }
        exponent += e;
    }
    if (count == 0) {
        return 0;
    }
    if (sticky) {
        multiply(&digits, 10, 1);
        count += 1;
        exponent -= 1;
    }
    // The number lies below 10^(count + exponent) and at or above a tenth of that
    if (count + exponent > 39) {
        return INFINITY;
    }
    if (count + exponent < -45) {
        return 0;
    }

    // It is n / m, from 2^e2 up to below 2^(e2 + 1)
    var n = digits;
    var m = Big {};
    m.limbs[0] = 1;
    for (var k = 0; k < exponent; k += 1) {
        multiply(&n, 10, 0);
    }
    for (var k = 0; k < -exponent; k += 1) {
        multiply(&m, 10, 0);
    }
    var e2 = bit_length(&n) - bit_length(&m);
    var scaled = Big {};
    if (e2 >= 0) {
        shifted(&m, e2, &scaled);
        if (compare(&n, &scaled) < 0) {
            e2 -= 1;
        }
    } else {
        shifted(&n, -e2, &scaled);
        if (compare(&scaled, &m) < 0) {
            e2 -= 1;
        }
    }

    // Its multiples of the unit of the last place, which is 2^-149 for subnormal numbers
    var unit = e2 - 23;
    if (unit < -149) {
        unit = -149;
    }
    var rest = Big {};
    var divisor = Big {};
    if (unit >= 0) {
        rest = n;
        shifted(&m, unit, &divisor);
    } else {
        shifted(&n, -unit, &rest);
        divisor = m;
    }
    var q: u32 = 0;
    var part = Big {};
    for (var bit = 24; bit >= 0; bit -= 1) {
        shifted(&divisor, bit, &part);
        if (compare(&rest, &part) >= 0) {
            subtract(&rest, &part);
            q |= (1 as u32) << bit;
        }
    }
    shifted(&rest, 1, &part);
    var half = compare(&part, &divisor);
    if (half > 0 || half == 0 && (q & 1) != 0) {
        q += 1;
    }
    if (q == 1 << 24) {
        q = 1 << 23;
        unit += 1;
    }
    if (q < 1 << 23) {
        return q;
    }
    if (unit + 150 >= 255) {
        return INFINITY;
    }
    return (unit + 150) as u32 << 23 | q - (1 << 23);
}
