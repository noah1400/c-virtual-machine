// f32 constants: their bits, and 64-bit integers rounded to the nearest f32
import "wide";

pub fn value(bits: u32) f32 {
    var copy = bits;
    return *(&copy as *f32);
}

pub fn bits(f: f32) u32 {
    var copy = f;
    return *(&copy as *u32);
}

// The nearest f32 to a 64-bit integer. ITOF rounds integers of 31 bits; a larger one is shifted down to 31
// bits, keeping in its lowest bit whether any bit shifted out was set, which makes it round the same way.
pub fn of_wide(n: wide.Wide) u32 {
    if (wide.fits(n)) {
        return bits(wide.low(n) as f32);
    }
    var magnitude = n;
    if (n.hi < 0) {
        magnitude = wide.negate(n);
    }
    var scale: f32 = 1;
    while (magnitude.hi != 0 || magnitude.lo >= 0x80000000) {
        var lost = magnitude.lo & 1;
        magnitude = wide.shr(magnitude, 1);
        magnitude.lo |= lost;
        scale *= 2;
    }
    var result = (magnitude.lo as int) as f32 * scale;
    if (n.hi < 0) {
        result = -result;
    }
    return bits(result);
}
