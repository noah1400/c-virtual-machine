// Writes a checked program as VM32 assembly, with .loc lines that point at its source lines
import "std/io";
import "std/str";
import "ast";
import "check";
import "loops";
import "wide";

// Scalars end up in R0, slices in R0 (pointer) and R5 (length), structs and arrays as their address in
// R0. R6 and R7 are scratch. R8 to R15 hold the scalar locals and parameters, the pointer and length of
// slices in two registers, and the values kept while others are computed, that gain the most from a
// register; other variables live in the frame, and a function without one reaches its parameters through SP.

struct Gen {
    program: *ast.Program;
    m: *ast.Module;
    pooled: ast.Map;        // the labels of the strings emitted, so that equal ones share their bytes
    text: str.Builder;      // code
    data: str.Builder;      // global variables
    pool: str.Builder;      // strings and the arrays of slice literals
    body: str.Builder;      // the function being generated, which needs its frame size first
    tables: str.Builder;    // the jump tables of that function
    scope: []u8;            // its label, which vmasm puts in front of the labels in it
    labels: int;
    strings: int;
    frame: int;             // bytes of locals and temporaries below BP
    break_label: int;
    continue_label: int;
    loc_module: *ast.Module;
    loc_line: int;
    loc_path: []u8;         // the quoted path of loc_module
    checked: ast.List;      // locals that are not null here, since code before checked them
    bounds: [8]Bound;       // what the loops around keep indexes below
    bound_count: int;
    ranges: [16]Bound;      // what indexes are below here, since code before checked them
    range_count: int;
    returns: [256]int;      // where the body jumps to the epilogue, as far as they fit
    return_count: int;
}

// An index that a loop keeps from 0 up to below the length of a slice, or below a limit when there is no
// slice
struct Bound {
    index: *ast.Symbol;
    slice: *ast.Symbol;
    limit: int;
}

struct Pooled {
    label: []u8;
}

// Where the placeholders of a pattern are, and which kind each is: s, d or +
struct Placeholders {
    pattern: []u8;
    at: [8]int;
    kind: [8]u8;
    count: int;
}

// Patterns are string literals, which their address tells apart, so each is scanned only once. Its address
// picks a pair of slots, which holds the last two patterns that picked it.
var placeholders: [512]Placeholders;

// Appends pattern to out with each %s replaced by the next of texts, each %d by the next of numbers,
// and each %+d by the next number with its sign
fn format(out: *str.Builder, pattern: []u8, texts: [][]u8, numbers: []int) {
    var found = &placeholders[(pattern.ptr as u32 >> 1 & 510) as int];
    if (found.pattern.ptr != pattern.ptr || found.pattern.len != pattern.len) {
        var first = found;
        found = &first[1];
        if (found.pattern.ptr != pattern.ptr || found.pattern.len != pattern.len) {
            *found = *first;
            found = &first[0];
            found.pattern = pattern;
            found.count = 0;
            for (var i = 0; i < pattern.len; i += 1) {
                if (pattern[i] == '%') {
                    found.at[found.count] = i;
                    found.kind[found.count] = pattern[i + 1];
                    found.count += 1;
                }
            }
        }
    }
    var start = 0;
    var text = 0;
    var number = 0;
    for (var k = 0; k < found.count; k += 1) {
        var at = found.at[k];
        str.append(out, pattern[start:at]);
        var kind = found.kind[k];
        start = at + 2;
        if (kind == 's') {
            str.append(out, texts[text]);
            text += 1;
        } else {
            if (kind == '+') {
                start = at + 3;
                if (numbers[number] >= 0) {
                    str.append_byte(out, '+');
                }
            }
            str.append_int(out, numbers[number]);
            number += 1;
        }
    }
    str.append(out, pattern[start:]);
}

fn emit(g: *Gen, text: []u8) {
    str.append(&g.body, text);
}

fn emitd(g: *Gen, pattern: []u8, numbers: []int) {
    var none: [][]u8;
    format(&g.body, pattern, none, numbers);
}

fn emits(g: *Gen, pattern: []u8, texts: [][]u8) {
    var none: []int;
    format(&g.body, pattern, texts, none);
}

fn emitf(g: *Gen, pattern: []u8, texts: [][]u8, numbers: []int) {
    format(&g.body, pattern, texts, numbers);
}

fn label(g: *Gen) int {
    g.labels += 1;
    return g.labels;
}

fn is_aggregate(t: *ast.Type) bool {
    return t.kind == ast.TypeKind.STRUCT || t.kind == ast.TypeKind.ARRAY;
}

fn words(size: int) int {
    return (size + 3) / 4 * 4;
}

fn alloc_frame(g: *Gen, size: int) int {
    if (size > 0) {
        g.frame += words(size);
    } else {
        g.frame += words(1);
    }
    return -g.frame;
}

fn symbol_name(s: *ast.Symbol) []u8 {
    if (s.asm_name.ptr == null && s.decl != null && s.decl.is_extern) {
        s.asm_name = s.name;
    } else if (s.asm_name.ptr == null) {
        s.asm_name = ast.cat([][]u8 { s.module.name, ".", s.name });
    }
    return s.asm_name;
}

// The bytes that vmasm would read differently in a string
var escaped: [256]bool;

// Writes text as an assembler string, escaping what vmasm would read differently
fn quoted(out: *str.Builder, text: []u8) {
    if (!escaped[0]) {
        for (var i = 0; i < 256; i += 1) {
            escaped[i] = i < 32 || i >= 127 || i == '"' || i == '\\';
        }
    }
    var hex = "0123456789ABCDEF";
    str.append_byte(out, '"');
    var start = 0;
    for (var i = 0; i < text.len; i += 1) {
        var c = text[i];
        if (escaped[c]) {
            str.append(out, text[start:i]);
            start = i + 1;
            if (c == '"' || c == '\\') {
                str.append_byte(out, '\\');
                str.append_byte(out, c);
            } else if (c == '\n') {
                str.append(out, "\\n");
            } else if (c == '\t') {
                str.append(out, "\\t");
            } else {
                str.append(out, "\\x");
                str.append_byte(out, hex[(c >> 4) as int]);
                str.append_byte(out, hex[(c & 15) as int]);
            }
        }
    }
    str.append(out, text[start:]);
    str.append_byte(out, '"');
}

fn loc(g: *Gen, line: int) {
    if (g.program.no_loc || g.loc_module == g.m && g.loc_line == line) {
        return;
    }
    if (g.loc_module != g.m) {
        var path = str.builder(g.m.path.len + 2);
        quoted(&path, g.m.path);
        g.loc_path = ast.clone(str.text(&path));
        str.release(&path);
    }
    g.loc_module = g.m;
    g.loc_line = line;
    emit(g, "    .loc ");
    emit(g, g.loc_path);
    // vmasm takes the text of the line from the file when it is left out
    if (!g.program.loc_texts) {
        emitd(g, ", %d\n", []int { line });
        return;
    }
    var text = "";
    if (line >= 1 && line <= g.m.lines.len) {
        text = g.m.lines[line - 1];
    }
    emitd(g, ", %d, ", []int { line });
    quoted(&g.body, text);
    emit(g, "\n");
}

// Small integers are kept zero- or sign-extended to 32 bits
fn normalize(g: *Gen, t: *ast.Type) {
    normalize_register(g, t, "R0");
}

fn normalize_register(g: *Gen, t: *ast.Type, register: []u8) {
    if (t.kind != ast.TypeKind.INT || t.size == 4) {
        return;
    }
    if (t.is_signed) {
        emitf(g, "    SHL %s, #%d\n    SAR %s, #%d\n", [][]u8 { register, register },
            []int { 32 - 8 * t.size, 32 - 8 * t.size });
    } else if (t.size == 1) {
        emits(g, "    AND %s, #255\n", [][]u8 { register });
    } else {
        emits(g, "    AND %s, #65535\n", [][]u8 { register });
    }
}

var register_names = [16][]u8 {
    "R0", "R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9", "R10", "R11", "R12", "R13", "R14", "R15",
};

// The register that holds a scalar local, or nothing
fn register_of(e: *ast.Expr) []u8 {
    var none: []u8;
    if (e.kind == ast.ExprKind.NAME && e.symbol != null && e.symbol.kind == ast.SymbolKind.LOCAL && e.symbol.reg != 0 &&
        e.symbol.type.kind != ast.TypeKind.SLICE) {
        return register_names[e.symbol.reg];
    }
    return none;
}

// The register that holds the pointer of a slice local, whose length is in the next one, or 0
fn slice_register(e: *ast.Expr) int {
    if (e.kind == ast.ExprKind.NAME && e.symbol != null && e.symbol.kind == ast.SymbolKind.LOCAL &&
        e.type.kind == ast.TypeKind.SLICE) {
        return e.symbol.reg;
    }
    return 0;
}

// The register that holds the length or pointer of a slice local, or nothing
fn field_register(e: *ast.Expr) []u8 {
    var none: []u8;
    if (e.kind != ast.ExprKind.LEN && e.kind != ast.ExprKind.PTR || slice_register(e.left) == 0) {
        return none;
    }
    if (e.kind == ast.ExprKind.LEN) {
        return register_names[slice_register(e.left) + 1];
    }
    return register_names[slice_register(e.left)];
}

// Loads the value of type t from the address place into R0 (and R5); place is a register, a place in the
// frame such as BP-8 or SP+4, or a label
fn load_from(g: *Gen, t: *ast.Type, place: []u8) {
    if (t.kind == ast.TypeKind.SLICE) {
        emits(g, "    LOAD R5, [%s+4]\n    LOAD R0, [%s]\n", [][]u8 { place, place });
    } else if (is_aggregate(t)) {
        if (!ast.same(place, "R0")) {
            if (place[0] == 'R' || place[0] == 'B' || place[0] == 'S') {
                emits(g, "    LEA R0, [%s]\n", [][]u8 { place });
            } else {
                emits(g, "    LOAD R0, %s\n", [][]u8 { place });
            }
        }
    } else {
        load_into(g, t, place, "R0");
    }
}

// Loads a scalar into a register, which keeps it as 32 bits
fn load_into(g: *Gen, t: *ast.Type, place: []u8, register: []u8) {
    var load = "LOAD";
    if (t.size == 1) {
        load = "LOADB";
    } else if (t.size == 2) {
        load = "LOADW";
    }
    emits(g, "    %s %s, [%s]\n", [][]u8 { load, register, place });
    if (t.is_signed) {
        normalize_register(g, t, register);
    }
}

// Loads a scalar that code finds in memory straight into a register; tells whether e was one
fn load_value(g: *Gen, e: *ast.Expr, register: []u8) bool {
    if (!check.is_scalar(e.type) || e.is_const) {
        return false;
    }
    var at = place(e);
    if (at.ptr == null) {
        if (e.kind != ast.ExprKind.FIELD && e.kind != ast.ExprKind.INDEX &&
            (e.kind != ast.ExprKind.UNARY || e.op != ast.TokenKind.STAR)) {
            return false;
        }
        var base: []u8;
        var offset = gen_address(g, e, &base);
        at = relative(base, offset);
    }
    load_into(g, e.type, at, register);
    return true;
}

// Stores the value in R0 (and R5), or the aggregate R0 points at, to place
fn store_to(g: *Gen, t: *ast.Type, place: []u8) {
    if (t.kind == ast.TypeKind.SLICE) {
        emits(g, "    STORE R0, [%s]\n    STORE R5, [%s+4]\n", [][]u8 { place, place });
    } else if (is_aggregate(t)) {
        if (t.size > 0) {
            if (!ast.same(place, "R6")) {
                emits(g, "    LEA R6, [%s]\n", [][]u8 { place });
            }
            emitd(g, "    MEMCPY R6, R0, #%d\n", []int { t.size });
        }
    } else {
        store_from(g, t, "R0", place);
    }
}

// Stores a scalar from a register
fn store_from(g: *Gen, t: *ast.Type, register: []u8, place: []u8) {
    var store = "STORE";
    if (t.size == 1) {
        store = "STOREB";
    } else if (t.size == 2) {
        store = "STOREW";
    }
    emits(g, "    %s %s, [%s]\n", [][]u8 { store, register, place });
}

// A function without a frame reaches its parameters through SP, past the registers it saved and what its
// code has pushed since. Code that pushes and pops as part of a value tells how much.
struct Stack {
    frameless: bool;
    saved: int;
    pushed: int;
    held: int;              // values kept while others are computed
}

var stack: Stack;

// The registers that keep values while others are computed, by how many are kept around them, or 0 where
// they go on the stack
var temp_registers: [4]int;

// Keeps R0 while more code runs; returns the register it is in, or nothing when it is on the stack
fn hold(g: *Gen) []u8 {
    var none: []u8;
    var depth = stack.held;
    stack.held += 1;
    if (depth < temp_registers.len && temp_registers[depth] != 0) {
        var register = register_names[temp_registers[depth]];
        emits(g, "    MOVE %s, R0\n", [][]u8 { register });
        return register;
    }
    push(g, "R0");
    return none;
}

// Computes x and keeps it as hold does, loading it straight into its register where it can
fn hold_value(g: *Gen, x: *ast.Expr) []u8 {
    var depth = stack.held;
    if (depth < temp_registers.len && temp_registers[depth] != 0) {
        var register = register_names[temp_registers[depth]];
        if (load_value(g, x, register)) {
            stack.held += 1;
            return register;
        }
    }
    gen_expr(g, x);
    return hold(g);
}

// Stops keeping a value; returns where it is: its register, or R6 after taking it off the stack
fn release(g: *Gen, held: []u8) []u8 {
    stack.held -= 1;
    if (held.ptr != null) {
        return held;
    }
    pop(g, "R6");
    return "R6";
}

fn push(g: *Gen, operand: []u8) {
    emits(g, "    PUSH %s\n", [][]u8 { operand });
    stack.pushed += 4;
}

fn pop(g: *Gen, register: []u8) {
    emits(g, "    POP %s\n", [][]u8 { register });
    stack.pushed -= 4;
}

// Removes arguments or temporaries from the stack
fn drop(g: *Gen, bytes: int) {
    emitd(g, "    ADD SP, #%d\n", []int { bytes });
    stack.pushed -= bytes;
}

// The register that the frame offsets of parameters count from, and their offset from it
fn frame_base(offset: int) []u8 {
    if (stack.frameless && offset > 0) {
        return "SP";
    }
    return "BP";
}

fn frame_offset(offset: int) int {
    if (stack.frameless && offset > 0) {
        return offset - 4 + 4 * stack.saved + stack.pushed;
    }
    return offset;
}

// Operands are made once for the frame offsets and constants that are common
const CACHED = 1024;
var local_places: [2 * CACHED][]u8;
var local_operands: [2 * CACHED][]u8;
var constant_operands: [2 * CACHED][]u8;

fn local_place(offset: int) []u8 {
    if (stack.frameless && offset > 0) {
        return ast.cat([][]u8 { "SP+", ast.number(frame_offset(offset)) });
    }
    var cached = offset >= -CACHED && offset < CACHED;
    if (cached && local_places[offset + CACHED].ptr != null) {
        return local_places[offset + CACHED];
    }
    var digits: [11]u8;
    var sign = "+";
    if (offset < 0) {
        sign = "";
    }
    var text = ast.cat([][]u8 { "BP", sign, str.format_int(offset, digits) });
    if (cached) {
        local_places[offset + CACHED] = text;
    }
    return text;
}

// A local in memory as an instruction operand
fn local_operand(offset: int) []u8 {
    if (stack.frameless && offset > 0) {
        return ast.cat([][]u8 { "[", local_place(offset), "]" });
    }
    var cached = offset >= -CACHED && offset < CACHED;
    if (cached && local_operands[offset + CACHED].ptr != null) {
        return local_operands[offset + CACHED];
    }
    var text = ast.cat([][]u8 { "[", local_place(offset), "]" });
    if (cached) {
        local_operands[offset + CACHED] = text;
    }
    return text;
}

fn constant_operand(value: int) []u8 {
    var cached = value >= -CACHED && value < CACHED;
    if (cached && constant_operands[value + CACHED].ptr != null) {
        return constant_operands[value + CACHED];
    }
    var text = ast.cat([][]u8 { "#", ast.number(value) });
    if (cached) {
        constant_operands[value + CACHED] = text;
    }
    return text;
}

// A place that is a register or a label, with an offset added
fn relative(base: []u8, offset: int) []u8 {
    if (ast.same(base, "BP")) {
        return local_place(offset);
    }
    if (offset == 0) {
        return base;
    }
    var sign = "+";
    if (offset < 0) {
        sign = "";
    }
    return ast.cat([][]u8 { base, sign, ast.number(offset) });
}

// Finds the variable in memory that holds e at a fixed offset: a local, whose base is BP, or a global,
// whose base is its label
fn find_place(e: *ast.Expr, base: *[]u8, offset: *int) bool {
    switch (e.kind) {
        case ast.ExprKind.NAME {
            if (e.symbol.kind == ast.SymbolKind.LOCAL && e.symbol.reg == 0) {
                *base = "BP";
                *offset = e.symbol.offset;
                return true;
            }
            if (e.symbol.kind == ast.SymbolKind.GLOBAL) {
                *base = symbol_name(e.symbol);
                *offset = 0;
                return true;
            }
        }
        case ast.ExprKind.FIELD {
            if (e.field != null && e.left.type.kind == ast.TypeKind.STRUCT && find_place(e.left, base, offset)) {
                *offset += e.field.offset;
                return true;
            }
        }
        case ast.ExprKind.INDEX {
            if (e.left.type.kind == ast.TypeKind.ARRAY && e.right.is_const && find_place(e.left, base, offset)) {
                *offset += wide.low(e.right.value) * e.left.type.base.size;
                return true;
            }
        }
        case ast.ExprKind.LEN, ast.ExprKind.PTR {
            if (find_place(e.left, base, offset)) {
                if (e.kind == ast.ExprKind.LEN) {
                    *offset += 4;
                }
                return true;
            }
        }
    }
    return false;
}

// Where instructions can address a variable, or a part of one at a fixed offset, directly: as BP-8, or
// as a label with an offset. Nothing when code has to compute the address.
fn place(e: *ast.Expr) []u8 {
    var none: []u8;
    var base: []u8;
    var offset = 0;
    if (!find_place(e, &base, &offset)) {
        return none;
    }
    if (ast.same(base, "BP")) {
        return local_place(offset);
    }
    return relative(base, offset);
}

fn zero(g: *Gen, t: *ast.Type, offset: int) {
    if (t.size == 0) {
        return;
    }
    if (check.is_scalar(t) && t.size == 4) {
        emitd(g, "    LOAD R0, #0\n    STORE R0, [BP%+d]\n", []int { offset });
        return;
    }
    emitd(g, "    LEA R6, [BP%+d]\n    LOAD R7, #0\n    MEMSET R6, R7, #%d\n", []int { offset, t.size });
}

fn is_checked(g: *Gen, s: *ast.Symbol) bool {
    for (var i = 0; i < g.checked.count; i += 1) {
        if (g.checked.items[i] == s as *u8) {
            return true;
        }
    }
    return false;
}

// The locals known not to be null at the start of a statement or expression, as many as fit, and the
// indexes known to be in range
struct Checked {
    items: [16]*u8;
    count: int;
    ranges: [16]Bound;
    range_count: int;
}

fn save_checked(g: *Gen, saved: *Checked) {
    saved.count = 0;
    for (var i = 0; i < g.checked.count && i < saved.items.len; i += 1) {
        saved.items[i] = g.checked.items[i];
        saved.count += 1;
    }
    for (var i = 0; i < g.range_count; i += 1) {
        saved.ranges[i] = g.ranges[i];
    }
    saved.range_count = g.range_count;
}

fn assigns(s: *ast.Stmt, local: *u8) bool {
    if (s == null) {
        return false;
    }
    switch (s.kind) {
        case ast.StmtKind.BLOCK {
            for (var i = 0; i < s.body.len; i += 1) {
                if (assigns(s.body[i], local)) {
                    return true;
                }
            }
        }
        case ast.StmtKind.VAR {
            return s.symbol as *u8 == local;
        }
        case ast.StmtKind.ASSIGN {
            return local_of(s.target) as *u8 == local;
        }
        case ast.StmtKind.IF {
            return assigns(s.then, local) || assigns(s.otherwise, local);
        }
        case ast.StmtKind.WHILE, ast.StmtKind.FOR {
            return assigns(s.init, local) || assigns(s.step, local) || assigns(s.then, local);
        }
        case ast.StmtKind.SWITCH {
            for (var i = 0; i < s.cases.len; i += 1) {
                if (assigns(s.cases[i].body, local)) {
                    return true;
                }
            }
            return assigns(s.fallback, local);
        }
    }
    return false;
}

// Keeps the locals of saved that the statements a and b do not assign as the ones known not to be null,
// and the ranges of saved whose locals they do not assign
fn keep_checked(g: *Gen, saved: *Checked, a: *ast.Stmt, b: *ast.Stmt) {
    g.checked.count = 0;
    for (var i = 0; i < saved.count; i += 1) {
        if (!assigns(a, saved.items[i]) && !assigns(b, saved.items[i])) {
            ast.add(&g.checked, saved.items[i]);
        }
    }
    g.range_count = 0;
    for (var i = 0; i < saved.range_count; i += 1) {
        var r = &saved.ranges[i];
        if (!assigns(a, r.index as *u8) && !assigns(b, r.index as *u8) &&
            (r.slice == null || !assigns(a, r.slice as *u8) && !assigns(b, r.slice as *u8))) {
            g.ranges[g.range_count] = *r;
            g.range_count += 1;
        }
    }
}

// Code reaches a label from more than one place. The locals that were not null where the statement or
// expression began are still not null there, unless the statements a and b between assign them.
fn merge_label(g: *Gen, n: int, saved: *Checked, a: *ast.Stmt, b: *ast.Stmt) {
    keep_checked(g, saved, a, b);
    emitd(g, ".L%d:\n", []int { n });
}

// Notes the locals that a condition shows not to be null when it is found to be holds
fn note_not_null(g: *Gen, e: *ast.Expr, holds: bool) {
    if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.BANG) {
        note_not_null(g, e.left, !holds);
    } else if (e.kind == ast.ExprKind.BINARY && (e.op == ast.TokenKind.ANDAND && holds ||
               e.op == ast.TokenKind.OROR && !holds)) {
        note_not_null(g, e.left, holds);
        note_not_null(g, e.right, holds);
    } else if (e.kind == ast.ExprKind.BINARY && (e.op == ast.TokenKind.EQ || e.op == ast.TokenKind.NE) &&
               (e.op == ast.TokenKind.NE) == holds && e.right.kind == ast.ExprKind.NULL && unshared(e.left) &&
               !is_checked(g, e.left.symbol)) {
        ast.add(&g.checked, e.left.symbol as *u8);
    }
}

// The local that a condition shows not to be null where it holds, as note_not_null finds it
fn null_fact(e: *ast.Expr, holds: bool) *ast.Symbol {
    if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.BANG) {
        return null_fact(e.left, !holds);
    }
    if (e.kind == ast.ExprKind.BINARY && (e.op == ast.TokenKind.EQ || e.op == ast.TokenKind.NE) &&
        (e.op == ast.TokenKind.NE) == holds && e.right.kind == ast.ExprKind.NULL && unshared(e.left)) {
        return e.left.symbol;
    }
    return null;
}

// Whether a condition branches once, after all of its code, rather than part way as && and || do
fn jumps_once(e: *ast.Expr) bool {
    if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.BANG) {
        return jumps_once(e.left);
    }
    return e.kind != ast.ExprKind.BINARY || e.op != ast.TokenKind.ANDAND && e.op != ast.TokenKind.OROR;
}

// Whether code can go on after a statement, as far as its last statements show
fn falls_through(s: *ast.Stmt) bool {
    switch (s.kind) {
        case ast.StmtKind.BLOCK {
            return s.body.len == 0 || falls_through(s.body[s.body.len - 1]);
        }
        case ast.StmtKind.RETURN, ast.StmtKind.BREAK, ast.StmtKind.CONTINUE {
            return false;
        }
        case ast.StmtKind.IF {
            return s.otherwise == null || falls_through(s.then) || falls_through(s.otherwise);
        }
    }
    return true;
}

// After an assignment to a local, it is not null only if it was set to new memory or an address
fn assigned(g: *Gen, target: *ast.Expr, value: *ast.Expr) {
    if (target.kind != ast.ExprKind.NAME || target.symbol.kind != ast.SymbolKind.LOCAL) {
        return;
    }
    for (var i = 0; i < g.checked.count; i += 1) {
        if (g.checked.items[i] == target.symbol as *u8) {
            g.checked.count -= 1;
            g.checked.items[i] = g.checked.items[g.checked.count];
        }
    }
    var kept = 0;
    for (var i = 0; i < g.range_count; i += 1) {
        if (g.ranges[i].index != target.symbol && g.ranges[i].slice != target.symbol) {
            g.ranges[kept] = g.ranges[i];
            kept += 1;
        }
    }
    g.range_count = kept;
    if (unshared(target) && value != null && (value.kind == ast.ExprKind.NEW && value.left == null ||
        value.kind == ast.ExprKind.UNARY && value.op == ast.TokenKind.AMP)) {
        ast.add(&g.checked, target.symbol as *u8);
    }
}

// Checks the pointer x in a register, unless x is a local that was checked since it last changed
fn check_pointer(g: *Gen, x: *ast.Expr, register: []u8) {
    if (!unshared(x)) {
        check_null(g, register);
    } else if (!is_checked(g, x.symbol)) {
        check_null(g, register);
        ast.add(&g.checked, x.symbol as *u8);
    }
}

fn check_null(g: *Gen, register: []u8) {
    var ok = label(g);
    emitf(g, "    CMP %s, #0\n    JNZ .L%d\n    CALL rt.null_error\n.L%d:\n", [][]u8 { register }, []int { ok, ok });
}

// The k of a value 2^k with k > 0, or else 0
fn shift_of(value: int) int {
    if (value < 2 || (value & (value - 1)) != 0) {
        return 0;
    }
    var shift = 0;
    while (1 << shift < value) {
        shift += 1;
    }
    return shift;
}

// Multiplies a register by the size of an element
fn scale(g: *Gen, size: int, register: []u8) {
    if (size == 1) {
        return;
    }
    var shift = shift_of(size);
    if (shift > 0) {
        emitf(g, "    SHL %s, #%d\n", [][]u8 { register }, []int { shift });
    } else {
        emitf(g, "    MUL %s, #%d\n", [][]u8 { register }, []int { size });
    }
}

// Labels of data without a name of its own; digits after the dot keep them apart from Ore names
fn pool_label(g: *Gen) []u8 {
    g.strings += 1;
    return ast.cat([][]u8 { g.m.name, ".", ast.number(g.strings) });
}

fn string_label(g: *Gen, bytes: []u8) []u8 {
    var pooled = ast.get(&g.pooled, bytes) as *Pooled;
    if (pooled != null) {
        return pooled.label;
    }
    var name = pool_label(g);
    format(&g.pool, "%s:\n    .asciiz ", [][]u8 { name }, []int {});
    quoted(&g.pool, bytes);
    str.append(&g.pool, "\n");
    pooled = new(Pooled);
    pooled.label = name;
    ast.put(&g.pooled, bytes, pooled as *u8);
    return name;
}

// A string constant keeps one copy of its bytes however often it is used
fn string_of(g: *Gen, e: *ast.Expr) []u8 {
    if (e.kind != ast.ExprKind.NAME) {
        return string_label(g, e.bytes);
    }
    var s = e.symbol;
    if (s.label.len == 0) {
        s.label = string_label(g, s.string.bytes);
    }
    return s.label;
}

fn string_size(e: *ast.Expr) int {
    if (e.kind == ast.ExprKind.NAME) {
        return e.symbol.string.bytes.len;
    }
    return e.bytes.len;
}

fn gen_string(g: *Gen, e: *ast.Expr) {
    emitf(g, "    LOAD R0, %s\n    LOAD R5, #%d\n", [][]u8 { string_of(g, e) }, []int { string_size(e) });
}

fn is_signed(t: *ast.Type) bool {
    return t.kind == ast.TypeKind.ENUM || t.kind == ast.TypeKind.UNTYPED || t.kind == ast.TypeKind.INT && t.is_signed;
}

var signed_codes = [6][]u8 { "Z", "NZ", "L", "GE", "LE", "G" };
var unsigned_codes = [6][]u8 { "Z", "NZ", "B", "AE", "BE", "A" };

// The condition code of a comparison, or of its opposite
fn condition(op: ast.TokenKind, t: *ast.Type, inverse: bool) []u8 {
    var i = 0;
    switch (op) {
        case ast.TokenKind.NE {
            i = 1;
        }
        case ast.TokenKind.LT {
            i = 2;
        }
        case ast.TokenKind.GE {
            i = 3;
        }
        case ast.TokenKind.LE {
            i = 4;
        }
        case ast.TokenKind.GT {
            i = 5;
        }
    }
    if (inverse) {
        i ^= 1;
    }
    if (is_signed(t)) {
        return signed_codes[i];
    }
    return unsigned_codes[i];
}

fn is_comparison(e: *ast.Expr) bool {
    return e.kind == ast.ExprKind.BINARY && e.op as int >= ast.TokenKind.EQ as int &&
        e.op as int <= ast.TokenKind.GE as int;
}

// A value that an instruction can take without code to compute it: a constant, a variable in a register,
// or a variable of 4 bytes in memory, since memory operands are read as 32 bits
fn simple_operand(e: *ast.Expr) []u8 {
    var none: []u8;
    if (e.is_const && check.is_scalar(e.type)) {
        return constant_operand(wide.low(e.value));
    }
    if (e.kind == ast.ExprKind.NULL) {
        return "#0";
    }
    var register = register_of(e);
    if (register.ptr == null) {
        register = field_register(e);
    }
    if (register.ptr != null) {
        return register;
    }
    if (!check.is_scalar(e.type) || e.type.size != 4) {
        return none;
    }
    var base: []u8;
    var offset = 0;
    if (!find_place(e, &base, &offset)) {
        return none;
    }
    if (ast.same(base, "BP")) {
        return local_operand(offset);
    }
    return ast.cat([][]u8 { "[", relative(base, offset), "]" });
}

// A left operand that instructions can still take after the code for the right one
fn is_left_operand(e: *ast.Expr) bool {
    return !is_operand(e.right) && is_operand(e.left) && (is_stable(e.left) || !has_call(e.right));
}

// Operands that can be taken in either order; an f32 operation with two NaNs keeps the first one's bits
fn swappable(e: *ast.Expr) bool {
    return is_commutative(e.op) && e.type.kind != ast.TypeKind.FLOAT;
}

fn is_commutative(op: ast.TokenKind) bool {
    return op == ast.TokenKind.PLUS || op == ast.TokenKind.STAR || op == ast.TokenKind.AMP ||
        op == ast.TokenKind.PIPE || op == ast.TokenKind.CARET;
}

// The comparison with its operands the other way round
fn swapped(op: ast.TokenKind) ast.TokenKind {
    switch (op) {
        case ast.TokenKind.LT {
            return ast.TokenKind.GT;
        }
        case ast.TokenKind.GT {
            return ast.TokenKind.LT;
        }
        case ast.TokenKind.LE {
            return ast.TokenKind.GE;
        }
        case ast.TokenKind.GE {
            return ast.TokenKind.LE;
        }
    }
    return op;
}

// When both operands need code, leaves the left one in the register it returns and the right one in R0,
// which suits an operation that can take them either way; returns nothing when they do not
fn swap_operands(g: *Gen, e: *ast.Expr) []u8 {
    var none: []u8;
    if (is_operand(e.right) || is_left_operand(e)) {
        return none;
    }
    var held = hold_value(g, e.left);
    gen_expr(g, e.right);
    return release(g, held);
}

// Leaves the left operand in R0 and puts the right one where the instruction can take it
fn operands(g: *Gen, e: *ast.Expr) []u8 {
    if (is_operand(e.right)) {
        gen_expr(g, e.left);
        return gen_operand(g, e.right);
    }
    if (is_left_operand(e)) {
        var left = gen_operand(g, e.left);
        gen_expr(g, e.right);
        emit(g, "    MOVE R6, R0\n");
        set_register(g, "R0", left);
        return "R6";
    }
    gen_expr(g, e.left);
    push(g, "R0");
    gen_expr(g, e.right);
    emit(g, "    MOVE R6, R0\n");
    pop(g, "R0");
    return "R6";
}

fn arithmetic(g: *Gen, op: ast.TokenKind, t: *ast.Type, right: []u8) {
    arithmetic_on(g, "R0", op, t, right);
}

fn is_arithmetic(op: ast.TokenKind) bool {
    return op == ast.TokenKind.PLUS || op == ast.TokenKind.MINUS || op == ast.TokenKind.STAR ||
        op == ast.TokenKind.SLASH || op == ast.TokenKind.PERCENT || op == ast.TokenKind.AMP ||
        op == ast.TokenKind.PIPE || op == ast.TokenKind.CARET || op == ast.TokenKind.SHL || op == ast.TokenKind.SHR;
}

// The value of an immediate operand that is a positive number, or else 0
fn immediate(operand: []u8) int {
    if (operand[0] != '#') {
        return 0;
    }
    var value = 0;
    for (var i = 1; i < operand.len; i += 1) {
        if (operand[i] < '0' || operand[i] > '9') {
            return 0;
        }
        value = value * 10 + (operand[i] - '0') as int;
    }
    return value;
}

var float_instructions = [4][]u8 { "FADD", "FSUB", "FMUL", "FDIV" };

fn arithmetic_on(g: *Gen, register: []u8, op: ast.TokenKind, t: *ast.Type, right: []u8) {
    if (t.kind == ast.TypeKind.FLOAT) {
        emits(g, "    %s %s, %s\n", [][]u8 { float_instructions[op as int - ast.TokenKind.PLUS as int], register, right });
        return;
    }
    var instruction = "ADD";
    // Unsigned division and remainder by 2^k are a shift and a mask
    var shift = 0;
    if (!is_signed(t)) {
        shift = shift_of(immediate(right));
    }
    switch (op) {
        case ast.TokenKind.MINUS {
            instruction = "SUB";
        }
        case ast.TokenKind.STAR {
            instruction = "MUL";
        }
        case ast.TokenKind.SLASH {
            instruction = "DIV";
            if (is_signed(t)) {
                instruction = "IDIV";
            } else if (shift > 0) {
                instruction = "SHR";
                right = constant_operand(shift);
            }
        }
        case ast.TokenKind.PERCENT {
            instruction = "MOD";
            if (is_signed(t)) {
                instruction = "IMOD";
            } else if (shift > 0) {
                instruction = "AND";
                right = constant_operand((1 << shift) - 1);
            }
        }
        case ast.TokenKind.AMP {
            instruction = "AND";
        }
        case ast.TokenKind.PIPE {
            instruction = "OR";
        }
        case ast.TokenKind.CARET {
            instruction = "XOR";
        }
        case ast.TokenKind.SHL {
            instruction = "SHL";
        }
        case ast.TokenKind.SHR {
            instruction = "SHR";
            if (is_signed(t)) {
                instruction = "SAR";
            }
        }
    }
    emits(g, "    %s %s, %s\n", [][]u8 { instruction, register, right });
    normalize_register(g, t, register);
}

fn gen_binary(g: *Gen, e: *ast.Expr) {
    var left = e.left.type;

    if (e.op == ast.TokenKind.ANDAND || e.op == ast.TokenKind.OROR) {
        gen_logical(g, e);
        return;
    }
    if (left.kind == ast.TypeKind.POINTER && !is_comparison(e)) {
        var size = left.base.size;
        var instruction = "SUB";
        if (e.op == ast.TokenKind.PLUS) {
            instruction = "ADD";
        }
        if (e.right.type.kind != ast.TypeKind.POINTER && is_operand(e.right)) {
            gen_expr(g, e.left);
            if (e.right.is_const) {
                emitf(g, "    %s R0, #%d\n", [][]u8 { instruction }, []int { wide.low(e.right.value) * size });
            } else if (size == 1) {
                emits(g, "    %s R0, %s\n", [][]u8 { instruction, gen_operand(g, e.right) });
            } else {
                set_register(g, "R6", gen_operand(g, e.right));
                scale(g, size, "R6");
                emits(g, "    %s R0, R6\n", [][]u8 { instruction });
            }
            return;
        }
        gen_expr(g, e.left);
        push(g, "R0");
        gen_expr(g, e.right);
        if (e.right.type.kind == ast.TypeKind.POINTER) {
            emit(g, "    MOVE R6, R0\n");
            pop(g, "R0");
            emit(g, "    SUB R0, R6\n");
            if (size > 1) {
                emitd(g, "    IDIV R0, #%d\n", []int { size });
            }
            return;
        }
        scale(g, size, "R0");
        emit(g, "    MOVE R6, R0\n");
        pop(g, "R0");
        emits(g, "    %s R0, R6\n", [][]u8 { instruction });
        return;
    }

    if (is_comparison(e) && left.kind == ast.TypeKind.FLOAT) {
        var code = float_compare(g, e);
        if (code.ptr != null) {
            emits(g, "    SET%s R0\n", [][]u8 { code });
        } else if (e.op == ast.TokenKind.EQ) {
            emit(g, "    SETZ R0\n    SETAE R6\n    AND R0, R6\n");
        } else {
            emit(g, "    SETNZ R0\n    SETB R6\n    OR R0, R6\n");
        }
        return;
    }
    var bits = tested_bits(e);
    if (bits != null) {
        gen_test(g, bits);
        emits(g, "    SET%s R0\n", [][]u8 { condition(e.op, left, false) });
        return;
    }
    if (is_comparison(e)) {
        var register = register_of(e.left);
        if (register.ptr != null && is_operand(e.right)) {
            var operand = gen_operand(g, e.right);
            emits(g, "    CMP %s, %s\n    SET%s R0\n", [][]u8 { register, operand, condition(e.op, left, false) });
            return;
        }
    }
    // With the left operand taken last, the right one can stay in R0
    if ((is_comparison(e) || swappable(e)) && is_left_operand(e)) {
        var operand = gen_operand(g, e.left);
        gen_expr(g, e.right);
        if (is_comparison(e)) {
            emits(g, "    CMP R0, %s\n    SET%s R0\n", [][]u8 { operand, condition(swapped(e.op), left, false) });
        } else {
            arithmetic(g, e.op, e.type, operand);
        }
        return;
    }
    if (is_comparison(e) || swappable(e)) {
        var held = swap_operands(g, e);
        if (held.ptr != null && is_comparison(e)) {
            emits(g, "    CMP %s, R0\n    SET%s R0\n", [][]u8 { held, condition(e.op, left, false) });
            return;
        }
        if (held.ptr != null) {
            arithmetic(g, e.op, e.type, held);
            return;
        }
    }
    // An operation that needs its operands in order works on the register that keeps the left one
    var depth = stack.held;
    if (!is_comparison(e) && !is_operand(e.right) && !is_left_operand(e) && depth < temp_registers.len &&
        temp_registers[depth] != 0) {
        var held = hold_value(g, e.left);
        gen_expr(g, e.right);
        release(g, held);
        arithmetic_on(g, held, e.op, e.type, "R0");
        emits(g, "    MOVE R0, %s\n", [][]u8 { held });
        return;
    }
    var right = operands(g, e);
    if (is_comparison(e)) {
        emits(g, "    CMP R0, %s\n    SET%s R0\n", [][]u8 { right, condition(e.op, left, false) });
        return;
    }
    arithmetic(g, e.op, e.type, right);
}

fn is_logical(e: *ast.Expr) bool {
    return e.kind == ast.ExprKind.BINARY && (e.op == ast.TokenKind.ANDAND || e.op == ast.TokenKind.OROR);
}

// Whether gen_condition branches on the value of e in R0, which is then 0 or 1
fn tests_value(e: *ast.Expr) bool {
    return !e.is_const && !(e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.BANG) && !is_logical(e) &&
        !is_comparison(e) && tested_bits(e) == null && register_of(e).ptr == null;
}

// Where the operands of && and || that a value is made of branch to
struct Logical {
    yes: int;
    no: int;
    end: int;
    to_yes: bool;
    to_no: bool;
    first: bool;
    saved: Checked;         // what holds wherever the value is made
}

// Makes 0 or 1 of && and ||. The operands before the last one branch as in a condition, where the value is
// known, and the last one gives it otherwise.
fn gen_logical(g: *Gen, e: *ast.Expr) {
    var l = Logical { yes: label(g), no: label(g), end: label(g), first: true };
    save_checked(g, &l.saved);
    var x = e;
    while (is_logical(x)) {
        branch_operand(g, &l, x.left, x.op);
        x = x.right;
    }
    gen_expr(g, x);
    if (l.to_yes || l.to_no) {
        emitd(g, "    JMP .L%d\n", []int { l.end });
    }
    if (l.to_yes) {
        emitd(g, ".L%d:\n    LOAD R0, #1\n", []int { l.yes });
    }
    if (l.to_yes && l.to_no) {
        emitd(g, "    JMP .L%d\n", []int { l.end });
    }
    if (l.to_no) {
        emitd(g, ".L%d:\n    LOAD R0, #0\n", []int { l.no });
    }
    merge_label(g, l.end, &l.saved, null, null);
}

// Branches on an operand of op that is not the last one, where it decides the value
fn branch_operand(g: *Gen, l: *Logical, e: *ast.Expr, op: ast.TokenKind) {
    if (e.kind == ast.ExprKind.BINARY && e.op == op) {
        branch_operand(g, l, e.left, op);
        branch_operand(g, l, e.right, op);
        return;
    }
    var when = op == ast.TokenKind.OROR;
    var fact = null_fact(e, !when);
    var known = fact != null && is_checked(g, fact);
    if (tests_value(e)) {
        // The value in R0 is already the one to make
        var jump = "JZ";
        if (when) {
            jump = "JNZ";
        }
        gen_expr(g, e);
        emitf(g, "    CMP R0, #0\n    %s .L%d\n", [][]u8 { jump }, []int { l.end });
    } else if (when) {
        gen_condition(g, e, l.yes, true);
        l.to_yes = true;
    } else {
        gen_condition(g, e, l.no, false);
        l.to_no = true;
    }
    // What the first operand checked before it branched holds wherever the value is made
    if (l.first && jumps_once(e)) {
        save_checked(g, &l.saved);
        for (var i = 0; i < l.saved.count && fact != null && !known; i += 1) {
            if (l.saved.items[i] == fact as *u8) {
                l.saved.count -= 1;
                l.saved.items[i] = l.saved.items[l.saved.count];
            }
        }
    }
    l.first = false;
}

// Compares two f32s so that the unsigned condition it returns holds when the comparison does; == and !=
// need two jumps and get none. Unordered operands set Z and C, so that A and AE do not hold.
fn float_compare(g: *Gen, e: *ast.Expr) []u8 {
    var left: []u8;
    var right: []u8;
    var register = register_of(e.left);
    if (register.ptr != null && is_operand(e.right)) {
        left = register;
        right = gen_operand(g, e.right);
    } else if (is_left_operand(e)) {
        left = gen_operand(g, e.left);
        gen_expr(g, e.right);
        right = "R0";
    } else {
        left = swap_operands(g, e);
        right = "R0";
        if (left.ptr == null) {
            right = operands(g, e);
            left = "R0";
        }
    }
    var first = left;
    var second = right;
    if (e.op == ast.TokenKind.LT || e.op == ast.TokenKind.LE) {
        first = right;
        second = left;
    }
    if (first[0] != 'R') {
        set_register(g, "R7", first);
        first = "R7";
    }
    emits(g, "    FCMP %s, %s\n", [][]u8 { first, second });
    var none: []u8;
    if (e.op == ast.TokenKind.GT || e.op == ast.TokenKind.LT) {
        return "A";
    }
    if (e.op == ast.TokenKind.GE || e.op == ast.TokenKind.LE) {
        return "AE";
    }
    return none;
}

// The x & y or x % 2^k that a comparison with 0 tests, or else nothing
fn tested_bits(e: *ast.Expr) *ast.Expr {
    if (!is_comparison(e) || e.op != ast.TokenKind.EQ && e.op != ast.TokenKind.NE || !e.right.is_const ||
        !wide.is_zero(e.right.value)) {
        return null;
    }
    var x = e.left;
    if (x.kind != ast.ExprKind.BINARY || x.type.kind != ast.TypeKind.INT) {
        return null;
    }
    if (x.op == ast.TokenKind.AMP || x.op == ast.TokenKind.PERCENT && x.right.is_const &&
        shift_of(wide.low(x.right.value)) > 0) {
        return x;
    }
    return null;
}

// Sets the zero flag from the bits that x & y or x % 2^k keeps
fn gen_test(g: *Gen, x: *ast.Expr) {
    var register = register_of(x.left);
    var operand: []u8;
    if (x.op == ast.TokenKind.PERCENT) {
        operand = constant_operand(wide.low(x.right.value) - 1);
        if (register.ptr == null) {
            gen_expr(g, x.left);
            register = "R0";
        }
    } else if (register.ptr != null && is_operand(x.right)) {
        operand = gen_operand(g, x.right);
    } else if (register_of(x.right).ptr != null && is_operand(x.left)) {
        register = register_of(x.right);
        operand = gen_operand(g, x.left);
    } else if (is_left_operand(x)) {
        operand = gen_operand(g, x.left);
        gen_expr(g, x.right);
        register = "R0";
    } else {
        register = swap_operands(g, x);
        operand = "R0";
        if (register.ptr == null) {
            operand = operands(g, x);
            register = "R0";
        }
    }
    emits(g, "    TEST %s, %s\n", [][]u8 { register, operand });
}

// Jumps to target unless the condition holds
fn gen_branch(g: *Gen, e: *ast.Expr, target: int) {
    gen_condition(g, e, target, false);
}

// Jumps to target when the condition is when, without making a value of &&, || and !
fn gen_condition(g: *Gen, e: *ast.Expr, target: int, when: bool) {
    if (e.is_const) {
        if (!wide.is_zero(e.value) == when) {
            emitd(g, "    JMP .L%d\n", []int { target });
        }
        return;
    }
    if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.BANG) {
        gen_condition(g, e.left, target, !when);
        return;
    }
    if (e.kind == ast.ExprKind.BINARY && (e.op == ast.TokenKind.ANDAND || e.op == ast.TokenKind.OROR)) {
        // The right side decides only when the left one did not
        if ((e.op == ast.TokenKind.ANDAND) != when) {
            gen_condition(g, e.left, target, when);
            gen_condition(g, e.right, target, when);
            return;
        }
        var skip = label(g);
        var saved: Checked;
        save_checked(g, &saved);
        gen_condition(g, e.left, skip, !when);
        gen_condition(g, e.right, target, when);
        merge_label(g, skip, &saved, null, null);
        return;
    }
    if (is_comparison(e) && e.left.type.kind == ast.TypeKind.FLOAT) {
        var code = float_compare(g, e);
        if (code.ptr != null) {
            if (!when && ast.same(code, "A")) {
                code = "BE";
            } else if (!when) {
                code = "B";
            }
            emitf(g, "    J%s .L%d\n", [][]u8 { code }, []int { target });
        } else if ((e.op == ast.TokenKind.NE) == when) {
            emitd(g, "    JNZ .L%d\n    JB .L%d\n", []int { target, target });
        } else {
            var skip = label(g);
            emitd(g, "    JNZ .L%d\n    JAE .L%d\n.L%d:\n", []int { skip, target, skip });
        }
        return;
    }
    var bits = tested_bits(e);
    if (bits != null) {
        gen_test(g, bits);
        emitf(g, "    J%s .L%d\n", [][]u8 { condition(e.op, e.left.type, !when) }, []int { target });
        return;
    }
    if (is_comparison(e) && check.is_scalar(e.left.type)) {
        var code = condition(e.op, e.left.type, !when);
        var register = register_of(e.left);
        if (register.ptr != null && is_operand(e.right)) {
            var operand = gen_operand(g, e.right);
            emitf(g, "    CMP %s, %s\n    J%s .L%d\n", [][]u8 { register, operand, code }, []int { target });
        } else if (is_left_operand(e)) {
            var operand = gen_operand(g, e.left);
            gen_expr(g, e.right);
            emitf(g, "    CMP R0, %s\n    J%s .L%d\n", [][]u8 { operand, condition(swapped(e.op), e.left.type, !when) },
                []int { target });
        } else {
            var held = swap_operands(g, e);
            if (held.ptr != null) {
                emitf(g, "    CMP %s, R0\n    J%s .L%d\n", [][]u8 { held, code }, []int { target });
            } else {
                var right = operands(g, e);
                emitf(g, "    CMP R0, %s\n    J%s .L%d\n", [][]u8 { right, code }, []int { target });
            }
        }
        note_not_null(g, e, !when);
        return;
    }
    var register = register_of(e);
    if (register.ptr != null) {
        emits(g, "    CMP %s, #0\n", [][]u8 { register });
    } else {
        gen_expr(g, e);
        emit(g, "    CMP R0, #0\n");
    }
    var jump = "JZ";
    if (when) {
        jump = "JNZ";
    }
    emitf(g, "    %s .L%d\n", [][]u8 { jump }, []int { target });
}

// Evaluates an argument into its place below SP
fn gen_argument(g: *Gen, arg: *ast.Expr, offset: int) {
    var t = arg.type;
    var register = register_of(arg);
    if (register.ptr != null) {
        emitf(g, "    STORE %s, [SP+%d]\n", [][]u8 { register }, []int { offset });
        return;
    }
    gen_expr(g, arg);
    if (t.kind == ast.TypeKind.SLICE) {
        emitd(g, "    STORE R0, [SP+%d]\n    STORE R5, [SP+%d]\n", []int { offset, offset + 4 });
    } else if (is_aggregate(t)) {
        if (t.size > 0) {
            emitd(g, "    LEA R6, [SP+%d]\n    MEMCPY R6, R0, #%d\n", []int { offset, t.size });
        }
    } else {
        emitd(g, "    STORE R0, [SP+%d]\n", []int { offset });
    }
}

// Pushes an argument that needs no code to compute; tells whether it was one
fn push_argument(g: *Gen, arg: *ast.Expr, emitting: bool) bool {
    if (arg.kind == ast.ExprKind.STRING || arg.kind == ast.ExprKind.NAME && arg.symbol.kind == ast.SymbolKind.CONST &&
        arg.symbol.string != null) {
        if (emitting) {
            push(g, constant_operand(string_size(arg)));
            push(g, string_of(g, arg));
        }
        return true;
    }
    if (arg.type.kind == ast.TypeKind.SLICE) {
        var held = slice_register(arg);
        if (held != 0) {
            if (emitting) {
                push(g, register_names[held + 1]);
                push(g, register_names[held]);
            }
            return true;
        }
        if (!in_register(arg) && place(arg).ptr == null) {
            return false;
        }
        if (emitting) {
            var base: []u8;
            var offset = 0;
            fixed_base(g, arg, &base, &offset);
            push(g, ast.cat([][]u8 { "[", relative(base, offset + 4), "]" }));
            push(g, ast.cat([][]u8 { "[", relative(base, offset), "]" }));
        }
        return true;
    }
    if (!is_operand(arg)) {
        return false;
    }
    if (emitting) {
        push(g, gen_operand(g, arg));
    }
    return true;
}

// A value that no call can change: a constant, a string, or a scalar or slice in a local whose address
// is never taken
fn is_stable(e: *ast.Expr) bool {
    if (e.is_const || e.kind == ast.ExprKind.NULL || e.kind == ast.ExprKind.STRING ||
        e.kind == ast.ExprKind.NAME && e.symbol.kind == ast.SymbolKind.CONST) {
        return true;
    }
    var x = e;
    if (x.kind == ast.ExprKind.LEN || x.kind == ast.ExprKind.PTR) {
        x = x.left;
    }
    return unshared(x) && (check.is_scalar(x.type) || x.type.kind == ast.TypeKind.SLICE);
}

// The one argument of a call that needs code, when the others can go on the stack before and after it
// without a change to what they are or to the order of their null checks, or -1
fn computed_argument(g: *Gen, e: *ast.Expr) int {
    var computed = -1;
    for (var i = 0; i < e.args.len; i += 1) {
        if (!push_argument(g, e.args[i], false)) {
            if (computed >= 0) {
                return -1;
            }
            computed = i;
        }
    }
    if (computed < 0 || is_aggregate(e.args[computed].type)) {
        return -1;
    }
    var calls = has_call(e.args[computed]);
    for (var i = 0; i < e.args.len; i += 1) {
        if (i > computed && in_register(e.args[i]) || i != computed && calls && !is_stable(e.args[i])) {
            return -1;
        }
    }
    return computed;
}

// An Ore function has removed its arguments as it returned; those of an extern function are left to its caller
fn called(g: *Gen, function: *ast.Type, size: int) {
    if (!function.is_extern) {
        stack.pushed -= size;
    } else if (size != 0) {
        drop(g, size);
    }
}

fn gen_call(g: *Gen, e: *ast.Expr) {
    var function = e.left.type;
    var result = function.base;
    var hidden = is_aggregate(result);
    var size = 0;
    if (hidden) {
        size = 4;
    }
    var direct = e.left.kind == ast.ExprKind.NAME && e.left.symbol.kind == ast.SymbolKind.FN;
    var temp = 0;

    for (var i = 0; i < function.params.len; i += 1) {
        size += words(function.params[i].size);
    }
    // Arguments that need no code go on the stack with PUSH, from the last one to the first, and so can
    // the others around one that does
    var pushed = direct;
    for (var i = 0; i < e.args.len && pushed; i += 1) {
        pushed = push_argument(g, e.args[i], false);
    }
    var computed = -1;
    if (direct && !pushed) {
        computed = computed_argument(g, e);
    }
    if (pushed || computed >= 0) {
        // The pointers that arguments go through are checked in the order of the arguments
        for (var i = 0; i < e.args.len; i += 1) {
            if (in_register(e.args[i])) {
                fixed_place(g, e.args[i]);
            }
        }
        for (var i = e.args.len - 1; i > computed; i -= 1) {
            push_argument(g, e.args[i], true);
        }
        if (computed >= 0) {
            gen_expr(g, e.args[computed]);
            if (e.args[computed].type.kind == ast.TypeKind.SLICE) {
                push(g, "R5");
            }
            push(g, "R0");
            for (var i = computed - 1; i >= 0; i -= 1) {
                push_argument(g, e.args[i], true);
            }
        }
        if (hidden) {
            temp = alloc_frame(g, result.size);
            emitd(g, "    LEA R0, [BP%+d]\n", []int { temp });
            push(g, "R0");
        }
        emits(g, "    CALL %s\n", [][]u8 { symbol_name(e.left.symbol) });
        called(g, function, size);
        if (hidden) {
            emitd(g, "    LEA R0, [BP%+d]\n", []int { temp });
        }
        return;
    }
    if (!direct) {
        gen_expr(g, e.left);
        push(g, "R0");
    }
    if (size != 0) {
        emitd(g, "    SUB SP, #%d\n", []int { size });
        stack.pushed += size;
    }
    var offset = 0;
    if (hidden) {
        temp = alloc_frame(g, result.size);
        emitd(g, "    LEA R0, [BP%+d]\n    STORE R0, [SP]\n", []int { temp });
        offset = 4;
    }
    for (var i = 0; i < e.args.len; i += 1) {
        gen_argument(g, e.args[i], offset);
        offset += words(function.params[i].size);
    }
    if (direct) {
        emits(g, "    CALL %s\n", [][]u8 { symbol_name(e.left.symbol) });
    } else {
        emitd(g, "    LOAD R6, [SP+%d]\n", []int { size });
        check_null(g, "R6");
        emit(g, "    CALL R6\n");
    }
    called(g, function, size);
    if (!direct) {
        drop(g, 4);
    }
    if (hidden) {
        emitd(g, "    LEA R0, [BP%+d]\n", []int { temp });
    }
}

fn gen_print(g: *Gen, e: *ast.Expr) {
    for (var i = 0; i < e.args.len; i += 1) {
        var t = e.args[i].type;
        gen_expr(g, e.args[i]);
        if (t.kind == ast.TypeKind.SLICE) {
            emit(g, "    MOVE R6, R5\n    MOVE R5, R0\n    LOAD R0, #1\n    SYSCALL #13\n");
        } else if (t.kind == ast.TypeKind.BOOL) {
            var done = label(g);
            emitd(g, "    LOAD R6, rt.false\n    CMP R0, #0\n    JZ .L%d\n    LOAD R6, rt.true\n.L%d:\n",
                []int { done, done });
            emit(g, "    MOVE R0, R6\n    SYSCALL #2\n");
        } else if (t.kind == ast.TypeKind.POINTER || t.kind == ast.TypeKind.FN) {
            emit(g, "    SYSCALL #5\n");
        } else if (t.kind == ast.TypeKind.FLOAT) {
            emit(g, "    SYSCALL #7\n");
        } else if (t.kind == ast.TypeKind.INT && !t.is_signed) {
            emit(g, "    LOAD R5, #10\n    SYSCALL #6\n");
        } else {
            emit(g, "    SYSCALL #1\n");
        }
    }
}

var syscall_registers = [3][]u8 { "R0", "R5", "R6" };

fn gen_builtin(g: *Gen, e: *ast.Expr) {
    switch (e.builtin) {
        case ast.Builtin.PRINT {
            gen_print(g, e);
        }
        case ast.Builtin.PANIC {
            gen_expr(g, e.args[0]);
            emit(g, "    PUSH R5\n    PUSH R0\n    CALL rt.panic\n");
        }
        case ast.Builtin.ASSERT {
            var ok = label(g);
            gen_expr(g, e.args[0]);
            emitd(g, "    CMP R0, #0\n    JNZ .L%d\n    CALL rt.assert_error\n.L%d:\n", []int { ok, ok });
        }
        case ast.Builtin.FREE {
            gen_expr(g, e.args[0]);
            emit(g, "    PUSH R0\n    CALL rt.free\n    ADD SP, #4\n");
        }
        case ast.Builtin.SYSCALL {
            gen_syscall(g, e);
            var temp = alloc_frame(g, 8);
            emitd(g, "    STORE R0, [BP%+d]\n    STORE R5, [BP%+d]\n    LEA R0, [BP%+d]\n", []int { temp, temp + 4, temp });
        }
    }
}

// Leaves the two words of the result in R0 and R5
// The one argument of a syscall that needs code, 0 when none does, or -1 when the others cannot go to their
// registers after it without a change to what they are or to the order of their null checks
fn computed_syscall_argument(e: *ast.Expr) int {
    var computed = 0;
    for (var i = 1; i < e.args.len; i += 1) {
        if (!is_operand(e.args[i])) {
            if (computed > 0) {
                return -1;
            }
            computed = i;
        }
    }
    var calls = computed > 0 && has_call(e.args[computed]);
    for (var i = 1; i < e.args.len && computed > 0; i += 1) {
        if (i < computed && in_register(e.args[i]) || i != computed && calls && !is_stable(e.args[i])) {
            return -1;
        }
    }
    return computed;
}

fn gen_syscall(g: *Gen, e: *ast.Expr) {
    // Arguments that need no code go to their registers directly, after the one that needs code
    var computed = computed_syscall_argument(e);
    if (computed > 0) {
        gen_expr(g, e.args[computed]);
        if (computed > 1) {
            emits(g, "    MOVE %s, R0\n", [][]u8 { syscall_registers[computed - 1] });
        }
    }
    for (var i = 1; i < e.args.len; i += 1) {
        if (computed < 0) {
            gen_expr(g, e.args[i]);
            push(g, "R0");
        } else if (i != computed) {
            set_register(g, syscall_registers[i - 1], gen_operand(g, e.args[i]));
        }
    }
    for (var i = e.args.len - 1; i >= 1 && computed < 0; i -= 1) {
        pop(g, syscall_registers[i - 1]);
    }
    emitd(g, "    SYSCALL #%d\n", []int { wide.low(e.args[0].value) });
}

fn has_call(e: *ast.Expr) bool {
    if (e == null) {
        return false;
    }
    if (e.kind == ast.ExprKind.CALL) {
        return true;
    }
    for (var i = 0; i < e.args.len; i += 1) {
        if (has_call(e.args[i])) {
            return true;
        }
    }
    return has_call(e.left) || has_call(e.right) || has_call(e.third);
}

// A local whose address is never taken, which only assignments in its function can change
fn unshared(e: *ast.Expr) bool {
    return e.kind == ast.ExprKind.NAME && e.symbol.kind == ast.SymbolKind.LOCAL && !e.symbol.address_taken;
}

// The local that an index reads, when only assignments in its function change it
fn index_local(e: *ast.Expr) *ast.Symbol {
    var x = e;
    if (x.kind == ast.ExprKind.CONVERT) {
        x = x.left;
    }
    if (unshared(x)) {
        return x.symbol;
    }
    return null;
}

// Whether a bound keeps the index local within the slice local or array that e indexes
fn covers(b: *Bound, index: *ast.Symbol, e: *ast.Expr) bool {
    return b.index == index && (b.slice != null && local_of(e.left) == b.slice ||
        b.slice == null && e.left.type.kind == ast.TypeKind.ARRAY && b.limit <= e.left.type.length);
}

// Whether the type of the index, a loop around or a check before keeps it within what it indexes
fn in_bounds(g: *Gen, e: *ast.Expr) bool {
    var index = e.right.type;
    if (e.right.kind == ast.ExprKind.CONVERT) {
        index = e.right.left.type;
    }
    if (e.left.type.kind == ast.TypeKind.ARRAY && index.kind == ast.TypeKind.INT && !index.is_signed &&
        index.size < 4 && e.left.type.length >= 1 << 8 * index.size) {
        return true;
    }
    var local = index_local(e.right);
    for (var i = 0; i < g.bound_count && local != null; i += 1) {
        if (covers(&g.bounds[i], local, e)) {
            return true;
        }
    }
    for (var i = 0; i < g.range_count && local != null; i += 1) {
        if (covers(&g.ranges[i], local, e)) {
            return true;
        }
    }
    return false;
}

// Notes that the index of e passed its check, for the checks after it
fn note_in_range(g: *Gen, e: *ast.Expr) {
    var local = index_local(e.right);
    if (local == null || g.range_count == g.ranges.len || e.left.type.kind == ast.TypeKind.SLICE && !unshared(e.left)) {
        return;
    }
    var r = &g.ranges[g.range_count];
    r.index = local;
    r.slice = null;
    r.limit = e.left.type.length;
    if (e.left.type.kind == ast.TypeKind.SLICE) {
        r.slice = e.left.symbol;
    }
    g.range_count += 1;
}

// Leaves in R0 the address of an element, minus the displacement it returns, after checking the index
fn gen_index(g: *Gen, e: *ast.Expr) int {
    var t = e.left.type;
    var size = t.base.size;
    var ok = label(g);
    var safe = in_bounds(g, e);

    // A slice in registers keeps them across the code of the index
    var held = slice_register(e.left);
    if (held != 0) {
        gen_expr(g, e.right);
        if (!safe) {
            emitf(g, "    CMP R0, %s\n    JB .L%d\n    PUSH %s\n    PUSH R0\n    CALL rt.index_error\n.L%d:\n",
                [][]u8 { register_names[held + 1], register_names[held + 1] }, []int { ok, ok });
            note_in_range(g, e);
        }
        scale(g, size, "R0");
        emits(g, "    ADD R0, %s\n", [][]u8 { register_names[held] });
        return 0;
    }

    // An array or slice at a fixed place lets the index come first, where that cannot change the variable,
    // and then serves as a memory operand
    var base: []u8;
    var offset = 0;
    if ((t.kind == ast.TypeKind.ARRAY || t.kind == ast.TypeKind.SLICE && (!has_call(e.right) || unshared(e.left))) &&
        fixed_base(g, e.left, &base, &offset)) {
        var at = relative(base, offset);
        gen_expr(g, e.right);
        if (t.kind == ast.TypeKind.SLICE) {
            if (!safe) {
                emitf(g, "    CMP R0, [%s+4]\n    JB .L%d\n    PUSH [%s+4]\n    PUSH R0\n    CALL rt.index_error\n.L%d:\n",
                    [][]u8 { at, at }, []int { ok, ok });
                note_in_range(g, e);
            }
            scale(g, size, "R0");
            emits(g, "    ADD R0, [%s]\n", [][]u8 { at });
            return 0;
        }
        if (!e.right.is_const && !safe) {
            emitd(g, "    CMP R0, #%d\n    JB .L%d\n    PUSH #%d\n    PUSH R0\n    CALL rt.index_error\n.L%d:\n",
                []int { t.length, ok, t.length, ok });
            note_in_range(g, e);
        }
        scale(g, size, "R0");
        if (ast.same(base, "BP")) {
            emits(g, "    ADD R0, %s\n", [][]u8 { frame_base(offset) });
            return frame_offset(offset);
        }
        if (in_register(e.left)) {
            emits(g, "    ADD R0, %s\n", [][]u8 { base });
            return offset;
        }
        emits(g, "    ADD R0, %s\n", [][]u8 { at });
        return 0;
    }

    // An index that needs no code can go into R6 without saving the base
    if (is_operand(e.right)) {
        gen_expr(g, e.left);
        if (t.kind == ast.TypeKind.POINTER) {
            check_pointer(g, e.left, "R0");
        }
        if (t.kind == ast.TypeKind.ARRAY && e.right.is_const) {
            return wide.low(e.right.value) * size;
        }
        set_register(g, "R6", gen_operand(g, e.right));
        if (t.kind == ast.TypeKind.SLICE && !safe) {
            emitd(g, "    CMP R6, R5\n    JB .L%d\n    PUSH R5\n    PUSH R6\n    CALL rt.index_error\n.L%d:\n", []int { ok, ok });
            note_in_range(g, e);
        } else if (t.kind == ast.TypeKind.ARRAY && !safe) {
            emitd(g, "    CMP R6, #%d\n    JB .L%d\n    PUSH #%d\n    PUSH R6\n    CALL rt.index_error\n.L%d:\n",
                []int { t.length, ok, t.length, ok });
            note_in_range(g, e);
        }
        scale(g, size, "R6");
        emit(g, "    ADD R0, R6\n");
        return 0;
    }

    gen_expr(g, e.left);
    if (t.kind == ast.TypeKind.POINTER) {
        check_pointer(g, e.left, "R0");
    }
    push(g, "R0");
    if (t.kind == ast.TypeKind.SLICE) {
        push(g, "R5");
    }
    gen_expr(g, e.right);
    if (t.kind == ast.TypeKind.SLICE) {
        pop(g, "R7");
        pop(g, "R6");
    }
    if (t.kind == ast.TypeKind.SLICE && !safe) {
        emitd(g, "    CMP R0, R7\n    JB .L%d\n    PUSH R7\n    PUSH R0\n    CALL rt.index_error\n.L%d:\n",
            []int { ok, ok });
        note_in_range(g, e);
    } else if (t.kind != ast.TypeKind.SLICE) {
        pop(g, "R6");
        if (t.kind == ast.TypeKind.ARRAY && !e.right.is_const && !safe) {
            emitd(g, "    CMP R0, #%d\n    JB .L%d\n    PUSH #%d\n    PUSH R0\n    CALL rt.index_error\n.L%d:\n",
                []int { t.length, ok, t.length, ok });
            note_in_range(g, e);
        }
    }
    scale(g, size, "R0");
    emit(g, "    ADD R0, R6\n");
    return 0;
}

fn is_bound(e: *ast.Expr) bool {
    return e == null || is_operand(e);
}

// Leaves the pointer in R0 and the length in R5
fn gen_slice(g: *Gen, e: *ast.Expr) {
    var t = e.left.type;
    var failed = label(g);
    var ok = label(g);

    // An array or slice at a fixed place or in registers with bounds that need no code takes them as operands
    var at: []u8;
    var held = slice_register(e.left);
    if (t.kind != ast.TypeKind.POINTER && is_bound(e.right) && is_bound(e.third)) {
        if (held != 0) {
            at = register_names[held];
        } else {
            at = fixed_place(g, e.left);
        }
    }
    if (at.ptr != null) {
        var length = ast.cat([][]u8 { "[", at, "+4]" });
        if (t.kind == ast.TypeKind.ARRAY) {
            length = ast.cat([][]u8 { "#", ast.number(t.length) });
        } else if (held != 0) {
            length = register_names[held + 1];
        }
        var low = "#0";
        if (e.right != null) {
            low = gen_operand(g, e.right);
        }
        if (e.third != null) {
            set_register(g, "R5", gen_operand(g, e.third));
        } else {
            set_register(g, "R5", length);
        }
        var from_start = ast.same(low, "#0");
        if (e.third != null && !from_start) {
            emitf(g, "    CMP R5, %s\n    JA .L%d\n    CMP R5, %s\n    JAE .L%d\n", [][]u8 { length, low },
                []int { failed, ok });
        } else if (e.third != null) {
            emitf(g, "    CMP R5, %s\n    JBE .L%d\n", [][]u8 { length }, []int { ok });
        } else if (!from_start) {
            emitf(g, "    CMP R5, %s\n    JAE .L%d\n", [][]u8 { low }, []int { ok });
        }
        if (e.third != null || !from_start) {
            // The pushes before it move SP, which a bound in the frame may count from
            var pushed_low = low;
            if (low[0] == '[') {
                pushed_low = "R7";
            }
            emitd(g, ".L%d:\n", []int { failed });
            if (low[0] == '[') {
                emits(g, "    LOAD R7, %s\n", [][]u8 { low });
            }
            emitf(g, "    PUSH %s\n    PUSH R5\n    PUSH %s\n    CALL rt.slice_error\n.L%d:\n",
                [][]u8 { length, pushed_low }, []int { ok });
        }
        if (t.kind == ast.TypeKind.ARRAY) {
            load_from(g, t, at);
        } else if (held != 0) {
            emits(g, "    MOVE R0, %s\n", [][]u8 { at });
        } else {
            emits(g, "    LOAD R0, [%s]\n", [][]u8 { at });
        }
        if (from_start) {
            return;
        }
        emits(g, "    SUB R5, %s\n", [][]u8 { low });
        var size = t.base.size;
        if (e.right.is_const) {
            emitd(g, "    ADD R0, #%d\n", []int { wide.low(e.right.value) * size });
        } else if (size == 1) {
            emits(g, "    ADD R0, %s\n", [][]u8 { low });
        } else {
            set_register(g, "R7", low);
            scale(g, size, "R7");
            emit(g, "    ADD R0, R7\n");
        }
        return;
    }

    if (t.kind == ast.TypeKind.ARRAY) {
        gen_addr(g, e.left);
        push(g, "R0");
        push(g, constant_operand(t.length));
    } else {
        gen_expr(g, e.left);
        if (t.kind == ast.TypeKind.POINTER) {
            check_pointer(g, e.left, "R0");
            push(g, "R0");
            push(g, "#-1");
        } else {
            push(g, "R0");
            push(g, "R5");
        }
    }
    if (e.right != null) {
        gen_expr(g, e.right);
        push(g, "R0");
    } else {
        push(g, "#0");
    }
    if (e.third != null) {
        gen_expr(g, e.third);
    } else {
        emit(g, "    LOAD R0, [SP+4]\n");
    }
    pop(g, "R7");
    pop(g, "R6");
    if (t.kind != ast.TypeKind.POINTER) {
        emitd(g, "    CMP R0, R6\n    JA .L%d\n", []int { failed });
    }
    emitd(g, "    CMP R7, R0\n    JBE .L%d\n.L%d:\n    PUSH R6\n    PUSH R0\n    PUSH R7\n    CALL rt.slice_error\n.L%d:\n",
        []int { ok, failed, ok });
    emit(g, "    MOVE R5, R0\n    SUB R5, R7\n");
    scale(g, t.base.size, "R7");
    pop(g, "R0");
    emit(g, "    ADD R0, R7\n");
}

// Builds a struct, array or slice literal in a temporary of the frame
fn gen_literal(g: *Gen, e: *ast.Expr) {
    var t = e.type;
    var storage = t;
    var array = ast.Type {};
    if (t.kind == ast.TypeKind.SLICE) {
        array = ast.Type {
            kind: ast.TypeKind.ARRAY, base: t.base, length: e.args.len, size: e.args.len * t.base.size,
            align: t.base.align,
        };
        storage = &array;
    }
    var temp = alloc_frame(g, storage.size);
    zero(g, storage, temp);
    fill(g, e, temp);
    emitd(g, "    LEA R0, [BP%+d]\n", []int { temp });
    if (t.kind == ast.TypeKind.SLICE) {
        emitd(g, "    LOAD R5, #%d\n", []int { e.args.len });
    }
}

fn is_literal(e: *ast.Expr) bool {
    return (e.kind == ast.ExprKind.STRUCT || e.kind == ast.ExprKind.ARRAY) && e.type.kind != ast.TypeKind.SLICE;
}

// Stores the values of a literal in zeroed memory of the frame, or of a slice literal its elements
fn fill(g: *Gen, e: *ast.Expr, at: int) {
    var t = e.type;
    for (var i = 0; i < e.args.len; i += 1) {
        var field = t.base;
        var offset = at;
        if (e.kind == ast.ExprKind.STRUCT) {
            for (var k = 0; k < t.fields.len; k += 1) {
                if (ast.same(t.fields[k].name, e.fields[i])) {
                    field = t.fields[k].type;
                    offset += t.fields[k].offset;
                }
            }
        } else {
            offset += i * t.base.size;
        }
        if (is_literal(e.args[i])) {
            fill(g, e.args[i], offset);
        } else {
            gen_expr(g, e.args[i]);
            store_to(g, field, local_place(offset));
        }
    }
}

fn gen_new(g: *Gen, e: *ast.Expr) {
    var size = e.named.size;
    if (e.left == null) {
        emitd(g, "    PUSH #%d\n    CALL rt.alloc\n    ADD SP, #4\n", []int { size });
        return;
    }
    gen_expr(g, e.left);
    push(g, "R0");
    scale(g, size, "R0");
    push(g, "R0");
    emit(g, "    CALL rt.alloc\n");
    drop(g, 4);
    pop(g, "R5");
}

// A place at a fixed offset from a pointer in a register
fn in_register(e: *ast.Expr) bool {
    switch (e.kind) {
        case ast.ExprKind.FIELD {
            if (e.field == null) {
                return false;
            }
            if (e.left.type.kind == ast.TypeKind.POINTER) {
                return register_of(e.left).ptr != null;
            }
            return in_register(e.left);
        }
        case ast.ExprKind.UNARY {
            return e.op == ast.TokenKind.STAR && register_of(e.left).ptr != null;
        }
        case ast.ExprKind.INDEX {
            return e.left.type.kind == ast.TypeKind.ARRAY && e.right.is_const && in_register(e.left);
        }
        case ast.ExprKind.LEN, ast.ExprKind.PTR {
            return in_register(e.left);
        }
    }
    return false;
}

// Finds where instructions can address e without code: in a variable, or through a pointer in a register
// once the pointer is checked, which this emits
fn fixed_base(g: *Gen, e: *ast.Expr, base: *[]u8, offset: *int) bool {
    if (!in_register(e)) {
        return find_place(e, base, offset);
    }
    if (e.kind == ast.ExprKind.LEN || e.kind == ast.ExprKind.PTR) {
        *offset = gen_address(g, e.left, base);
        if (e.kind == ast.ExprKind.LEN) {
            *offset += 4;
        }
        return true;
    }
    *offset = gen_address(g, e, base);
    return true;
}

fn fixed_place(g: *Gen, e: *ast.Expr) []u8 {
    var none: []u8;
    var base: []u8;
    var offset = 0;
    if (!fixed_base(g, e, &base, &offset)) {
        return none;
    }
    return relative(base, offset);
}

// A value that an instruction can take, if need be once the pointer it goes through is checked
fn is_operand(e: *ast.Expr) bool {
    return simple_operand(e).ptr != null || in_register(e) && check.is_scalar(e.type) && e.type.size == 4;
}

// The operand for a value that is_operand accepts, after the null check it needs
fn gen_operand(g: *Gen, e: *ast.Expr) []u8 {
    var simple = simple_operand(e);
    if (simple.ptr != null) {
        return simple;
    }
    return ast.cat([][]u8 { "[", fixed_place(g, e), "]" });
}

// Leaves the pointer x in a register, R0 unless a local holds it, and checks it
fn gen_pointer(g: *Gen, x: *ast.Expr, base: *[]u8) {
    var register = register_of(x);
    if (register.ptr != null) {
        *base = register;
    } else {
        gen_expr(g, x);
    }
    check_pointer(g, x, *base);
}

// Leaves the base of the address of a place in a register, R0 unless a local holds it, and returns the
// offset from it, which loads and stores can take as a displacement
fn gen_address(g: *Gen, e: *ast.Expr, base: *[]u8) int {
    *base = "R0";
    if (e.kind == ast.ExprKind.FIELD && e.field != null) {
        if (e.left.type.kind == ast.TypeKind.POINTER) {
            gen_pointer(g, e.left, base);
            return e.field.offset;
        }
        return gen_address(g, e.left, base) + e.field.offset;
    }
    if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.STAR) {
        gen_pointer(g, e.left, base);
        return 0;
    }
    if (e.kind == ast.ExprKind.INDEX) {
        if (in_register(e)) {
            return gen_address(g, e.left, base) + wide.low(e.right.value) * e.left.type.base.size;
        }
        return gen_index(g, e);
    }
    if (e.kind == ast.ExprKind.NAME) {
        if (e.symbol.reg != 0) {
            ast.fail(g.m, e.line, "a variable in a register has no address (internal error)");
        }
        if (e.symbol.kind == ast.SymbolKind.LOCAL) {
            emits(g, "    LEA R0, [%s]\n", [][]u8 { local_place(e.symbol.offset) });
        } else {
            emits(g, "    LOAD R0, %s\n", [][]u8 { symbol_name(e.symbol) });
        }
        return 0;
    }
    // Aggregates evaluate to their address
    gen_expr(g, e);
    return 0;
}

fn gen_addr(g: *Gen, e: *ast.Expr) {
    var base: []u8;
    var offset = gen_address(g, e, &base);
    if (offset != 0 || !ast.same(base, "R0")) {
        emits(g, "    LEA R0, [%s]\n", [][]u8 { relative(base, offset) });
    }
}

// Converts the value in R0 from one scalar type to another. ITOF and FTOI take signed integers, so u32
// values from 2^31 on go through a smaller value: halved with the lost bit kept for rounding, or less 2^31.
fn convert(g: *Gen, from: *ast.Type, to: *ast.Type) {
    var big = 0;
    var done = 0;
    if (from.kind == ast.TypeKind.INT && to.kind == ast.TypeKind.FLOAT && from.size == 4 && !from.is_signed) {
        big = label(g);
        done = label(g);
        emitd(g, "    CMP R0, #0\n    JL .L%d\n    ITOF R0, R0\n    JMP .L%d\n", []int { big, done });
        emitd(g, ".L%d:\n    MOVE R6, R0\n    AND R6, #1\n    SHR R0, #1\n    OR R0, R6\n    ITOF R0, R0\n    FADD R0, R0\n.L%d:\n",
            []int { big, done });
    } else if (from.kind == ast.TypeKind.INT && to.kind == ast.TypeKind.FLOAT) {
        emit(g, "    ITOF R0, R0\n");
    } else if (from.kind == ast.TypeKind.FLOAT && to.kind == ast.TypeKind.INT && to.size == 4 && !to.is_signed) {
        big = label(g);
        done = label(g);
        emitd(g, "    FCMP R0, #0x4F000000\n    JAE .L%d\n    FTOI R0, R0\n    JMP .L%d\n", []int { big, done });
        emitd(g, ".L%d:\n    FSUB R0, #0x4F000000\n    FTOI R0, R0\n    XOR R0, #0x80000000\n.L%d:\n", []int { big, done });
    } else if (from.kind == ast.TypeKind.FLOAT && to.kind == ast.TypeKind.INT) {
        emit(g, "    FTOI R0, R0\n");
        normalize(g, to);
    } else {
        normalize(g, to);
    }
}

fn gen_expr(g: *Gen, e: *ast.Expr) {
    var t = e.type;

    if (e.is_const && check.is_scalar(t)) {
        emitd(g, "    LOAD R0, #%d\n", []int { wide.low(e.value) });
        return;
    }
    switch (e.kind) {
        case ast.ExprKind.NAME {
            if (e.symbol.reg != 0 && t.kind == ast.TypeKind.SLICE) {
                emits(g, "    MOVE R0, %s\n    MOVE R5, %s\n",
                    [][]u8 { register_names[e.symbol.reg], register_names[e.symbol.reg + 1] });
            } else if (e.symbol.reg != 0) {
                emits(g, "    MOVE R0, %s\n", [][]u8 { register_names[e.symbol.reg] });
            } else if (e.symbol.kind == ast.SymbolKind.CONST) {
                gen_string(g, e);
            } else if (e.symbol.kind == ast.SymbolKind.FN) {
                emits(g, "    LOAD R0, %s\n", [][]u8 { symbol_name(e.symbol) });
            } else {
                load_from(g, t, place(e));
            }
        }
        case ast.ExprKind.FIELD, ast.ExprKind.INDEX {
            var at = place(e);
            if (at.ptr == null) {
                var base: []u8;
                var offset = gen_address(g, e, &base);
                at = relative(base, offset);
            }
            load_from(g, t, at);
        }
        case ast.ExprKind.CALL {
            if (e.builtin != ast.Builtin.NONE) {
                gen_builtin(g, e);
            } else {
                gen_call(g, e);
            }
        }
        case ast.ExprKind.BINARY {
            gen_binary(g, e);
        }
        case ast.ExprKind.NULL {
            emit(g, "    LOAD R0, #0\n");
        }
        case ast.ExprKind.STRING {
            gen_string(g, e);
        }
        case ast.ExprKind.CONVERT {
            gen_expr(g, e.left);
            if (e.left.type.kind == ast.TypeKind.ARRAY) {
                emitd(g, "    LOAD R5, #%d\n", []int { e.left.type.length });
            } else if (t.kind == ast.TypeKind.FLOAT) {
                emit(g, "    ITOF R0, R0\n");
            }
        }
        case ast.ExprKind.LEN {
            if (field_register(e).ptr != null) {
                emits(g, "    MOVE R0, %s\n", [][]u8 { field_register(e) });
                return;
            }
            var at = fixed_place(g, e);
            if (at.ptr != null) {
                emits(g, "    LOAD R0, [%s]\n", [][]u8 { at });
                return;
            }
            gen_expr(g, e.left);
            emit(g, "    MOVE R0, R5\n");
        }
        case ast.ExprKind.PTR {
            if (field_register(e).ptr != null) {
                emits(g, "    MOVE R0, %s\n", [][]u8 { field_register(e) });
                return;
            }
            var at = fixed_place(g, e);
            if (at.ptr != null) {
                emits(g, "    LOAD R0, [%s]\n", [][]u8 { at });
                return;
            }
            gen_expr(g, e.left);
        }
        case ast.ExprKind.UNARY {
            if (e.op == ast.TokenKind.AMP) {
                gen_addr(g, e.left);
                return;
            }
            if (e.op == ast.TokenKind.STAR) {
                var base: []u8;
                var offset = gen_address(g, e, &base);
                load_from(g, t, relative(base, offset));
                return;
            }
            gen_expr(g, e.left);
            if (e.op == ast.TokenKind.BANG) {
                emit(g, "    XOR R0, #1\n");
            } else if (e.op == ast.TokenKind.MINUS && t.kind == ast.TypeKind.FLOAT) {
                emit(g, "    FNEG R0\n");
            } else if (e.op == ast.TokenKind.MINUS) {
                emit(g, "    NEG R0\n");
                normalize(g, t);
            } else {
                emit(g, "    NOT R0\n");
                normalize(g, t);
            }
        }
        case ast.ExprKind.SLICE {
            gen_slice(g, e);
        }
        case ast.ExprKind.CAST {
            gen_expr(g, e.left);
            convert(g, e.left.type, t);
        }
        case ast.ExprKind.STRUCT, ast.ExprKind.ARRAY {
            gen_literal(g, e);
        }
        case ast.ExprKind.NEW {
            gen_new(g, e);
        }
        default {
            ast.fail(g.m, e.line, "cannot generate code for this expression (internal error)");
        }
    }
}

// x op= y works like x = x op y
fn compound(op: ast.TokenKind) ast.TokenKind {
    switch (op) {
        case ast.TokenKind.ADD_ASSIGN {
            return ast.TokenKind.PLUS;
        }
        case ast.TokenKind.SUB_ASSIGN {
            return ast.TokenKind.MINUS;
        }
        case ast.TokenKind.MUL_ASSIGN {
            return ast.TokenKind.STAR;
        }
        case ast.TokenKind.DIV_ASSIGN {
            return ast.TokenKind.SLASH;
        }
        case ast.TokenKind.MOD_ASSIGN {
            return ast.TokenKind.PERCENT;
        }
        case ast.TokenKind.AND_ASSIGN {
            return ast.TokenKind.AMP;
        }
        case ast.TokenKind.OR_ASSIGN {
            return ast.TokenKind.PIPE;
        }
        case ast.TokenKind.XOR_ASSIGN {
            return ast.TokenKind.CARET;
        }
        case ast.TokenKind.SHL_ASSIGN {
            return ast.TokenKind.SHL;
        }
    }
    return ast.TokenKind.SHR;
}

// Sets a register to a value that needs no code, or else to R0
fn set_register(g: *Gen, register: []u8, operand: []u8) {
    if (operand[0] == 'R') {
        emits(g, "    MOVE %s, %s\n", [][]u8 { register, operand });
    } else {
        emits(g, "    LOAD %s, %s\n", [][]u8 { register, operand });
    }
}

// Computes x op y of type t in a register when neither x nor y needs code and y is not that register;
// tells whether it did
fn compute_into(g: *Gen, e: *ast.Expr, t: *ast.Type, register: []u8) bool {
    if (e.kind != ast.ExprKind.BINARY || !is_arithmetic(e.op) || e.type != t || t.kind != ast.TypeKind.INT ||
        e.is_const || !is_operand(e.left) || !is_operand(e.right) || ast.same(register_of(e.right), register)) {
        return false;
    }
    set_register(g, register, gen_operand(g, e.left));
    arithmetic_on(g, register, e.op, t, gen_operand(g, e.right));
    return true;
}

// An assignment to a variable in a register, where x op= y and x = x op y work on the register
fn gen_register_assign(g: *Gen, s: *ast.Stmt, register: []u8) {
    var t = s.target.type;
    var value = s.value;
    var op = ast.TokenKind.ASSIGN;
    if (s.op != ast.TokenKind.ASSIGN) {
        op = compound(s.op);
    } else if (value.kind == ast.ExprKind.BINARY && is_arithmetic(value.op) && value.type == t &&
               value.left.kind == ast.ExprKind.NAME && value.left.symbol == s.target.symbol && !value.is_const) {
        op = value.op;
        value = value.right;
    }
    var operand: []u8;
    if (is_operand(value)) {
        operand = gen_operand(g, value);
    }
    if (op == ast.TokenKind.ASSIGN) {
        if (operand.ptr != null) {
            set_register(g, register, operand);
        } else if (!load_value(g, value, register) && !compute_into(g, value, t, register)) {
            gen_expr(g, value);
            emits(g, "    MOVE %s, R0\n", [][]u8 { register });
        }
        return;
    }
    if (t.kind == ast.TypeKind.POINTER) {
        if (value.is_const) {
            operand = ast.cat([][]u8 { "#", ast.number(wide.low(value.value) * t.base.size) });
        } else if (t.base.size != 1) {
            operand = operand[:0];
        }
    }
    if (operand.ptr == null || operand.len == 0) {
        gen_expr(g, value);
        if (t.kind == ast.TypeKind.POINTER) {
            scale(g, t.base.size, "R0");
        }
        operand = "R0";
    }
    arithmetic_on(g, register, op, t, operand);
}

fn gen_assign(g: *Gen, s: *ast.Stmt) {
    gen_store(g, s);
    assigned(g, s.target, s.value);
}

fn gen_store(g: *Gen, s: *ast.Stmt) {
    var t = s.target.type;
    var pair = slice_register(s.target);
    if (pair != 0) {
        gen_expr(g, s.value);
        emits(g, "    MOVE %s, R0\n    MOVE %s, R5\n", [][]u8 { register_names[pair], register_names[pair + 1] });
        return;
    }
    var register = register_of(s.target);
    if (register.ptr != null) {
        gen_register_assign(g, s, register);
        return;
    }

    // x op= y with a y that needs no code works on x directly, as scaled for a pointer, and x = y with a
    // scalar y that needs no code stores y from a register
    var simple = s.op != ast.TokenKind.ASSIGN && is_operand(s.value) && (t.kind != ast.TypeKind.POINTER || s.value.is_const);
    var direct = s.op == ast.TokenKind.ASSIGN && check.is_scalar(t) && is_operand(s.value);

    // An address computed in R0 moves to R6, or is kept while code computes the value
    var target = place(s.target);
    var pushed = false;
    var held: []u8;
    if (target.ptr == null) {
        var base: []u8;
        var offset = gen_address(g, s.target, &base);
        if (ast.same(base, "R0") && !direct) {
            base = "R6";
            if (simple) {
                emit(g, "    MOVE R6, R0\n");
            } else {
                held = hold(g);
                pushed = true;
                if (held.ptr != null) {
                    base = held;
                }
            }
        }
        target = relative(base, offset);
    }
    if (direct) {
        var value = gen_operand(g, s.value);
        if (value[0] != 'R') {
            set_register(g, "R7", value);
            value = "R7";
        }
        store_from(g, t, value, target);
        return;
    }
    if (simple) {
        var operand = gen_operand(g, s.value);
        if (t.kind == ast.TypeKind.POINTER) {
            operand = ast.cat([][]u8 { "#", ast.number(wide.low(s.value.value) * t.base.size) });
        }
        load_from(g, t, target);
        arithmetic(g, compound(s.op), t, operand);
        store_to(g, t, target);
        return;
    }

    gen_expr(g, s.value);
    if (s.op == ast.TokenKind.ASSIGN) {
        if (pushed) {
            release(g, held);
        }
        store_to(g, t, target);
        return;
    }
    if (t.kind == ast.TypeKind.POINTER) {
        scale(g, t.base.size, "R0");
    }
    emit(g, "    MOVE R7, R0\n");
    if (pushed) {
        release(g, held);
    }
    load_from(g, t, target);
    arithmetic(g, compound(s.op), t, "R7");
    store_to(g, t, target);
}

fn gen_variable(g: *Gen, s: *ast.Stmt) {
    if (s.kind == ast.StmtKind.CONST) {
        return;
    }
    gen_declared(g, s);
    var name = ast.Expr { kind: ast.ExprKind.NAME, symbol: s.symbol };
    assigned(g, &name, s.value);
}

fn gen_declared(g: *Gen, s: *ast.Stmt) {
    var sym = s.symbol;
    if (sym.reg != 0 && sym.type.kind == ast.TypeKind.SLICE) {
        var pointer = register_names[sym.reg];
        var length = register_names[sym.reg + 1];
        if (s.value == null) {
            emits(g, "    LOAD %s, #0\n    LOAD %s, #0\n", [][]u8 { pointer, length });
        } else {
            gen_expr(g, s.value);
            emits(g, "    MOVE %s, R0\n    MOVE %s, R5\n", [][]u8 { pointer, length });
        }
        return;
    }
    if (sym.reg != 0) {
        var register = register_names[sym.reg];
        if (s.value == null) {
            emits(g, "    LOAD %s, #0\n", [][]u8 { register });
            return;
        }
        if (is_operand(s.value)) {
            set_register(g, register, gen_operand(g, s.value));
        } else if (!load_value(g, s.value, register) && !compute_into(g, s.value, sym.type, register)) {
            gen_expr(g, s.value);
            emits(g, "    MOVE %s, R0\n", [][]u8 { register });
        }
        return;
    }
    sym.offset = alloc_frame(g, sym.type.size);
    if (s.value == null) {
        zero(g, sym.type, sym.offset);
        return;
    }
    // A literal goes where the variable is, which it cannot refer to
    if (is_literal(s.value) && s.value.type.size == sym.type.size) {
        zero(g, sym.type, sym.offset);
        fill(g, s.value, sym.offset);
        return;
    }
    gen_expr(g, s.value);
    store_to(g, sym.type, local_place(sym.offset));
}

// The case of a switch with a value, or else -1
fn case_of(s: *ast.Stmt, value: int) int {
    for (var i = 0; i < s.cases.len; i += 1) {
        var values = s.cases[i].values;
        for (var v = 0; v < values.len; v += 1) {
            if (wide.low(values[v].value) == value) {
                return i;
            }
        }
    }
    return -1;
}

// Jumps through a table to the case of the value in R0, whose labels count up from first, or else to otherwise,
// when the switch has enough values close together; tells whether it did
fn gen_table(g: *Gen, s: *ast.Stmt, first: int, otherwise: int) bool {
    var count = 0;
    var low = 0;
    var high = 0;
    for (var i = 0; i < s.cases.len; i += 1) {
        var values = s.cases[i].values;
        for (var v = 0; v < values.len; v += 1) {
            var value = wide.low(values[v].value);
            if (count == 0 || value < low) {
                low = value;
            }
            if (count == 0 || value > high) {
                high = value;
            }
            count += 1;
        }
    }
    if (count < 4 || (high - low) as u32 >= (4 * count) as u32) {
        return false;
    }
    var table = label(g);
    if (low != 0) {
        emitd(g, "    SUB R0, #%d\n", []int { low });
    }
    emitd(g, "    CMP R0, #%d\n    JAE .L%d\n    SHL R0, #2\n", []int { high - low + 1, otherwise });
    emitf(g, "    JMP [R0+%s.L%d]\n", [][]u8 { g.scope }, []int { table });
    format(&g.tables, "    .align 4\n%s.L%d:\n", [][]u8 { g.scope }, []int { table });
    for (var k = 0; k <= high - low; k += 1) {
        var target = otherwise;
        var i = case_of(s, low + k);
        if (i >= 0) {
            target = first + i;
        }
        format(&g.tables, "    .dword %s.L%d\n", [][]u8 { g.scope }, []int { target });
    }
    return true;
}

fn gen_switch(g: *Gen, s: *ast.Stmt) {
    var end = label(g);
    var fallback = label(g);
    var first = g.labels + 1;
    g.labels += s.cases.len;

    gen_expr(g, s.cond);
    var saved: Checked;
    save_checked(g, &saved);
    var otherwise = end;
    if (s.fallback != null) {
        otherwise = fallback;
    }
    if (!gen_table(g, s, first, otherwise)) {
        for (var i = 0; i < s.cases.len; i += 1) {
            var values = s.cases[i].values;
            for (var v = 0; v < values.len; v += 1) {
                emitd(g, "    CMP R0, #%d\n    JZ .L%d\n", []int { wide.low(values[v].value), first + i });
            }
        }
        emitd(g, "    JMP .L%d\n", []int { otherwise });
    }
    for (var i = 0; i < s.cases.len; i += 1) {
        merge_label(g, first + i, &saved, null, null);
        gen_block(g, s.cases[i].body);
        emitd(g, "    JMP .L%d\n", []int { end });
    }
    if (s.fallback != null) {
        merge_label(g, fallback, &saved, null, null);
        gen_block(g, s.fallback);
    }
    merge_label(g, end, &saved, s, null);
}

// A for loop that counts an int local up by one from a constant of at least 0, while it is below the length
// of a slice local or below a constant, keeps it within those in its body, as long as the body does not
// assign either
fn loop_bound(s: *ast.Stmt, bound: *Bound) bool {
    if (s.kind != ast.StmtKind.FOR || s.init == null || s.step == null || s.cond == null ||
        s.cond.kind != ast.ExprKind.BINARY || s.cond.op != ast.TokenKind.LT || !unshared(s.cond.left) ||
        s.cond.left.type.kind != ast.TypeKind.INT || s.cond.left.type.size != 4 || !s.cond.left.type.is_signed) {
        return false;
    }
    var index = s.cond.left.symbol;
    var start: *ast.Expr = null;
    // Locals that step along with the index follow its own init and step
    var init = s.init;
    var step = s.step;
    if (init.kind == ast.StmtKind.BLOCK && init.body.len > 0) {
        init = init.body[0];
    }
    if (step.kind == ast.StmtKind.BLOCK && step.body.len > 0) {
        step = step.body[0];
    }
    if (init.kind == ast.StmtKind.VAR && init.symbol == index) {
        start = init.value;
    } else if (init.kind == ast.StmtKind.ASSIGN && init.op == ast.TokenKind.ASSIGN && local_of(init.target) == index) {
        start = init.value;
    }
    if (start == null || !start.is_const || start.value.hi != 0 || wide.low(start.value) < 0 ||
        step.kind != ast.StmtKind.ASSIGN || step.op != ast.TokenKind.ADD_ASSIGN || local_of(step.target) != index ||
        !step.value.is_const || step.value.value.hi != 0 || wide.low(step.value.value) != 1 || assigns(s.then, index as *u8)) {
        return false;
    }
    var limit = s.cond.right;
    bound.index = index;
    if (limit.kind == ast.ExprKind.LEN && unshared(limit.left) && !assigns(s.then, limit.left.symbol as *u8)) {
        bound.slice = limit.left.symbol;
        return true;
    }
    if (limit.is_const && limit.value.hi == 0 && wide.low(limit.value) >= 0) {
        bound.slice = null;
        bound.limit = wide.low(limit.value);
        return true;
    }
    return false;
}

// The condition comes before the loop and again after each round, which jumps back while it holds
fn gen_loop(g: *Gen, s: *ast.Stmt) {
    var top = label(g);
    var next = label(g);
    var end = label(g);
    var saved_break = g.break_label;
    var saved_continue = g.continue_label;

    if (s.init != null) {
        gen_stmt(g, s.init);
    }
    var saved: Checked;
    save_checked(g, &saved);
    // The condition before the loop knows only what holds again after each round, so what it finds on the
    // way into the body, the condition after each round finds as well
    keep_checked(g, &saved, s.then, s.step);
    if (s.cond != null) {
        loc(g, s.line);
        gen_branch(g, s.cond, end);
    }
    emitd(g, ".L%d:\n", []int { top });
    var passed: Checked;
    save_checked(g, &passed);
    g.break_label = end;
    g.continue_label = next;
    var bounded = g.bound_count < g.bounds.len && loop_bound(s, &g.bounds[g.bound_count]);
    if (bounded) {
        g.bound_count += 1;
    }
    gen_block(g, s.then);
    if (bounded) {
        g.bound_count -= 1;
    }
    g.break_label = saved_break;
    g.continue_label = saved_continue;
    merge_label(g, next, &passed, s.then, s.step);
    if (s.step != null) {
        gen_stmt(g, s.step);
    }
    if (s.cond != null) {
        loc(g, s.line);
        gen_condition(g, s.cond, top, true);
    } else {
        emitd(g, "    JMP .L%d\n", []int { top });
    }
    merge_label(g, end, &saved, s.then, s.step);
    // Without a break, the loop ends only where its condition fails, after all of it ran, so the indexes that
    // it checked on the way into the body are in range there as well
    if (s.cond != null && jumps_once(s.cond) && !breaks(s.then)) {
        for (var i = 0; i < passed.range_count; i += 1) {
            g.ranges[i] = passed.ranges[i];
        }
        g.range_count = passed.range_count;
    }
}

// Whether a statement has a break that leaves the loop around it
fn breaks(s: *ast.Stmt) bool {
    if (s == null) {
        return false;
    }
    switch (s.kind) {
        case ast.StmtKind.BREAK {
            return true;
        }
        case ast.StmtKind.BLOCK {
            for (var i = 0; i < s.body.len; i += 1) {
                if (breaks(s.body[i])) {
                    return true;
                }
            }
        }
        case ast.StmtKind.IF {
            return breaks(s.then) || breaks(s.otherwise);
        }
        case ast.StmtKind.SWITCH {
            for (var i = 0; i < s.cases.len; i += 1) {
                if (breaks(s.cases[i].body)) {
                    return true;
                }
            }
            return breaks(s.fallback);
        }
    }
    return false;
}

fn gen_stmt(g: *Gen, s: *ast.Stmt) {
    if (s.kind != ast.StmtKind.BLOCK) {
        loc(g, s.line);
    }
    switch (s.kind) {
        case ast.StmtKind.BLOCK {
            gen_block(g, s);
        }
        case ast.StmtKind.VAR, ast.StmtKind.CONST {
            gen_variable(g, s);
        }
        case ast.StmtKind.ASSIGN {
            gen_assign(g, s);
        }
        case ast.StmtKind.EXPR {
            if (s.value.kind == ast.ExprKind.CALL && s.value.builtin == ast.Builtin.SYSCALL) {
                gen_syscall(g, s.value);
            } else {
                gen_expr(g, s.value);
            }
        }
        case ast.StmtKind.IF {
            var otherwise = label(g);
            var end = label(g);
            var saved: Checked;
            save_checked(g, &saved);
            var fact = null_fact(s.cond, true);
            var known = fact != null && is_checked(g, fact);
            gen_branch(g, s.cond, otherwise);
            // What a condition that jumps once checked holds on both of its ways
            if (jumps_once(s.cond)) {
                save_checked(g, &saved);
                for (var i = 0; i < saved.count && fact != null && !known; i += 1) {
                    if (saved.items[i] == fact as *u8) {
                        saved.count -= 1;
                        saved.items[i] = saved.items[saved.count];
                    }
                }
            }
            gen_block(g, s.then);
            if (s.otherwise != null) {
                emitd(g, "    JMP .L%d\n", []int { end });
            }
            if (s.otherwise != null || !falls_through(s.then)) {
                // Only the condition leads there
                merge_label(g, otherwise, &saved, null, null);
                note_not_null(g, s.cond, false);
            } else {
                merge_label(g, otherwise, &saved, s.then, null);
            }
            if (s.otherwise != null) {
                gen_stmt(g, s.otherwise);
                merge_label(g, end, &saved, s.then, s.otherwise);
            }
        }
        case ast.StmtKind.WHILE, ast.StmtKind.FOR {
            gen_loop(g, s);
        }
        case ast.StmtKind.SWITCH {
            gen_switch(g, s);
        }
        case ast.StmtKind.BREAK {
            emitd(g, "    JMP .L%d\n", []int { g.break_label });
        }
        case ast.StmtKind.CONTINUE {
            emitd(g, "    JMP .L%d\n", []int { g.continue_label });
        }
        case ast.StmtKind.RETURN {
            if (s.value != null) {
                var t = s.value.type;
                gen_expr(g, s.value);
                if (is_aggregate(t) && t.size > 0) {
                    emitf(g, "    LOAD R6, %s\n    MEMCPY R6, R0, #%d\n    MOVE R0, R6\n", [][]u8 { local_operand(8) },
                        []int { t.size });
                } else if (is_aggregate(t)) {
                    emits(g, "    LOAD R0, %s\n", [][]u8 { local_operand(8) });
                }
            }
            if (g.return_count < g.returns.len) {
                g.returns[g.return_count] = g.body.len;
                g.return_count += 1;
            }
            emit(g, "    JMP .ret\n");
        }
    }
}

fn gen_block(g: *Gen, s: *ast.Stmt) {
    for (var i = 0; i < s.body.len; i += 1) {
        gen_stmt(g, s.body[i]);
    }
}

fn local_of(e: *ast.Expr) *ast.Symbol {
    if (e != null && e.kind == ast.ExprKind.NAME && e.symbol != null && e.symbol.kind == ast.SymbolKind.LOCAL) {
        return e.symbol;
    }
    return null;
}

fn is_simple(e: *ast.Expr) bool {
    return e.is_const || e.kind == ast.ExprKind.NULL || local_of(e) != null;
}

// A field or the target of a pointer in a local, which a register can serve as the base of
fn is_through_local(e: *ast.Expr) bool {
    return (e.kind == ast.ExprKind.FIELD && e.field != null && e.left.type.kind == ast.TypeKind.POINTER ||
        e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.STAR) && local_of(e.left) != null;
}

// Whether the function counted last makes a temporary in its frame: a literal, the result of a call that
// returns a struct or an array, or the result of a syscall
var makes_temporary: bool;

// What a register would save at each depth of values kept while others are computed, and the depth while
// counting
var temp_gains: [4]int;
var temp_depth: int;

// Where counting has got to in the function: a number that grows with each statement
var position: int;

// Notes that code reads or writes a local here, which therefore keeps its register until here
fn touch(s: *ast.Symbol) {
    if (s.live_to < position) {
        s.live_to = position;
    }
}

// The locals from before a loop that it reads or writes stay live to its end, since each round comes back to them
fn live_through(start: int, locals: *ast.List) {
    for (var i = 0; i < locals.count; i += 1) {
        var s = locals.items[i] as *ast.Symbol;
        if (s.live_from < start && s.live_to >= start) {
            s.live_to = position;
        }
    }
}

// Whether e is reached through a pointer in a local, as in_register finds it once the local has a register
fn through_local(e: *ast.Expr) bool {
    switch (e.kind) {
        case ast.ExprKind.FIELD {
            if (e.field == null) {
                return false;
            }
            if (e.left.type.kind == ast.TypeKind.POINTER) {
                return local_of(e.left) != null;
            }
            return through_local(e.left);
        }
        case ast.ExprKind.UNARY {
            return e.op == ast.TokenKind.STAR && local_of(e.left) != null;
        }
        case ast.ExprKind.INDEX {
            return e.left.type.kind == ast.TypeKind.ARRAY && e.right.is_const && through_local(e.left);
        }
        case ast.ExprKind.LEN, ast.ExprKind.PTR {
            return through_local(e.left);
        }
    }
    return false;
}

// Whether a value needs code before an instruction can take it, as far as counting can tell: 4 bytes at a
// place of their own or through a pointer in a local do not
fn needs_code(e: *ast.Expr) bool {
    if (is_simple(e)) {
        return false;
    }
    if (!check.is_scalar(e.type) || e.type.size != 4) {
        return true;
    }
    var base: []u8;
    var offset = 0;
    return !through_local(e) && !find_place(e, &base, &offset);
}

// Whether code keeps the left operand of e while it computes the right one, as far as counting can tell
fn holds_left(e: *ast.Expr) bool {
    return e.kind == ast.ExprKind.BINARY && e.op != ast.TokenKind.ANDAND && e.op != ast.TokenKind.OROR &&
        needs_code(e.right) && needs_code(e.left) && (is_comparison(e) || e.left.type.kind != ast.TypeKind.POINTER);
}

// Counts a value kept around the code of e, which a register keeps with one instruction less than the stack
fn count_held(e: *ast.Expr, weight: int) {
    if (temp_depth < temp_gains.len) {
        temp_gains[temp_depth] += weight;
    }
    temp_depth += 1;
    count_expr(e, weight);
    temp_depth -= 1;
}

// Estimates what registers would save in an expression, and notes the locals whose address it takes:
// comparing a local in a register, or reaching a field through one, takes one instruction less
fn count_expr(e: *ast.Expr, weight: int) {
    if (e == null) {
        return;
    }
    // Reading a scalar from a register spares a memory operand, which counts as a quarter of an instruction
    if (e.kind == ast.ExprKind.NAME && e.symbol != null && e.symbol.kind == ast.SymbolKind.LOCAL) {
        touch(e.symbol);
        if (check.is_scalar(e.type)) {
            e.symbol.gain += weight / 4;
        }
    }
    if (e.kind == ast.ExprKind.STRUCT || e.kind == ast.ExprKind.ARRAY ||
        e.kind == ast.ExprKind.CALL && (e.builtin == ast.Builtin.SYSCALL || is_aggregate(e.type))) {
        makes_temporary = true;
    }
    if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.AMP && local_of(e.left) != null) {
        e.left.symbol.address_taken = true;
    }
    if (is_comparison(e) && local_of(e.left) != null && is_simple(e.right) || is_through_local(e)) {
        e.left.symbol.gain += weight;
    }
    // Indexing an array or slice at a fixed place saves saving its address or its pointer and length
    if (e.kind == ast.ExprKind.INDEX && e.left.type.kind != ast.TypeKind.POINTER && is_through_local(e.left)) {
        e.left.left.symbol.gain += 3 * weight;
    }
    // A slice local in registers spares indexing two memory operands, and its length or pointer one, which
    // count as a quarter of an instruction each
    if (e.kind == ast.ExprKind.INDEX && e.left.type.kind == ast.TypeKind.SLICE && local_of(e.left) != null) {
        e.left.symbol.gain += weight / 2;
    } else if ((e.kind == ast.ExprKind.LEN || e.kind == ast.ExprKind.PTR) && local_of(e.left) != null) {
        e.left.symbol.gain += weight / 4;
    }
    if (e.left != null) {
        count_expr(e.left, weight);
    }
    if (e.kind == ast.ExprKind.BINARY && holds_left(e)) {
        count_held(e.right, weight);
    } else if (e.right != null) {
        count_expr(e.right, weight);
    }
    if (e.third != null) {
        count_expr(e.third, weight);
    }
    for (var i = 0; i < e.args.len; i += 1) {
        count_expr(e.args[i], weight);
    }
}

// Statements in loops count more, as they run more often. Updating a local in a register saves two
// instructions, and setting it to a simple value one.
fn count_stmt(s: *ast.Stmt, weight: int, locals: *ast.List) {
    if (s == null) {
        return;
    }
    var inner = weight;
    if (weight < 4096) {
        inner = weight * 8;
    }
    position += 1;
    switch (s.kind) {
        case ast.StmtKind.BLOCK {
            for (var i = 0; i < s.body.len; i += 1) {
                count_stmt(s.body[i], weight, locals);
            }
        }
        case ast.StmtKind.VAR {
            count_expr(s.value, weight);
            if (s.value == null || is_simple(s.value)) {
                s.symbol.gain += weight;
            }
            s.symbol.live_from = position;
            s.symbol.live_to = position;
            ast.add(locals, s.symbol as *u8);
        }
        case ast.StmtKind.ASSIGN {
            var target = local_of(s.target);
            var value = s.value;
            if (target != null) {
                if (s.op != ast.TokenKind.ASSIGN || value.kind == ast.ExprKind.BINARY && is_arithmetic(value.op) &&
                    local_of(value.left) == target) {
                    target.gain += 2 * weight;
                } else if (is_simple(value)) {
                    target.gain += weight;
                }
            } else if (is_through_local(s.target)) {
                s.target.left.symbol.gain += 2 * weight;
            }
            if (target != null) {
                touch(target);
            } else {
                count_expr(s.target, weight);
            }
            // The address of an element waits while the value is computed
            if (s.target.kind == ast.ExprKind.INDEX && needs_code(value)) {
                count_held(value, weight);
            } else {
                count_expr(value, weight);
            }
        }
        case ast.StmtKind.EXPR, ast.StmtKind.RETURN {
            // A syscall on its own leaves its result in registers
            if (s.kind == ast.StmtKind.EXPR && s.value.kind == ast.ExprKind.CALL && s.value.builtin == ast.Builtin.SYSCALL) {
                for (var i = 0; i < s.value.args.len; i += 1) {
                    count_expr(s.value.args[i], weight);
                }
            } else {
                count_expr(s.value, weight);
            }
        }
        case ast.StmtKind.IF {
            count_expr(s.cond, weight);
            count_stmt(s.then, weight, locals);
            count_stmt(s.otherwise, weight, locals);
        }
        case ast.StmtKind.WHILE {
            position += 1;
            var start = position;
            count_expr(s.cond, inner);
            count_stmt(s.then, inner, locals);
            live_through(start, locals);
        }
        case ast.StmtKind.FOR {
            count_stmt(s.init, weight, locals);
            position += 1;
            var start = position;
            count_expr(s.cond, inner);
            count_stmt(s.step, inner, locals);
            count_stmt(s.then, inner, locals);
            live_through(start, locals);
        }
        case ast.StmtKind.SWITCH {
            count_expr(s.cond, weight);
            for (var i = 0; i < s.cases.len; i += 1) {
                count_stmt(s.cases[i].body, weight, locals);
            }
            count_stmt(s.fallback, weight, locals);
        }
    }
}

// The locals that each of R8 to R15 holds, and the registers that values kept while others are computed take
var holders: [8]ast.List;
var kept: [8]bool;

// Whether a local can have R8 + r: the locals already there live at other times
fn fits(s: *ast.Symbol, r: int) bool {
    if (r >= 8 || kept[r]) {
        return false;
    }
    for (var i = 0; i < holders[r].count; i += 1) {
        var other = holders[r].items[i] as *ast.Symbol;
        if (other.live_from <= s.live_to && s.live_from <= other.live_to) {
            return false;
        }
    }
    return true;
}

// What a local gains from each register it takes, where it can have one
fn priority(s: *ast.Symbol) int {
    if (s.address_taken || s.gain <= 0) {
        return 0;
    }
    if (check.is_scalar(s.type)) {
        return s.gain;
    }
    if (s.type.kind == ast.TypeKind.SLICE) {
        return s.gain / 2;
    }
    return 0;
}

// Gives a local the lowest register, or pair of them for a slice, whose locals live at other times, as long
// as what it gains pays for saving and restoring the registers it opens; returns how many are open
fn place_local(s: *ast.Symbol, count: int) int {
    var size = 1;
    if (s.type.kind == ast.TypeKind.SLICE) {
        size = 2;
    }
    var r = 0;
    while (r + size <= 8 && (!fits(s, r) || size == 2 && !fits(s, r + 1))) {
        r += 1;
    }
    var opened = r + size - count;
    if (opened < 0) {
        opened = 0;
    }
    if (r + size > 8 || s.gain <= 2 * opened) {
        return count;
    }
    s.reg = 8 + r;
    for (var i = 0; i < size; i += 1) {
        ast.add(&holders[r + i], s as *u8);
    }
    if (r + size > count) {
        return r + size;
    }
    return count;
}

// Scalar locals and parameters whose address is not taken can live in R8 to R15, which calls keep, and so
// can the values kept at each depth while others are computed. Locals that live at different times share a
// register. A local gets one when it gains from it, and opens a register when it saves more than saving and
// restoring the register costs, and a parameter more than loading it as well. A slice takes two, which count
// half its gain each; a depth takes a register of its own. Returns how many registers from R8 on the
// function uses, and tells whether a local is left in memory.
fn assign_registers(d: *ast.Decl, in_memory: *bool) int {
    var locals = ast.List {};
    makes_temporary = false;
    for (var i = 0; i < temp_gains.len; i += 1) {
        temp_gains[i] = 0;
        temp_registers[i] = 0;
    }
    temp_depth = 0;
    position = 0;
    for (var i = 0; i < d.params.len; i += 1) {
        var param = d.params[i].symbol;
        param.gain = -1;
        if (param.type.kind == ast.TypeKind.SLICE) {
            param.gain = -2;
        }
        param.live_from = 0;
        param.live_to = 0;
        ast.add(&locals, param as *u8);
    }
    count_stmt(d.body, 1, &locals);

    // The locals that gain from a register, the most first
    var order = ast.List {};
    for (var i = 0; i < locals.count; i += 1) {
        var s = locals.items[i] as *ast.Symbol;
        if (priority(s) > 0) {
            ast.add(&order, s as *u8);
            var at = order.count - 1;
            while (at > 0 && priority(order.items[at - 1] as *ast.Symbol) < priority(s)) {
                order.items[at] = order.items[at - 1];
                at -= 1;
            }
            order.items[at] = s as *u8;
        }
    }
    for (var r = 0; r < 8; r += 1) {
        holders[r].count = 0;
        kept[r] = false;
    }
    var temps = temp_gains[0] > 2 || temp_gains[1] > 2 || temp_gains[2] > 2 || temp_gains[3] > 2;
    var decided: [4]bool;
    var count = 0;
    var next = 0;
    while (true) {
        var depth = -1;
        for (var i = 0; i < temp_gains.len && temps; i += 1) {
            if (!decided[i] && temp_gains[i] > 2 && (depth < 0 || temp_gains[i] > temp_gains[depth])) {
                depth = i;
            }
        }
        var s: *ast.Symbol = null;
        if (next < order.count) {
            s = order.items[next] as *ast.Symbol;
        }
        if (depth >= 0 && (s == null || temp_gains[depth] > priority(s))) {
            decided[depth] = true;
            if (count < 8) {
                temp_registers[depth] = 8 + count;
                kept[count] = true;
                count += 1;
            }
        } else if (s != null) {
            next += 1;
            count = place_local(s, count);
        } else {
            break;
        }
    }
    free(order.items);
    *in_memory = makes_temporary;
    for (var i = d.params.len; i < locals.count; i += 1) {
        if ((locals.items[i] as *ast.Symbol).reg == 0) {
            *in_memory = true;
        }
    }
    free(locals.items);
    return count;
}

// Generates the body of a function into g.body after the location of its first line, which it returns the
// end of
fn gen_body(g: *Gen, d: *ast.Decl, frame: *ast.Symbol) int {
    g.frame = 0;
    g.checked.count = 0;
    g.range_count = 0;
    g.return_count = 0;
    stack.pushed = 0;
    stack.held = 0;
    str.clear(&g.body);
    str.clear(&g.tables);
    if (frame != null) {
        frame.offset = alloc_frame(g, 4);
        ast.add(&g.checked, frame as *u8);
    }
    for (var i = 0; i < d.params.len; i += 1) {
        var param = d.params[i].symbol;
        if (param.type.kind == ast.TypeKind.POINTER && !param.maybe_null && !param.address_taken) {
            ast.add(&g.checked, param as *u8);
        }
    }
    g.loc_module = null;
    loc(g, d.line);
    var start = g.body.len;
    gen_block(g, d.body);
    // A return at the end has nowhere to jump
    if (str.ends_with(str.text(&g.body), "    JMP .ret\n")) {
        g.body.len -= 13;
        if (g.return_count > 0 && g.returns[g.return_count - 1] == g.body.len) {
            g.return_count -= 1;
        }
    }
    loc(g, d.body.end_line);
    return start;
}

fn gen_function(g: *Gen, d: *ast.Decl) {
    var t = d.symbol.type;
    var offset = 8;
    if (is_aggregate(t.base)) {
        offset = 12;
    }
    for (var i = 0; i < d.params.len; i += 1) {
        d.params[i].symbol.offset = offset;
        offset += words(t.params[i].size);
    }
    // The parameter of an interrupt function points at the registers saved above the frame
    var frame: *ast.Symbol = null;
    if (d.is_interrupt && d.params.len == 1) {
        frame = d.params[0].symbol;
    }
    loops.optimize(d);
    // Without locals in memory, a function needs no frame unless a temporary asks for one after all
    var in_memory = false;
    var saved = assign_registers(d, &in_memory);
    stack = Stack { frameless: !d.is_interrupt && !in_memory, saved: saved };
    g.scope = symbol_name(d.symbol);
    var start = gen_body(g, d, frame);
    if (stack.frameless && g.frame > 0) {
        stack.frameless = false;
        start = gen_body(g, d, frame);
    }

    // ENTER needs the size of the frame, known only after the body
    var body = str.text(&g.body);
    str.append(&g.text, "\n");
    str.append(&g.text, body[:start]);
    format(&g.text, "%s:\n", [][]u8 { symbol_name(d.symbol) }, []int {});
    if (!stack.frameless) {
        format(&g.text, "    ENTER #%d\n", [][]u8 {}, []int { g.frame });
    }
    for (var i = 0; i < saved; i += 1) {
        format(&g.text, "    PUSH %s\n", [][]u8 { register_names[8 + i] }, []int {});
    }
    if (frame != null && frame.reg != 0) {
        format(&g.text, "    LEA %s, [BP+4]\n", [][]u8 { register_names[frame.reg] }, []int {});
    } else if (frame != null) {
        format(&g.text, "    LEA R0, [BP+4]\n    STORE R0, [BP%+d]\n", [][]u8 {}, []int { frame.offset });
    }
    for (var i = 0; i < d.params.len && frame == null; i += 1) {
        var s = d.params[i].symbol;
        if (s.reg != 0 && s.type.kind == ast.TypeKind.SLICE) {
            format(&g.text, "    LOAD %s, [%s]\n    LOAD %s, [%s]\n", [][]u8 { register_names[s.reg], local_place(s.offset),
                register_names[s.reg + 1], local_place(s.offset + 4) }, []int {});
        } else if (s.reg != 0) {
            var load = "LOAD";
            if (s.type.size == 1) {
                load = "LOADB";
            } else if (s.type.size == 2) {
                load = "LOADW";
            }
            format(&g.text, "    %s %s, [%s]\n", [][]u8 { load, register_names[s.reg], local_place(s.offset) }, []int {});
            if (s.type.kind == ast.TypeKind.INT && s.type.is_signed && s.type.size < 4) {
                var bits = 32 - 8 * s.type.size;
                format(&g.text, "    SHL %s, #%d\n    SAR %s, #%d\n", [][]u8 { register_names[s.reg], register_names[s.reg] },
                    []int { bits, bits });
            }
        }
    }
    var epilogue = str.builder(64);
    for (var i = saved - 1; i >= 0; i -= 1) {
        format(&epilogue, "    POP %s\n", [][]u8 { register_names[8 + i] }, []int {});
    }
    if (!stack.frameless) {
        str.append(&epilogue, "    LEAVE\n");
    }
    // A function removes its arguments as it returns, and an interrupt function returns with IRET
    if (d.is_interrupt) {
        str.append(&epilogue, "    IRET\n");
    } else if (offset > 8) {
        format(&epilogue, "    RET #%d\n", [][]u8 {}, []int { offset - 8 });
    } else {
        str.append(&epilogue, "    RET\n");
    }
    // Returns before the end leave through a copy of a short epilogue instead of jumping to it
    var rest = start;
    for (var i = 0; i < g.return_count && saved <= 3; i += 1) {
        str.append(&g.text, body[rest:g.returns[i]]);
        str.append(&g.text, str.text(&epilogue));
        rest = g.returns[i] + 13;
    }
    str.append(&g.text, body[rest:]);
    str.append(&g.text, ".ret:\n");
    str.append(&g.text, str.text(&epilogue));
    str.release(&epilogue);
    str.append(&g.data, str.text(&g.tables));
    stack.frameless = false;
}

// Emits the initial value of data of type t
fn gen_data(g: *Gen, out: *str.Builder, t: *ast.Type, e: *ast.Expr) {
    if (e == null) {
        if (t.size > 0) {
            format(out, "    .space %d\n", [][]u8 {}, []int { t.size });
        }
        return;
    }
    if (e.kind == ast.ExprKind.CONVERT && e.type.kind == ast.TypeKind.SLICE) {
        format(out, "    .dword %s, %d\n", [][]u8 { symbol_name(e.left.symbol) }, []int { e.left.type.length });
        return;
    }
    if (t.kind == ast.TypeKind.SLICE && e.kind == ast.ExprKind.ARRAY) {
        var array = ast.Type {
            kind: ast.TypeKind.ARRAY, base: t.base, length: e.args.len, size: e.args.len * t.base.size,
            align: t.base.align,
        };
        var inner = str.builder(64);
        var name = pool_label(g);
        var align = array.align;
        if (align == 0) {
            align = 1;
        }
        format(&inner, "    .align %d\n%s:\n", [][]u8 { name }, []int { align });
        gen_data(g, &inner, &array, e);
        str.append(&g.pool, str.text(&inner));
        str.release(&inner);
        format(out, "    .dword %s, %d\n", [][]u8 { name }, []int { e.args.len });
        return;
    }
    if (t.kind == ast.TypeKind.SLICE) {
        format(out, "    .dword %s, %d\n", [][]u8 { string_of(g, e) }, []int { string_size(e) });
        return;
    }
    if (t.kind == ast.TypeKind.STRUCT || t.kind == ast.TypeKind.ARRAY) {
        var offset = 0;
        for (var i = 0; i < e.args.len; i += 1) {
            var element = t.base;
            var at = 0;
            if (t.kind == ast.TypeKind.ARRAY) {
                at = i * t.base.size;
            } else {
                for (var k = 0; k < t.fields.len; k += 1) {
                    if (ast.same(t.fields[k].name, e.fields[i])) {
                        element = t.fields[k].type;
                        at = t.fields[k].offset;
                    }
                }
            }
            if (at > offset) {
                format(out, "    .space %d\n", [][]u8 {}, []int { at - offset });
            }
            gen_data(g, out, element, e.args[i]);
            offset = at + element.size;
        }
        if (t.size > offset) {
            format(out, "    .space %d\n", [][]u8 {}, []int { t.size - offset });
        }
        return;
    }
    var directive = ".dword";
    if (t.size == 1) {
        directive = ".byte";
    } else if (t.size == 2) {
        directive = ".word";
    }
    if (e.is_const) {
        format(out, "    %s %d\n", [][]u8 { directive }, []int { wide.low(e.value) });
    } else if (e.kind == ast.ExprKind.NULL) {
        str.append(out, "    .dword 0\n");
    } else if (e.kind == ast.ExprKind.CAST) {
        gen_data(g, out, t, e.left);
    } else if (e.kind == ast.ExprKind.UNARY) {
        format(out, "    .dword %s\n", [][]u8 { symbol_name(e.left.symbol) }, []int {});
    } else {
        format(out, "    .dword %s\n", [][]u8 { symbol_name(e.symbol) }, []int {});
    }
}

fn field_index(t: *ast.Type, name: []u8) int {
    var found = -1;
    for (var f = 0; f < t.fields.len; f += 1) {
        if (ast.same(t.fields[f].name, name)) {
            found = f;
        }
    }
    return found;
}

// Struct literals in data list their fields in the order written; data needs them in memory order
fn sort_fields(e: *ast.Expr) {
    if (e.kind != ast.ExprKind.STRUCT && e.kind != ast.ExprKind.ARRAY || e.type == null) {
        return;
    }
    for (var i = 0; i < e.args.len; i += 1) {
        sort_fields(e.args[i]);
    }
    if (e.kind != ast.ExprKind.STRUCT) {
        return;
    }
    var t = e.type;
    for (var i = 1; i < e.args.len; i += 1) {
        for (var k = i; k > 0; k -= 1) {
            if (field_index(t, e.fields[k - 1]) <= field_index(t, e.fields[k])) {
                break;
            }
            var arg = e.args[k];
            var field = e.fields[k];
            e.args[k] = e.args[k - 1];
            e.fields[k] = e.fields[k - 1];
            e.args[k - 1] = arg;
            e.fields[k - 1] = field;
        }
    }
}

fn gen_global(g: *Gen, d: *ast.Decl) {
    var t = d.symbol.type;
    if (d.value != null) {
        sort_fields(d.value);
    }
    var align = t.align;
    if (align <= 0) {
        align = 1;
    }
    format(&g.data, "    .align %d\n%s:\n", [][]u8 { symbol_name(d.symbol) }, []int { align });
    gen_data(g, &g.data, t, d.value);
}

// The runtime starts the program at main, which passes the arguments if the program's main takes them
fn gen_entry(g: *Gen) {
    var main = g.program.main;
    var t = main.type;
    g.m = main.decl.module;
    str.clear(&g.body);
    g.loc_module = null;
    loc(g, main.line);
    str.append(&g.text, str.text(&g.body));
    str.append(&g.text, "main:\n");
    if (t.params.len > 0) {
        str.append(&g.text, "    CALL rt.args\n    PUSH R5\n    PUSH R0\n");
    }
    format(&g.text, "    CALL %s\n", [][]u8 { symbol_name(main) }, []int {});
    if (t.base.kind == ast.TypeKind.VOID) {
        str.append(&g.text, "    LOAD R0, #0\n");
    }
    str.append(&g.text, "    RET\n");
}

// A function or global joins pending the first time something uses it
fn reach(pending: *ast.List, s: *ast.Symbol) {
    if (s != null && s.decl != null && !s.decl.used &&
        (s.kind == ast.SymbolKind.FN || s.kind == ast.SymbolKind.GLOBAL)) {
        s.decl.used = true;
        ast.add(pending, s.decl as *u8);
    }
}

// Where pointers go from one parameter or local to another, so that one that may be null makes the other so
var flow_from: ast.List;
var flow_to: ast.List;

// Notes what a pointer local or parameter gets: an address or new memory is not null, the value of another
// one only where that is not null, and anything else may be null
fn pass_pointer(value: *ast.Expr, to: *ast.Symbol) {
    if (to == null || to.type.kind != ast.TypeKind.POINTER || to.maybe_null) {
        return;
    }
    var e = value;
    while ((e.kind == ast.ExprKind.CAST || e.kind == ast.ExprKind.CONVERT) && e.left.type.kind == ast.TypeKind.POINTER) {
        e = e.left;
    }
    if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.AMP || e.kind == ast.ExprKind.NEW && e.left == null) {
        return;
    }
    var from = local_of(e);
    if (from == null) {
        to.maybe_null = true;
        return;
    }
    ast.add(&flow_from, from as *u8);
    ast.add(&flow_to, to as *u8);
}

// Constants need nothing at run time
fn reach_expr(pending: *ast.List, e: *ast.Expr) {
    if (e == null || e.is_const) {
        return;
    }
    if (e.symbol != null) {
        reach(pending, e.symbol);
        // A function that is a value may be called with anything
        if (e.symbol.kind == ast.SymbolKind.FN) {
            e.symbol.address_taken = true;
        }
    }
    if (e.kind == ast.ExprKind.CALL && e.left.kind == ast.ExprKind.NAME && e.left.symbol.kind == ast.SymbolKind.FN) {
        var params = e.left.symbol.decl.params;
        for (var i = 0; i < e.args.len && i < params.len; i += 1) {
            pass_pointer(e.args[i], params[i].symbol);
        }
        reach(pending, e.left.symbol);
    } else if (e.left != null) {
        if (e.kind == ast.ExprKind.UNARY && e.op == ast.TokenKind.AMP && e.left.kind == ast.ExprKind.NAME &&
            e.left.symbol.kind == ast.SymbolKind.LOCAL) {
            e.left.symbol.address_taken = true;
        }
        reach_expr(pending, e.left);
    }
    if (e.right != null) {
        reach_expr(pending, e.right);
    }
    if (e.third != null) {
        reach_expr(pending, e.third);
    }
    for (var i = 0; i < e.args.len; i += 1) {
        reach_expr(pending, e.args[i]);
    }
}

fn reach_stmt(pending: *ast.List, s: *ast.Stmt) {
    if (s == null) {
        return;
    }
    for (var i = 0; i < s.body.len; i += 1) {
        reach_stmt(pending, s.body[i]);
    }
    if (s.kind == ast.StmtKind.ASSIGN && local_of(s.target) != null) {
        s.target.symbol.assigned = true;
    } else if (s.kind == ast.StmtKind.VAR && s.value == null) {
        s.symbol.maybe_null = true;
    } else if (s.kind == ast.StmtKind.VAR) {
        pass_pointer(s.value, s.symbol);
    }
    reach_expr(pending, s.value);
    reach_expr(pending, s.target);
    reach_expr(pending, s.cond);
    reach_stmt(pending, s.then);
    reach_stmt(pending, s.otherwise);
    reach_stmt(pending, s.init);
    reach_stmt(pending, s.step);
    for (var i = 0; i < s.cases.len; i += 1) {
        reach_stmt(pending, s.cases[i].body);
    }
    reach_stmt(pending, s.fallback);
}

fn is_name_byte(c: u8) bool {
    return str.is_letter(c) || str.is_digit(c) || c == '_' || c == '.';
}

// Assembly names functions and globals as module.name
fn reach_assembly(program: *ast.Program, pending: *ast.List, path: []u8) {
    var text = io.read_file(path);
    var i = 0;
    while (i < text.len) {
        var start = i;
        while (i < text.len && is_name_byte(text[i])) {
            i += 1;
        }
        var dot = str.find_byte(text[start:i], '.');
        for (var k = 0; k < program.modules.count && dot > 0; k += 1) {
            var m = ast.module_at(program, k);
            if (ast.same(m.name, text[start:start + dot])) {
                var named = ast.get(&m.symbols, text[start + dot + 1:i]) as *ast.Symbol;
                if (named != null && named.kind == ast.SymbolKind.FN) {
                    named.address_taken = true;
                }
                reach(pending, named);
            }
        }
        if (i == start) {
            i += 1;
        }
    }
    free(text);
}

// Marks what main reaches, directly or through other functions and globals, and what the program's
// assembly names, which is all that gets generated
fn mark_used(program: *ast.Program) {
    var pending = ast.List {};
    reach(&pending, program.main);
    for (var i = 0; i < program.assembly.count; i += 1) {
        reach_assembly(program, &pending, program.assembly.items[i]);
    }
    for (var i = 0; i < pending.count; i += 1) {
        var d = pending.items[i] as *ast.Decl;
        reach_expr(&pending, d.value);
        reach_stmt(&pending, d.body);
    }
    // Pointer parameters that every call passes something not null need no checks. Calls through function
    // values, from assembly and from the machine can pass anything.
    for (var i = 0; i < pending.count; i += 1) {
        var d = pending.items[i] as *ast.Decl;
        for (var k = 0; k < d.params.len && d.kind == ast.DeclKind.FN && !d.is_extern; k += 1) {
            if (d.symbol.address_taken || d.is_interrupt || d.symbol == program.main) {
                d.params[k].symbol.maybe_null = true;
            }
        }
    }
    var changed = true;
    while (changed) {
        changed = false;
        for (var i = 0; i < flow_from.count; i += 1) {
            var from = flow_from.items[i] as *ast.Symbol;
            var to = flow_to.items[i] as *ast.Symbol;
            if (!to.maybe_null && (from.maybe_null || from.assigned || from.address_taken)) {
                to.maybe_null = true;
                changed = true;
            }
        }
    }
    free(pending.items);
}

pub fn generate(program: *ast.Program) []u8 {
    var g = Gen {
        program: program, text: str.builder(65536), data: str.builder(4096), pool: str.builder(4096),
        body: str.builder(4096), tables: str.builder(1024),
    };

    str.append(&g.text, "; Generated by vmc\n    .include \"runtime.asm\"\n");
    for (var i = 0; i < program.assembly.count; i += 1) {
        str.append(&g.text, "    .include ");
        quoted(&g.text, program.assembly.items[i]);
        str.append(&g.text, "\n");
    }
    str.append(&g.text, "\n.text\n");
    mark_used(program);
    gen_entry(&g);
    for (var i = 0; i < program.modules.count; i += 1) {
        g.m = ast.module_at(program, i);
        var decls = g.m.decls;
        for (var k = 0; k < decls.len; k += 1) {
            if (decls[k].kind == ast.DeclKind.FN && decls[k].body != null && decls[k].used) {
                gen_function(&g, decls[k]);
            }
        }
        for (var k = 0; k < decls.len; k += 1) {
            if (decls[k].kind == ast.DeclKind.VAR && decls[k].used) {
                gen_global(&g, decls[k]);
            }
        }
    }
    str.append(&g.text, "\n.data\n");
    str.append(&g.text, str.text(&g.data));
    str.append(&g.text, str.text(&g.pool));
    return str.text(&g.text);
}
