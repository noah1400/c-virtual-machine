// Turns the source of a module into tokens
import "std/str";
import "ast";
import "float";
import "wide";

var keywords = [23][]u8 {
    "as", "break", "case", "const", "continue", "default", "else", "enum", "extern", "false", "fn", "for", "if",
    "import", "interrupt", "null", "pub", "return", "struct", "switch", "true", "var", "while",
};

// Where the keywords starting with each letter begin, and the next letter's keywords start
var keyword_starts = [27]int {
    0, 1, 2, 5, 6, 9, 12, 12, 12, 15, 15, 15, 15, 15, 16, 16, 17, 17, 18, 20, 21, 21, 22, 23, 23, 23, 23,
};

// Indexed by the kind minus LPAREN
var punctuation = [41][]u8 {
    "(", ")", "{", "}", "[", "]", ",", ";", ":", ".", "+", "-", "*", "/", "%", "&", "|", "^", "~", "!", "<<",
    ">>", "&&", "||", "==", "!=", "<", "<=", ">", ">=", "=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=",
    "<<=", ">>=",
};

pub fn token_text(kind: ast.TokenKind) []u8 {
    switch (kind) {
        case ast.TokenKind.EOF {
            return "the end of the file";
        }
        case ast.TokenKind.IDENT {
            return "a name";
        }
        case ast.TokenKind.INT, ast.TokenKind.FLOAT {
            return "a number";
        }
        case ast.TokenKind.STRING {
            return "a string";
        }
    }
    var i = kind as int - ast.TokenKind.AS as int;
    if (i < keywords.len) {
        return keywords[i];
    }
    return ast.cat([][]u8 { "'", punctuation[kind as int - ast.TokenKind.LPAREN as int], "'" });
}

struct Lexer {
    m: *ast.Module;
    source: []u8;
    p: int;
    line: int;
    line_start: int;
    lines: ast.Texts;
    tokens: []ast.Token;
    count: int;
    buffer: str.Builder;    // the bytes of a string literal
}

// The next token, which the lexer fills in where it stays
fn next_token(lx: *Lexer) *ast.Token {
    if (lx.count == lx.tokens.len) {
        var capacity = lx.tokens.len * 2;
        if (capacity == 0) {
            capacity = 1024;
        }
        var larger = new(ast.Token, capacity);
        if (lx.count > 0) {
            ast.copy(larger.ptr as *u8, lx.tokens.ptr as *u8, lx.count * sizeof(ast.Token));
        }
        free(lx.tokens);
        lx.tokens = larger;
    }
    var t = &lx.tokens[lx.count];
    lx.count += 1;
    return t;
}

// Ends the line at the line end at p, keeping its text without the line end for .loc
fn end_line(lx: *Lexer, p: int) {
    var end = p;
    if (end > lx.line_start && lx.source[end - 1] == '\r') {
        end -= 1;
    }
    ast.add_text(&lx.lines, lx.source[lx.line_start:end]);
    lx.line_start = p + 1;
    lx.line += 1;
}

fn no_nul(lx: *Lexer) {
    ast.fail(null, 0, ast.cat([][]u8 { lx.m.path, " contains a NUL byte" }));
}

// The lexer stops at a NUL byte, which is the first problem to report
fn fail_at(lx: *Lexer, line: int, message: []u8) {
    for (var i = 0; i < lx.source.len - 1; i += 1) {
        if (lx.source[i] == 0) {
            no_nul(lx);
        }
    }
    ast.fail(lx.m, line, message);
}

fn fail(lx: *Lexer, message: []u8) {
    fail_at(lx, lx.line, message);
}

fn is_digit(c: u8) bool {
    return c >= '0' && c <= '9';
}

fn is_alpha(c: u8) bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z';
}

fn is_alnum(c: u8) bool {
    return c >= 'a' && c <= 'z' || c >= 'A' && c <= 'Z' || c >= '0' && c <= '9';
}

fn digit_value(c: u8) int {
    if (c >= '0' && c <= '9') {
        return (c - '0') as int;
    }
    if (c >= 'a' && c <= 'f') {
        return (c - 'a') as int + 10;
    }
    if (c >= 'A' && c <= 'F') {
        return (c - 'A') as int + 10;
    }
    return 99;
}

fn escape(lx: *Lexer) int {
    var src = lx.source;
    var c = src[lx.p];
    lx.p += 1;
    switch (c) {
        case 'n' {
            return '\n';
        }
        case 't' {
            return '\t';
        }
        case 'r' {
            return '\r';
        }
        case '0' {
            return 0;
        }
        case '\\', '\'', '"' {
            return c as int;
        }
        case 0 {
            fail(lx, "unterminated escape sequence");
        }
        case 'x' {
            if (digit_value(src[lx.p]) < 16 && digit_value(src[lx.p + 1]) < 16) {
                lx.p += 2;
                return digit_value(src[lx.p - 2]) * 16 + digit_value(src[lx.p - 1]);
            }
            fail(lx, "\\x needs two hexadecimal digits");
        }
        default {
            var text = [1]u8 { c };
            fail(lx, ast.cat([][]u8 { "unknown escape sequence \\", text }));
        }
    }
    return 0;
}

// Digits and the underscores between them
fn digit_run(src: []u8, p: int) int {
    while (is_digit(src[p]) || src[p] == '_') {
        p += 1;
    }
    return p;
}

fn invalid_number(lx: *Lexer, start: int, p: int) {
    var src = lx.source;
    while (is_alnum(src[p]) || src[p] == '_') {
        p += 1;
    }
    fail(lx, ast.cat([][]u8 { "invalid number ", src[start:p] }));
}

// A decimal number with a fraction, an exponent or both, rounded to the nearest f32
fn float_number(lx: *Lexer, t: *ast.Token) {
    var src = lx.source;
    var start = lx.p;
    var p = digit_run(src, start);
    var digits = 0;

    for (var q = start; q < p; q += 1) {
        if (is_digit(src[q])) {
            digits += 1;
        }
    }
    if (src[p - 1] == '_') {
        invalid_number(lx, start, p);
    }
    if (src[p] == '.' && is_digit(src[p + 1])) {
        p = digit_run(src, p + 1);
        if (src[p - 1] == '_') {
            invalid_number(lx, start, p);
        }
    }
    if (src[p] == 'e' || src[p] == 'E') {
        var q = p + 1;
        if (src[q] == '+' || src[q] == '-') {
            q += 1;
        }
        if (!is_digit(src[q])) {
            invalid_number(lx, start, p);
        }
        p = digit_run(src, q);
        if (src[p - 1] == '_') {
            invalid_number(lx, start, p);
        }
    }
    if (is_alnum(src[p]) || src[p] == '_') {
        invalid_number(lx, start, p);
    }
    if (src[start] == '0' && digits > 1) {
        fail(lx, "decimal numbers other than 0 do not start with 0");
    }
    var bits = float.parse(src[start:p]);
    if (bits == float.INFINITY) {
        fail(lx, "number too large");
    }
    lx.p = p;
    t.kind = ast.TokenKind.FLOAT;
    t.value = wide.Wide { lo: bits };
}

fn number(lx: *Lexer, t: *ast.Token) {
    var src = lx.source;
    var start = lx.p;
    var base = 10;
    var digits = 0;
    var value = wide.Wide {};

    var x = src[start + 1];
    if (src[start] != '0' || x != 'x' && x != 'X' && x != 'b' && x != 'B') {
        var end = digit_run(src, start);
        if (src[end] == '.' && is_digit(src[end + 1]) || src[end] == 'e' || src[end] == 'E') {
            float_number(lx, t);
            return;
        }
    }
    if (src[start] == '0' && (src[start + 1] == 'x' || src[start + 1] == 'X')) {
        base = 16;
        lx.p += 2;
    } else if (src[start] == '0' && (src[start + 1] == 'b' || src[start + 1] == 'B')) {
        base = 2;
        lx.p += 2;
    }
    for (;; lx.p += 1) {
        var d = digit_value(src[lx.p]);
        if (src[lx.p] == '_' && digits > 0) {
            continue;
        }
        if (d >= base) {
            break;
        }
        if (!wide.append_digit(&value, base, d)) {
            fail(lx, "number too large");
        }
        digits += 1;
    }
    var c = src[lx.p];
    if (digits == 0 || src[lx.p - 1] == '_' || is_alnum(c) || c == '_') {
        var end = lx.p;
        while (is_alnum(src[end]) || src[end] == '_') {
            end += 1;
        }
        fail(lx, ast.cat([][]u8 { "invalid number ", src[start:end] }));
    }
    if (base == 10 && src[start] == '0' && digits > 1) {
        fail(lx, "decimal numbers other than 0 do not start with 0");
    }
    if (value.hi < 0) {
        fail(lx, "number too large");
    }
    t.kind = ast.TokenKind.INT;
    t.value = value;
}

fn character(lx: *Lexer, t: *ast.Token) {
    var src = lx.source;
    lx.p += 1;
    var c = src[lx.p];
    if (c == '\'' || c == '\n' || c == 0) {
        fail(lx, "a character literal holds one character");
    }
    var value = c as int;
    lx.p += 1;
    if (c == '\\') {
        value = escape(lx);
    }
    if (src[lx.p] != '\'') {
        fail(lx, "a character literal holds one character");
    }
    lx.p += 1;
    t.kind = ast.TokenKind.INT;
    t.value = wide.of(value);
}

fn string(lx: *Lexer, t: *ast.Token) {
    var src = lx.source;
    str.clear(&lx.buffer);
    lx.p += 1;
    while (src[lx.p] != '"') {
        var c = src[lx.p];
        if (c == '\n' || c == 0) {
            fail(lx, "unterminated string");
        }
        lx.p += 1;
        if (c == '\\') {
            c = escape(lx) as u8;
        }
        str.append_byte(&lx.buffer, c);
    }
    lx.p += 1;
    t.bytes = ast.clone(str.text(&lx.buffer));
    t.kind = ast.TokenKind.STRING;
}

// The kinds of punctuation by its first character: alone, followed by =, doubled, and doubled and followed
// by =; 0 for none
var single: [256]u8;
var with_equals: [256]u8;
var doubled: [256]u8;
var doubled_equals: [256]u8;

fn punctuation_tables() {
    for (var i = 0; i < punctuation.len; i += 1) {
        var p = punctuation[i];
        var kind = (i + ast.TokenKind.LPAREN as int) as u8;
        if (p.len == 1) {
            single[p[0]] = kind;
        } else if (p.len == 2 && p[1] == '=') {
            with_equals[p[0]] = kind;
        } else if (p.len == 2) {
            doubled[p[0]] = kind;
        } else {
            doubled_equals[p[0]] = kind;
        }
    }
}

// The longest punctuation at the position, so that <<= wins over << and <
fn punct(lx: *Lexer, t: *ast.Token) bool {
    var src = lx.source;
    var c = src[lx.p];
    var kind = single[c];
    if (kind == 0) {
        return false;
    }
    var next = src[lx.p + 1];
    var length = 1;
    if (next == '=' && with_equals[c] != 0) {
        kind = with_equals[c];
        length = 2;
    } else if (next == c && doubled[c] != 0) {
        kind = doubled[c];
        length = 2;
        if (src[lx.p + 2] == '=' && doubled_equals[c] != 0) {
            kind = doubled_equals[c];
            length = 3;
        }
    }
    t.kind = (kind as int) as ast.TokenKind;
    lx.p += length;
    return true;
}

fn skip_space(lx: *Lexer) {
    var src = lx.source;
    var p = lx.p;
    for (;;) {
        var c = src[p];
        if (c == '\n') {
            end_line(lx, p);
            p += 1;
        } else if (c == ' ' || c == '\t' || c == '\r' || c == 11 || c == 12) {
            p += 1;
        } else if (c == '/' && src[p + 1] == '/') {
            while (src[p] != 0 && src[p] != '\n') {
                p += 1;
            }
        } else if (c == '/' && src[p + 1] == '*') {
            var start = lx.line;
            for (p += 2; !(src[p] == '*' && src[p + 1] == '/'); p += 1) {
                if (src[p] == 0) {
                    fail_at(lx, start, "unterminated comment");
                }
                if (src[p] == '\n') {
                    end_line(lx, p);
                }
            }
            p += 2;
        } else {
            lx.p = p;
            return;
        }
    }
}

// Letters, digits and _, and those that start a name
var name_chars: [256]bool;
var name_starts: [256]bool;

pub fn lex(m: *ast.Module) {
    var lx = Lexer { m: m, source: m.source, line: 1, buffer: str.builder(64) };
    var src = m.source;

    if (!name_chars['_']) {
        for (var i = 0; i < 256; i += 1) {
            name_chars[i] = is_alnum(i as u8);
            name_starts[i] = is_alpha(i as u8);
        }
        name_chars['_'] = true;
        name_starts['_'] = true;
        punctuation_tables();
    }
    for (;;) {
        skip_space(&lx);
        var start = lx.p;
        var c = src[start];
        var t = next_token(&lx);
        t.line = lx.line;
        if (c == 0) {
            if (start != src.len - 1) {
                no_nul(&lx);
            }
            if (lx.line_start < start) {
                end_line(&lx, start);
            }
            t.kind = ast.TokenKind.EOF;
            t.text = src[start:start];
            break;
        }
        if (name_starts[c]) {
            var p = start;
            while (name_chars[src[p]]) {
                p += 1;
            }
            lx.p = p;
            t.kind = ast.TokenKind.IDENT;
            if (c >= 'a' && c <= 'z') {
                var word = src[start:p];
                var letter = (c - 'a') as int;
                for (var i = keyword_starts[letter]; i < keyword_starts[letter + 1]; i += 1) {
                    if (keywords[i].len == word.len && ast.same(keywords[i], word)) {
                        t.kind = (ast.TokenKind.AS as int + i) as ast.TokenKind;
                        break;
                    }
                }
            }
        } else if (c >= '0' && c <= '9') {
            number(&lx, t);
        } else if (c == '\'') {
            character(&lx, t);
        } else if (c == '"') {
            string(&lx, t);
        } else if (!punct(&lx, t)) {
            if (c >= 32 && c < 127) {
                var text = [1]u8 { c };
                fail(&lx, ast.cat([][]u8 { "unexpected character '", text, "'" }));
            }
            var digits: [8]u8;
            var hex = str.format_hex(c as u32, digits);
            if (hex.len == 1) {
                hex = ast.cat([][]u8 { "0", hex });
            }
            fail(&lx, ast.cat([][]u8 { "unexpected byte 0x", upper(hex) }));
        }
        t.text = src[start:lx.p];
    }
    m.tokens = lx.tokens[:lx.count];
    m.lines = ast.texts(lx.lines);
    str.release(&lx.buffer);
}

fn upper(text: []u8) []u8 {
    var result = ast.clone(text);
    for (var i = 0; i < result.len; i += 1) {
        if (result[i] >= 'a' && result[i] <= 'f') {
            result[i] = result[i] - 'a' + 'A';
        }
    }
    return result;
}
