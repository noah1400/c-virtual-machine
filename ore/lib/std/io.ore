// Reading and writing the console and files, a piece at a time or a whole file at once
import "mem";

pub const STDIN = 0;
pub const STDOUT = 1;
pub const STDERR = 2;

// Modes of open
pub const READ = 0;
pub const WRITE = 1;        // creates the file, or empties it
pub const APPEND = 2;
pub const UPDATE = 3;       // reads and writes a file that exists
pub const REPLACE = 4;      // reads and writes a file it creates or empties

// Origins of seek
pub const START = 0;
pub const CURRENT = 1;
pub const END = 2;

// Writes bytes and returns how many were written, or -1
pub fn write(handle: int, bytes: []u8) int {
    var result = syscall(13, handle, bytes.ptr, bytes.len);
    if (result.status != 0) {
        return -1;
    }
    return result.value;
}

// Reads up to buffer.len bytes and returns how many, 0 at the end, or -1
pub fn read(handle: int, buffer: []u8) int {
    var result = syscall(12, handle, buffer.ptr, buffer.len);
    if (result.status != 0) {
        return -1;
    }
    return result.value;
}

pub fn print_error(text: []u8) {
    write(STDERR, text);
}

pub fn print_char(c: u8) {
    syscall(0, c);
}

// Prints value like 0x1f
pub fn print_hex(value: u32) {
    syscall(5, value);
}

// The next byte of stdin, or -1 at the end of the input
pub fn read_char() int {
    var result = syscall(3);
    if (result.status != 0) {
        return -1;
    }
    return result.value;
}

// Reads a line of stdin into buffer, without its line end, and makes line the part of buffer it
// fills. Returns false at the end of the input. A line longer than the buffer comes in pieces.
pub fn read_line(buffer: []u8, line: *[]u8) bool {
    if (buffer.len < 2) {
        return false;
    }
    var result = syscall(4, buffer.ptr, buffer.len);
    if (result.status != 0) {
        return false;
    }
    *line = buffer[:result.value];
    return true;
}

// Returns a handle for the file, or -1. Paths are relative to where vm runs.
pub fn open(path: []u8, mode: int) int {
    var name: [256]u8;
    if (path.len >= name.len) {
        return -1;
    }
    mem.copy(name, path);
    name[path.len] = 0;
    var result = syscall(10, &name[0], mode);
    if (result.status != 0) {
        return -1;
    }
    return result.value;
}

pub fn close(handle: int) {
    syscall(11, handle);
}

// Moves to offset from origin and returns the new position, or -1
pub fn seek(handle: int, offset: int, origin: int) int {
    var result = syscall(14, handle, offset, origin);
    if (result.status != 0) {
        return -1;
    }
    return result.value;
}

// The whole file on the heap, which free gives back. The slice's ptr is null when the file cannot be
// read.
pub fn read_file(path: []u8) []u8 {
    var none: []u8;
    var handle = open(path, READ);
    if (handle < 0) {
        return none;
    }
    var size = seek(handle, 0, END);
    if (size < 0 || seek(handle, 0, START) != 0) {
        close(handle);
        return none;
    }
    var bytes = new(u8, size);
    var done = 0;
    while (done < size) {
        var n = read(handle, bytes[done:]);
        if (n <= 0) {
            close(handle);
            free(bytes);
            return none;
        }
        done += n;
    }
    close(handle);
    return bytes;
}

// Creates or replaces the file with bytes, and tells whether that worked
pub fn write_file(path: []u8, bytes: []u8) bool {
    var handle = open(path, WRITE);
    if (handle < 0) {
        return false;
    }
    var written = write(handle, bytes);
    close(handle);
    return written == bytes.len;
}
