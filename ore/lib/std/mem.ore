// Copying, filling, comparing, searching, counting, sorting and hashing bytes. Longer slices go to native
// code in the VM, shorter ones stay in loops here, which cost less than the syscall.
import "sys";

var native_from = 0;        // the length from which a syscall costs less than a loop

// Whether a syscall pays for length bytes
fn native(length: int) bool {
    if (native_from == 0) {
        native_from = cut_off();
    }
    return length >= native_from;
}

// In user mode a kernel such as MiniDos checks each syscall first, which costs as much as a loop over about
// a thousand bytes
fn cut_off() int {
    if (sys.supervisor()) {
        return 4;
    }
    return 1024;
}

// Copies as many bytes as both slices hold, even when they overlap, and returns how many
pub fn copy(to: []u8, from: []u8) int {
    var length = to.len;
    if (from.len < length) {
        length = from.len;
    }
    var p = to.ptr;
    var q = from.ptr;
    if (native(length)) {
        syscall(22, p, q, length);
    } else if (p != null && q != null) {
        // Both slices hold length bytes, so the loops index their pointers unchecked
        if (p as u32 <= q as u32) {
            for (var i = 0; i < length; i += 1) {
                p[i] = q[i];
            }
        } else {
            for (var i = length - 1; i >= 0; i -= 1) {
                p[i] = q[i];
            }
        }
    }
    return length;
}

pub fn fill(to: []u8, value: u8) {
    if (native(to.len)) {
        syscall(24, to.ptr, value, to.len);
        return;
    }
    for (var i = 0; i < to.len; i += 1) {
        to[i] = value;
    }
}

pub fn equal(a: []u8, b: []u8) bool {
    return a.len == b.len && compare(a, b) == 0;
}

// Negative, zero or positive as a sorts before, with or after b, byte by byte
pub fn compare(a: []u8, b: []u8) int {
    var length = a.len;
    if (b.len < length) {
        length = b.len;
    }
    var p = a.ptr;
    var q = b.ptr;
    if (native(length)) {
        var difference = syscall(25, p, q, length).value;
        if (difference != 0) {
            return difference;
        }
    } else if (p != null && q != null) {
        for (var i = 0; i < length; i += 1) {
            if (p[i] != q[i]) {
                return p[i] as int - q[i] as int;
            }
        }
    }
    return a.len - b.len;
}

// The index of the first value in data, or -1
pub fn find(data: []u8, value: u8) int {
    if (native(data.len)) {
        return syscall(26, data.ptr, value, data.len).value;
    }
    for (var i = 0; i < data.len; i += 1) {
        if (data[i] == value) {
            return i;
        }
    }
    return -1;
}

// How many bytes of data are value
pub fn count(data: []u8, value: u8) int {
    if (native(data.len)) {
        return syscall(27, data.ptr, value, data.len).value;
    }
    var found = 0;
    for (var i = 0; i < data.len; i += 1) {
        if (data[i] == value) {
            found += 1;
        }
    }
    return found;
}

// Sorts numbers from the lowest up
pub fn sort(numbers: []int) {
    // An insertion sort costs about as much as a loop over n * n bytes
    if (numbers.len >= 1024 || native(numbers.len * numbers.len)) {
        syscall(28, numbers.ptr, 0, numbers.len);
        return;
    }
    for (var i = 1; i < numbers.len; i += 1) {
        var value = numbers[i];
        var j = i;
        while (j > 0 && numbers[j - 1] > value) {
            numbers[j] = numbers[j - 1];
            j -= 1;
        }
        numbers[j] = value;
    }
}

// The 32-bit FNV-1a hash of data
pub fn hash(data: []u8) u32 {
    return hash_more(2166136261, data);
}

// Goes on with a hash from hash or hash_more over more data, so that pieces hash as they would together
pub fn hash_more(start: u32, data: []u8) u32 {
    if (native(data.len)) {
        return syscall(29, data.ptr, start, data.len).value as u32;
    }
    var h = start;
    for (var i = 0; i < data.len; i += 1) {
        h = (h ^ data[i] as u32) * 16777619;
    }
    return h;
}

// The bytes of any memory, for copying and comparing values of other types
pub fn bytes(address: *u8, size: int) []u8 {
    return address[0:size];
}
