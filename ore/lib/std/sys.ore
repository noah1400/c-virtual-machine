// The process: leaving, time, and random numbers from the VM

// Stops the program with an exit status
pub fn exit(status: int) {
    syscall(30, status);
}

// Milliseconds since the program started
pub fn time() int {
    return syscall(32).value;
}

// Instructions executed so far, counting up from 0 and wrapping around
pub fn ticks() u32 {
    return syscall(33).value as u32;
}

pub fn sleep(milliseconds: int) {
    syscall(31, milliseconds);
}

// A number below limit, or any 32-bit value when limit is 0. The sequence repeats unless seeded.
pub fn random(limit: u32) u32 {
    return syscall(40, limit).value as u32;
}

pub fn seed(value: u32) {
    syscall(41, value);
}

// Whether the program runs in supervisor mode. Under a kernel such as MiniDos it runs in user mode, where
// the kernel checks each syscall first.
pub extern fn supervisor() bool;

// The size of the VM's memory in bytes
pub fn memory_size() int {
    return syscall(23).value;
}

// How many bytes the heap has free
pub fn free_heap() int {
    return syscall(23).r6;
}

// The largest block that new can get
pub fn largest_free() int {
    return syscall(23).r7;
}

// The local date and time as seconds since 1970-01-01, counted as if the local time were UTC
pub fn clock() u32 {
    return syscall(36).value as u32;
}

// A date and time in its parts. Months and days count from 1, and weekday 0 is a Sunday.
pub struct DateTime {
    year: int;
    month: int;
    day: int;
    hour: int;
    minute: int;
    second: int;
    weekday: int;
}

// The parts of a clock value
pub fn date_time(clock: u32) DateTime {
    var days = (clock / 86400) as int;
    var seconds = (clock % 86400) as int;
    var shifted = days + 719468;
    var era = shifted / 146097;
    var day_of_era = shifted - era * 146097;
    var year_of_era = (day_of_era - day_of_era / 1460 + day_of_era / 36524 - day_of_era / 146096) / 365;
    var day_of_year = day_of_era - (365 * year_of_era + year_of_era / 4 - year_of_era / 100);
    var month_index = (5 * day_of_year + 2) / 153;
    var t = DateTime {
        year: year_of_era + era * 400, day: day_of_year - (153 * month_index + 2) / 5 + 1, hour: seconds / 3600,
        minute: seconds / 60 % 60, second: seconds % 60, weekday: (days + 4) % 7,
    };
    t.month = month_index + 3;
    if (month_index >= 10) {
        t.month = month_index - 9;
        t.year += 1;
    }
    return t;
}

// The clock value of a date and time from 1970 on
pub fn clock_of(t: DateTime) u32 {
    var year = t.year;
    if (t.month <= 2) {
        year -= 1;
    }
    var era = year / 400;
    var year_of_era = year - era * 400;
    var month_index = t.month - 3;
    if (t.month <= 2) {
        month_index = t.month + 9;
    }
    var day_of_year = (153 * month_index + 2) / 5 + t.day - 1;
    var day_of_era = year_of_era * 365 + year_of_era / 4 - year_of_era / 100 + day_of_year;
    var days = era * 146097 + day_of_era - 719468;
    return days as u32 * 86400 + (t.hour * 3600 + t.minute * 60 + t.second) as u32;
}
