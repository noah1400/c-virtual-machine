// std/mem in user mode, where its loops take slices of up to about a thousand bytes and MiniDos makes the
// syscalls for longer ones
import "std/mem";
import "std/sys";

fn main() int {
    print("supervisor ", sys.supervisor(), "\n");
    var a = new(u8, 1100);
    var b = new(u8, 1100);
    var lengths = [4]int { 16, 1023, 1024, 1100 };
    var good = true;
    for (var k = 0; k < lengths.len; k += 1) {
        var n = lengths[k];
        mem.fill(a[:n], 'a');
        a[n - 1] = 'z';
        mem.copy(b, a[:n]);
        good = good && mem.count(a[:n], 'a') == n - 1 && mem.find(a[:n], 'z') == n - 1 && mem.equal(a[:n], b[:n]) &&
               mem.compare(a[:n], b[:n - 1]) > 0 && mem.compare(b[:n - 2], a[:n]) < 0 &&
               mem.hash_more(mem.hash(a[:10]), a[10:n]) == mem.hash(a[:n]);
    }
    print("mem below and above 1024 bytes ", good, "\n");
    var numbers = new(int, 40);
    for (var n = 20; n <= 40; n += 20) {
        for (var i = 0; i < n; i += 1) {
            numbers[i] = n / 2 - i;
        }
        mem.sort(numbers[:n]);
        print("sort ", n, ": ", numbers[0], " ", numbers[1], " ", numbers[n - 1], "\n");
    }
    return 0;
}
