A:\>COPY CON TEST.BAT
@ECHO OFF
REM a batch file with parameters
ECHO Parameters: %1 and %2
IF "%1"=="" GOTO NONE
HELLO %1
IF ERRORLEVEL 3 ECHO HELLO ended with 3 or more
SHIFT
ECHO After SHIFT the first is %1
GOTO END
:NONE
ECHO No parameters
:END
ECHO Done

