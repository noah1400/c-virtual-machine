A:\>COPY CON SHOW.BAT
ECHO Batch files show their commands unless ECHO is off
SET GREETING=hi there
ECHO %GREETING% from %0
IF EXIST SHOW.BAT ECHO SHOW.BAT exists
IF NOT EXIST NOPE.BAT ECHO NOPE.BAT does not
GOTO MISSING
ECHO not reached

        1 file(s) copied
