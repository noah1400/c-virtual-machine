N
FORMAT A: /V:COMPARE
IMPORT fc.bin FC.EXE
COPY CON ONE.TXT
alpha
beta
gamma
delta
epsilon
zeta

COPY CON TWO.TXT
alpha
BETA
gamma
inserted
delta
epsilon
zeta
eta

COPY ONE.TXT SAME.TXT
FC ONE.TXT SAME.TXT
FC ONE.TXT TWO.TXT
IF ERRORLEVEL 1 ECHO the files differ
FC /C /N ONE.TXT TWO.TXT
FC /B ONE.TXT TWO.TXT
FC /B ONE.TXT SAME.TXT
COPY NUL EMPTY.TXT
FC EMPTY.TXT ONE.TXT
FC ONE.TXT
FC ONE.TXT NOPE.TXT
FC /X ONE.TXT TWO.TXT
FC /?
EXIT
