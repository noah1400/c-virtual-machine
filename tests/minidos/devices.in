N
FORMAT A: /V:DEVICES
IMPORT sort.bin SORT.EXE
ECHO hidden > NUL
DIR > NUL
TYPE NUL
COPY NUL EMPTY.TXT
COPY NUL EMPTY.TXT
N
ECHO text > NOTES.TXT
COPY NOTES.TXT NUL
COPY NOTES.TXT NUL.DAT
SORT < NUL
MD DOCS
IF EXIST NUL ECHO NUL is everywhere
IF EXIST DOCS\NUL ECHO DOCS is a directory
IF EXIST NOTES.TXT\NUL ECHO NOTES.TXT is a directory
IF NOT EXIST NOWHERE\NUL ECHO NOWHERE is no directory
COPY CON CHECK.BAT
@ECHO OFF
IF NOT EXIST %1\NUL GOTO missing
ECHO %1 is there
DIR %1 > NUL
GOTO end
:missing
ECHO %1 is missing
:end

CHECK DOCS
CHECK NOWHERE
MD NUL
REN NOTES.TXT NUL.TXT
DIR
EXIT
