N
FORMAT A:

IMPORT sort.bin SORT.EXE
IMPORT find.bin FIND.EXE
COPY CON FRUIT.TXT
pear
Apple
banana
cherry

SORT < FRUIT.TXT
SORT /R < FRUIT.TXT > SORTED.TXT
TYPE SORTED.TXT
TYPE FRUIT.TXT | FIND "an"
TYPE FRUIT.TXT | SORT | FIND /V "e"
FIND /C /I "A" FRUIT.TXT
FIND "x" NOPE.TXT
DIR | FIND "TXT"
ECHO appended >> FRUIT.TXT
TYPE FRUIT.TXT | FIND /C "p"
TYPE MISSING.TXT | SORT
SORT < MISSING.TXT
DIR > LIST.TXT
FIND "LIST" LIST.TXT
SORT FRUIT.TXT /+2
SORT /R FRUIT.TXT
FIND /N "e" FRUIT.TXT
FIND /I "" FRUIT.TXT
SORT /X
SORT /+0 FRUIT.TXT
FIND /Q "a"
FIND "a" FRUIT.TXT LIST.TXT EXTRA.TXT
SORT /?
FIND /?
EXIT
